<Window
    x:Class="AssetEditor.Views.FolderProject.FolderProjectSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    Title=""
    Width="700"
    Height="340"
    Background="{DynamicResource AeBrush.Canvas}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}"
    ResizeMode="NoResize"
    Style="{StaticResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.RowSpan="6"
            Grid.ColumnSpan="3"
            Margin="18,16,18,10"
            Padding="16"
            Style="{StaticResource AeSurface.Panel}" />

        <TextBlock
            x:Name="DescriptionTextBlock"
            Grid.ColumnSpan="3"
            Margin="34,30,34,18"
            Style="{StaticResource AeText.SectionTitle}"
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="1"
            Margin="34,0,8,8"
            VerticalAlignment="Center"
            Text="{loc:Loc FolderProject.Setup.ProjectFolder}" />
        <TextBox
            x:Name="ProjectFolderTextBox"
            Grid.Row="1"
            Grid.Column="1"
            Height="24"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            HorizontalScrollBarVisibility="Hidden"
            IsReadOnly="True"
            Style="{StaticResource AeInput.TextBox}"
            TextWrapping="NoWrap" />
        <Button
            Grid.Row="1"
            Grid.Column="2"
            Height="24"
            Margin="0,0,34,8"
            Click="BrowseProjectFolder_Click"
            Content="{loc:Loc FolderProject.Setup.Browse}"
            Style="{StaticResource AeButton.Secondary}" />

        <TextBlock
            Grid.Row="2"
            Margin="34,0,8,8"
            VerticalAlignment="Center"
            Text="{loc:Loc FolderProject.Setup.OutputFolder}" />
        <TextBox
            x:Name="OutputFolderTextBox"
            Grid.Row="2"
            Grid.Column="1"
            Height="24"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            HorizontalScrollBarVisibility="Hidden"
            IsReadOnly="True"
            Style="{StaticResource AeInput.TextBox}"
            TextWrapping="NoWrap" />
        <Button
            Grid.Row="2"
            Grid.Column="2"
            Height="24"
            Margin="0,0,34,8"
            Click="BrowseOutputFolder_Click"
            Content="{loc:Loc FolderProject.Setup.Browse}"
            Style="{StaticResource AeButton.Secondary}" />

        <TextBlock
            Grid.Row="3"
            Margin="34,0,8,8"
            VerticalAlignment="Center"
            Text="{loc:Loc FolderProject.Setup.CorruptionDetection}" />
        <CheckBox
            x:Name="EnablePackFileCorruptionDetectionCheckBox"
            Grid.Row="3"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0,0,0,8"
            VerticalAlignment="Center"
            Content="{loc:Loc FolderProject.Setup.CorruptionDetectionCheckbox}"
            IsChecked="False"
            Style="{StaticResource AeInput.CheckBox}" />

        <TextBlock
            Grid.Row="4"
            Grid.ColumnSpan="3"
            Margin="34,2,34,10"
            Foreground="{DynamicResource AeBrush.Accent}"
            Style="{StaticResource AeText.Caption}"
            Text="{loc:Loc FolderProject.Setup.HistoryRequired}"
            TextWrapping="Wrap" />

        <Border
            Grid.Row="6"
            Grid.ColumnSpan="3"
            Style="{StaticResource AeWorkflow.DialogFooter}">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="88"
                    Margin="0,0,8,0"
                    Click="Ok_Click"
                    Content="{loc:Loc General.Ok}"
                    IsDefault="True"
                    Style="{StaticResource AeButton.Primary}" />
                <Button
                    Width="88"
                    Click="Cancel_Click"
                    Content="{loc:Loc General.Cancel}"
                    IsCancel="True"
                    Style="{StaticResource AeButton.Secondary}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
