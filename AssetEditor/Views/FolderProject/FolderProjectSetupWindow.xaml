<Window
    x:Class="AssetEditor.Views.FolderProject.FolderProjectSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    Title=""
    Width="680"
    Height="350"
    ResizeMode="NoResize"
    Style="{StaticResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="DescriptionTextBlock"
            Grid.ColumnSpan="3"
            Margin="0,0,0,12"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="1"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            Text="{loc:Loc FolderProject.Setup.ProjectFolder}" />
        <TextBox
            x:Name="ProjectFolderTextBox"
            Grid.Row="1"
            Grid.Column="1"
            Height="24"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            HorizontalScrollBarVisibility="Hidden"
            IsReadOnly="True"
            TextWrapping="NoWrap" />
        <Button
            Grid.Row="1"
            Grid.Column="2"
            Height="24"
            Margin="0,0,0,8"
            Click="BrowseProjectFolder_Click"
            Content="{loc:Loc FolderProject.Setup.Browse}" />

        <TextBlock
            Grid.Row="2"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            Text="{loc:Loc FolderProject.Setup.OutputFolder}" />
        <TextBox
            x:Name="OutputFolderTextBox"
            Grid.Row="2"
            Grid.Column="1"
            Height="24"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            HorizontalScrollBarVisibility="Hidden"
            IsReadOnly="True"
            TextWrapping="NoWrap" />
        <Button
            Grid.Row="2"
            Grid.Column="2"
            Height="24"
            Margin="0,0,0,8"
            Click="BrowseOutputFolder_Click"
            Content="{loc:Loc FolderProject.Setup.Browse}" />

        <TextBlock
            Grid.Row="3"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            Text="{loc:Loc FolderProject.Setup.CorruptionDetection}" />
        <CheckBox
            x:Name="EnablePackFileCorruptionDetectionCheckBox"
            Grid.Row="3"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0,0,0,8"
            VerticalAlignment="Center"
            Content="{loc:Loc FolderProject.Setup.CorruptionDetectionCheckbox}"
            IsChecked="False" />

        <TextBlock
            Grid.Row="4"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            Text="{loc:Loc FolderProject.Setup.PrimaryBranch}" />
        <TextBox
            x:Name="PrimaryBranchNameTextBox"
            Grid.Row="4"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Height="24"
            Margin="0,0,0,8"
            VerticalContentAlignment="Center" />

        <TextBlock
            Grid.Row="5"
            Grid.ColumnSpan="3"
            Margin="0,2,0,10"
            Foreground="{DynamicResource ABrush.ColourfulGlyph.Static}"
            Text="{loc:Loc FolderProject.Setup.VersionControlRequired}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="7"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Click="Ok_Click"
                Content="{loc:Loc General.Ok}"
                IsDefault="True" />
            <Button
                Width="80"
                Click="Cancel_Click"
                Content="{loc:Loc General.Cancel}"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
