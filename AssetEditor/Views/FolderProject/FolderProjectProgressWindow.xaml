<Window
    x:Class="AssetEditor.Views.FolderProject.FolderProjectProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui"
    Title=""
    Width="700"
    MinHeight="190"
    MaxHeight="620"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource CustomWindowStyle}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Background="{DynamicResource AeBrush.Canvas}"
    WindowStartupLocation="CenterOwner">
    <progress:OperationProgressView
        x:Name="FolderProjectOperationProgress"
        Margin="20" />
</Window>
