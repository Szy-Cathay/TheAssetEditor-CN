<Window
    x:Class="AssetEditor.Views.FolderProject.FolderProjectProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title=""
    Width="520"
    Height="150"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Style="{StaticResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="StatusTextBlock"
            TextWrapping="Wrap" />
        <ProgressBar
            x:Name="FolderProjectCreationProgressBar"
            Grid.Row="1"
            Height="8"
            Margin="0,16,0,0"
            IsIndeterminate="True" />
    </Grid>
</Window>
