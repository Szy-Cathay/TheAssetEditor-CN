<Window x:Class="AssetEditor.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssetEditor.Views.Settings"
          xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        mc:Ignorable="d"
        Title="{loc:Loc SettingsWindow.Title}" Height="660" Width="820" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:SettingsView Grid.Row="0"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,10,8,8">
            <Button Content="{loc:Loc SettingsWindow.CancelButton}" Width="82" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="{loc:Loc SettingsWindow.SaveButton}" Width="82" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>

</Window>
