<Window x:Class="AssetEditor.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssetEditor.Views.Settings"
          xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        mc:Ignorable="d"
        Title="{loc:Loc SettingsWindow.Title}" Height="700" Width="860" MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        Background="{DynamicResource AeBrush.Canvas}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:SettingsView x:Name="SettingsContent" Grid.Row="0"/>
        <Border Grid.Row="1" Style="{StaticResource AeWorkflow.DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                    Content="{loc:Loc SettingsWindow.CancelButton}"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Style="{StaticResource AeButton.Secondary}" />
                <Button
                    Content="{loc:Loc SettingsWindow.SaveButton}"
                    MinWidth="88"
                    Click="SaveButton_Click"
                    IsDefault="True"
                    Style="{StaticResource AeButton.Primary}" />
            </StackPanel>
        </Border>
    </Grid>

</Window>
