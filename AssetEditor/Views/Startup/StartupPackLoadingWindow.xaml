<Window
    x:Class="AssetEditor.Views.Startup.StartupPackLoadingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui"
    Title="{loc:Loc StartupPackLoading.Title}"
    Width="640"
    MinHeight="170"
    MaxHeight="700"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource CustomWindowStyle}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Background="{DynamicResource AeBrush.Canvas}"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="StartupHiddenDetails" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <ControlTemplate x:Key="StartupSplashTemplate" TargetType="Window">
            <Border x:Name="WindowSurface" Background="Transparent">
                <ContentPresenter />
            </Border>
        </ControlTemplate>
        <SolidColorBrush x:Key="StartupAccentBrush" Color="#C91D25" />
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="StartupLayout" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="StartupArtwork" Visibility="Collapsed">
                <Image x:Name="StartupImage" Source="pack://application:,,,/AssetEditor.CN;component/AssetEditor.CN.png"
                       Width="320" Height="320" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="{loc:Loc StartupPackLoading.ArtworkDescription}" />
            </Grid>

            <ScrollViewer x:Name="StartupFeedback" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" UseLayoutRounding="True"
                          TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
                <StackPanel>
                    <TextBlock x:Name="StartupIdentity" Visibility="Collapsed"
                               FontFamily="Segoe UI" FontSize="40" FontWeight="Bold"
                               Foreground="{DynamicResource AeBrush.TextPrimary}"
                               HorizontalAlignment="Center" Margin="0,4,0,16"><Run Text="{loc:Loc StartupPackLoading.BrandName}" /><Run Text="{loc:Loc StartupPackLoading.BrandRegion}" Foreground="{StaticResource StartupAccentBrush}" /></TextBlock>
                    <progress:OperationProgressView
                        x:Name="StartupOperationProgress"
                        IsOperationActive="True"
                        UseDeferredVisibility="False" />

                    <Border
                        x:Name="FailurePanel"
                        Margin="0,16,0,0"
                        Style="{StaticResource AeWorkflow.FailurePanel}"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                x:Name="FailureHelpText"
                                Text="{loc:Loc StartupPackLoading.FailureHelp}"
                                TextWrapping="Wrap" />

                            <StackPanel
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="RetryButton"
                                    MinWidth="88"
                                    Margin="0,0,8,0"
                                    Click="OnRetryClick"
                                    Content="{loc:Loc StartupPackLoading.Retry}"
                                    Style="{StaticResource AeButton.Primary}" />
                                <Button
                                    x:Name="CheckGamePathButton"
                                    MinWidth="120"
                                    Margin="0,0,8,0"
                                    Click="OnCheckGamePathClick"
                                    Content="{loc:Loc StartupPackLoading.CheckGamePath}"
                                    Style="{StaticResource AeButton.Secondary}" />
                            </StackPanel>
                            <TextBlock x:Name="FailureCloseHint" Grid.Row="2" Margin="0,8,0,0"
                                       Text="{loc:Loc StartupPackLoading.CloseHint}" TextWrapping="Wrap"
                                       Style="{StaticResource AeText.Caption}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <Button x:Name="ExitButton" Margin="0,8,0,0" HorizontalAlignment="Right"
                            Click="OnExitClick" Content="{loc:Loc StartupPackLoading.Exit}"
                            Style="{StaticResource AeButton.Quiet}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ScrollViewer>
</Window>
