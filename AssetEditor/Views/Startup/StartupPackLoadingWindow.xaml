<Window
    x:Class="AssetEditor.Views.Startup.StartupPackLoadingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui"
    Title="{loc:Loc StartupPackLoading.Title}"
    Width="700"
    MinHeight="230"
    MaxHeight="700"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource CustomWindowStyle}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Background="{DynamicResource AeBrush.Canvas}"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <progress:OperationProgressView
            x:Name="StartupOperationProgress"
            IsOperationActive="True" />

        <Border
            x:Name="FailurePanel"
            Grid.Row="1"
            Margin="0,16,0,0"
            Style="{StaticResource AeWorkflow.FailurePanel}"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Text="{loc:Loc StartupPackLoading.FailureHelp}"
                    TextWrapping="Wrap" />

                <StackPanel
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="RetryButton"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Click="OnRetryClick"
                        Content="{loc:Loc StartupPackLoading.Retry}"
                        Style="{StaticResource AeButton.Primary}" />
                    <Button
                        x:Name="CheckGamePathButton"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Click="OnCheckGamePathClick"
                        Content="{loc:Loc StartupPackLoading.CheckGamePath}"
                        Style="{StaticResource AeButton.Secondary}" />
                    <Button
                        x:Name="ExitButton"
                        MinWidth="88"
                        Click="OnExitClick"
                        Content="{loc:Loc StartupPackLoading.Exit}"
                        Style="{StaticResource AeButton.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
