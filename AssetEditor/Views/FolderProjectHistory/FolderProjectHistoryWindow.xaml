<windowhandling:AssetEditorWindow
    x:Class="AssetEditor.Views.FolderProjectHistory.FolderProjectHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:history="clr-namespace:AssetEditor.Views.FolderProjectHistory"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui"
    Title="{loc:Loc FolderProject.History.Recovery.WindowTitle}"
    Width="500"
    Height="760"
    MinWidth="420"
    MinHeight="520"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource CustomWindowStyle}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Background="{DynamicResource AeBrush.Canvas}">
    <history:FolderProjectHistoryView />
</windowhandling:AssetEditorWindow>
