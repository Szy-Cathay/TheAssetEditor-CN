<UserControl
    x:Class="AssetEditor.Views.FolderProjectHistory.FolderProjectHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AssetEditor.Views.FolderProjectHistory"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToCollapsedConverter" />
        <local:HistoryChangeKindConverter x:Key="HistoryChangeKindConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource AeBrush.Canvas}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource AeText.SectionTitle}"
                            Text="{loc:Loc FolderProject.History.Title}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource AeText.Caption}"
                            Text="{Binding ProjectName}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Content="{loc:Loc FolderProject.History.Refresh}"
                        Style="{StaticResource AeButton.Quiet}" />
                </Grid>

                <Border
                    Margin="0,0,0,12"
                    Style="{StaticResource AeFeedback.Notice}">
                    <TextBlock
                        Text="{loc:Loc FolderProject.History.SameDiskNotice}"
                        TextWrapping="Wrap" />
                </Border>

                <TextBlock
                    Margin="4,0,4,8"
                    Style="{StaticResource AeText.Caption}"
                    Text="{Binding AvailabilityText}"
                    TextWrapping="Wrap" />

                <Border
                    Margin="0,0,0,12"
                    Style="{StaticResource AeFeedback.Notice}"
                    Visibility="{Binding IsRecoveryRequired, Converter={StaticResource BoolToCollapsedConverter}}">
                    <StackPanel>
                        <TextBlock
                            Text="{Binding RecoveryText}"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,8,0,0"
                            Command="{Binding RecoverHistoryCommand}"
                            Content="{loc:Loc FolderProject.History.Recovery.Action}"
                            Style="{StaticResource AeButton.Primary}" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Style="{StaticResource AeText.SectionTitle}"
                    Text="{loc:Loc FolderProject.History.UnrecordedChanges}" />
                <TextBlock
                    Margin="0,4,0,8"
                    Style="{StaticResource AeText.Caption}"
                    Text="{Binding UnrecordedSummaryText}" />
                <ListView
                    MaxHeight="190"
                    Margin="0,0,0,8"
                    ItemsSource="{Binding UnrecordedChanges}"
                    SelectedItem="{Binding SelectedUnrecordedChange, Mode=TwoWay}"
                    Style="{StaticResource AeList.View}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{DynamicResource AeBrush.TextMuted}"
                                        Text="{Binding PreviousPath}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Foreground="{DynamicResource AeBrush.TextMuted}"
                                    Text="{Binding Kind, Converter={StaticResource HistoryChangeKindConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Command="{Binding DiscardSelectedCommand}"
                        Content="{loc:Loc FolderProject.History.DiscardSelected}"
                        Style="{StaticResource AeButton.Danger}" />
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Command="{Binding DiscardAllCommand}"
                        Content="{loc:Loc FolderProject.History.DiscardAll}"
                        Style="{StaticResource AeButton.Danger}" />
                </Grid>

                <TextBlock
                    Margin="0,4,0,4"
                    Style="{StaticResource AeText.Label}"
                    Text="{loc:Loc FolderProject.History.Description}" />
                <TextBox
                    Margin="0,0,0,8"
                    Style="{StaticResource AeInput.TextBox}"
                    Text="{Binding RestorePointDescription, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Margin="0,0,0,16"
                    Command="{Binding CreateRestorePointCommand}"
                    Content="{loc:Loc FolderProject.History.CreateRestorePoint}"
                    Style="{StaticResource AeButton.Primary}" />

                <TextBlock
                    Style="{StaticResource AeText.SectionTitle}"
                    Text="{loc:Loc FolderProject.History.RestorePoints}" />
                <TextBlock
                    Margin="0,4,0,8"
                    Style="{StaticResource AeText.Caption}"
                    Text="{Binding HistorySummaryText}" />
                <ListView
                    MaxHeight="220"
                    Margin="0,0,0,12"
                    ItemsSource="{Binding RestorePoints}"
                    SelectedItem="{Binding SelectedRestorePoint, Mode=TwoWay}"
                    Style="{StaticResource AeList.View}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Description}" TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource AeBrush.TextMuted}"
                                    Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                <TextBlock Foreground="{DynamicResource AeBrush.TextMuted}">
                                    <Run Text="{loc:Loc FolderProject.History.ChangeSummaryPrefix}" />
                                    <Run Text="{Binding ChangeSummary.Total, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Style="{StaticResource AeText.SectionTitle}"
                    Text="{loc:Loc FolderProject.History.SelectedChanges}" />
                <TextBlock
                    Margin="0,4,0,8"
                    Style="{StaticResource AeText.Caption}"
                    Text="{loc:Loc FolderProject.History.SelectRestorePointHint}" />
                <ListView
                    MaxHeight="220"
                    ItemsSource="{Binding SelectedRestorePointChanges}"
                    SelectedItem="{Binding SelectedRestorePointChange, Mode=TwoWay}"
                    Style="{StaticResource AeList.View}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{DynamicResource AeBrush.TextMuted}"
                                        Text="{Binding PreviousPath}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Foreground="{DynamicResource AeBrush.TextMuted}"
                                    Text="{Binding Kind, Converter={StaticResource HistoryChangeKindConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Command="{Binding RestoreFileCommand}"
                        Content="{loc:Loc FolderProject.History.RestoreFile}"
                        Style="{StaticResource AeButton.Secondary}" />
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Command="{Binding RestoreProjectCommand}"
                        Content="{loc:Loc FolderProject.History.RestoreProject}"
                        Style="{StaticResource AeButton.Danger}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <progress:OperationProgressWindowHost
            CurrentDetailText="{Binding OperationDetailText}"
            IsOperationActive="{Binding IsBusy}"
            IsProgressIndeterminate="{Binding IsOperationProgressIndeterminate}"
            ProgressMaximum="{Binding OperationProgressMaximum}"
            ProgressValue="{Binding OperationProgressValue}"
            StatusText="{Binding OperationStatusText}"
            WindowTitle="{loc:Loc FolderProject.History.OperationTitle}" />
    </Grid>
</UserControl>
