<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style
        x:Key="GitPageTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource AeText.SectionTitle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="GitSectionTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource AeText.SectionTitle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="GitCaptionStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource AeText.Caption}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="GitSurfaceBorderStyle"
        TargetType="Border"
        BasedOn="{StaticResource AeSurface.Panel}">
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="GitFlatPaneStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style
        x:Key="GitIconButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource AeButton.Icon}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style
        x:Key="GitTreeActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource GitIconButtonStyle}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <Style x:Key="GitSectionExpanderStyle" TargetType="Expander">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleButton
                            x:Name="HeaderSite"
                            MinHeight="30"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        x:Name="HeaderBorder"
                                        Padding="2,1"
                                        Background="Transparent"
                                        CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path
                                                x:Name="Arrow"
                                                Width="7"
                                                Height="7"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M 1,0 L 6,3.5 L 1,7"
                                                Fill="Transparent"
                                                Stroke="{DynamicResource AeBrush.TextMuted}"
                                                StrokeThickness="1.5" />
                                            <ContentPresenter
                                                Grid.Column="1"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="Center"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource AeBrush.SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter
                            x:Name="ExpandSite"
                            Grid.Row="1"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Focusable="False"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="GitQuietButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource AeButton.Quiet}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.Accent}" />
    </Style>

    <Style
        x:Key="GitTextLinkButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource AeButton.Quiet}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.Accent}" />
    </Style>

    <Style
        x:Key="GitBranchPickerListItemStyle"
        TargetType="ListBoxItem"
        BasedOn="{StaticResource AeList.Item}">
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style
        x:Key="GitListStyle"
        TargetType="ListBox"
        BasedOn="{StaticResource AeList.View}" />

    <Style
        x:Key="GitContextMenuStyle"
        TargetType="ContextMenu"
        BasedOn="{StaticResource AeMenu.Context}" />

    <Style
        x:Key="GitBranchPickerButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource AeButton.Quiet}">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="GitCommitSplitButtonStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AeBrush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style
        x:Key="GitCommitSplitButtonPartStyle"
        TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.Canvas}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PartBackground"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        RenderTransformOrigin="0.5,0.5"
                        SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="InteractionScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="{TemplateBinding Padding}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ButtonBase.Click">
                            <BeginStoryboard Storyboard="{StaticResource AeMotion.ButtonClickStoryboard}" />
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PartBackground" Property="Background" Value="{DynamicResource AeBrush.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PartBackground" Property="Background" Value="{DynamicResource AeBrush.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextMuted}" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="GitCommitSplitMainButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource GitCommitSplitButtonPartStyle}" />

    <Style
        x:Key="GitCommitSplitMenuButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource GitCommitSplitButtonPartStyle}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style
        x:Key="GitChangeTreeStyle"
        TargetType="TreeView"
        BasedOn="{StaticResource AeTree.View}">
        <Setter Property="MaxHeight" Value="260" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style
        x:Key="GitChangeTreeItemStyle"
        TargetType="TreeViewItem"
        BasedOn="{StaticResource AeTree.Item}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style
        x:Key="GitBranchListItemStyle"
        TargetType="ListBoxItem"
        BasedOn="{StaticResource AeList.Item}">
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>

    <Style
        x:Key="GitHistoryDataGridRowStyle"
        TargetType="DataGridRow"
        BasedOn="{StaticResource AeTable.Row}">
        <Setter Property="Height" Value="{StaticResource AeSize.CompactRowHeight}" />
    </Style>

    <Style
        x:Key="GitHistoryDataGridStyle"
        TargetType="DataGrid"
        BasedOn="{StaticResource AeTable.Grid}" />

    <Style
        x:Key="GitEmptyStateTextStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource AeText.Caption}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
