<windowhandling:AssetEditorWindow
    x:Class="AssetEditor.Views.FolderProjectVersionControl.FolderProjectVersionControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui"
    mc:Ignorable="d"
    Title="{loc:Loc FolderProject.VersionControl.Title}"
    Width="1100"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource CustomWindowStyle}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Binding ProjectName}" />
                <TextBlock
                    Margin="0,3,0,0"
                    Opacity="0.75"
                    Text="{Binding ProjectRoot}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                MinWidth="86"
                Height="30"
                Command="{Binding RefreshCommand}"
                Content="{loc:Loc FolderProject.VersionControl.Refresh}" />
        </Grid>

        <TabControl
            Grid.Row="1"
            SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="{loc:Loc FolderProject.VersionControl.Tab.Status}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,8,5"
                            FontWeight="SemiBold"
                            Text="{loc:Loc FolderProject.VersionControl.Repository}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,18,5"
                            Text="{loc:Loc FolderProject.VersionControl.Initialized}"
                            Visibility="{Binding IsInitialized, Converter={StaticResource BoolToCollapsedConverter}}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,18,5"
                            Text="{loc:Loc FolderProject.VersionControl.Uninitialized}"
                            Visibility="{Binding IsInitialized, Converter={StaticResource InvBoolToHiddenConverter}}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="0,0,8,5"
                            FontWeight="SemiBold"
                            Text="{loc:Loc FolderProject.VersionControl.CurrentBranch}" />
                        <TextBlock
                            Grid.Column="3"
                            Margin="0,0,0,5"
                            Text="{Binding CurrentBranch}" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,0,8,0"
                            FontWeight="SemiBold"
                            Text="{loc:Loc FolderProject.VersionControl.Head}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,18,0"
                            Text="{Binding HeadCommitId}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            Text="{loc:Loc FolderProject.VersionControl.Detached}"
                            Visibility="{Binding IsDetached, Converter={StaticResource BoolToCollapsedConverter}}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc FolderProject.VersionControl.IdentityName}" />
                        <TextBox
                            Grid.Column="1"
                            Height="28"
                            Margin="0,0,12,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding IdentityName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc FolderProject.VersionControl.IdentityEmail}" />
                        <TextBox
                            Grid.Column="3"
                            Height="28"
                            Margin="0,0,12,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding IdentityEmail, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="4"
                            MinWidth="90"
                            Height="28"
                            Margin="0,0,8,0"
                            Command="{Binding SaveIdentityCommand}"
                            Content="{loc:Loc FolderProject.VersionControl.SaveIdentity}" />
                        <Button
                            Grid.Column="5"
                            MinWidth="120"
                            Height="28"
                            Command="{Binding InitializeCommand}"
                            Content="{loc:Loc FolderProject.VersionControl.Initialize}" />
                    </Grid>

                    <DataGrid
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding WorkingChanges}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="400"
                                Header="{loc:Loc FolderProject.VersionControl.Path}"
                                Binding="{Binding RepositoryPath}" />
                            <DataGridTextColumn
                                Width="220"
                                Header="{loc:Loc FolderProject.VersionControl.Kind}"
                                Binding="{Binding KindText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc FolderProject.VersionControl.CommitMessage}" />
                        <TextBox
                            Grid.Column="1"
                            Height="30"
                            Margin="0,0,10,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="2"
                            MinWidth="120"
                            Height="30"
                            Command="{Binding CommitCommand}"
                            Content="{loc:Loc FolderProject.VersionControl.Commit}" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc FolderProject.VersionControl.Tab.History}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc FolderProject.VersionControl.HistoryBranch}" />
                        <ComboBox
                            Grid.Column="1"
                            Height="30"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Branches}"
                            SelectedItem="{Binding SelectedHistoryBranch}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ABrush.Foreground.Deeper}"
                            Text="{Binding HistoryBranchHint}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.48*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="0.52*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding History}"
                            SelectedItem="{Binding SelectedCommit}"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="80"
                                    Header="{loc:Loc FolderProject.VersionControl.CommitId}"
                                    Binding="{Binding ShortId}" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="160"
                                    Header="{loc:Loc FolderProject.VersionControl.Message}"
                                    Binding="{Binding Message}" />
                                <DataGridTextColumn
                                    Width="120"
                                    Header="{loc:Loc FolderProject.VersionControl.Author}"
                                    Binding="{Binding AuthorName}" />
                                <DataGridTextColumn
                                    Width="130"
                                    Header="{loc:Loc FolderProject.VersionControl.Time}"
                                    Binding="{Binding CommittedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter
                            Grid.Column="1"
                            Width="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                        <DataGrid
                            Grid.Column="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding CommitChanges}"
                            SelectedItem="{Binding SelectedCommitChange}"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="180"
                                    Header="{loc:Loc FolderProject.VersionControl.Path}"
                                    Binding="{Binding RepositoryPath}" />
                                <DataGridTextColumn
                                    Width="130"
                                    Header="{loc:Loc FolderProject.VersionControl.PreviousPath}"
                                    Binding="{Binding PreviousRepositoryPath}" />
                                <DataGridTextColumn
                                    Width="90"
                                    Header="{loc:Loc FolderProject.VersionControl.Kind}"
                                    Binding="{Binding KindText}" />
                                <DataGridTextColumn
                                    Width="70"
                                    Header="{loc:Loc FolderProject.VersionControl.Binary}"
                                    Binding="{Binding BinaryText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc FolderProject.VersionControl.RecoveryBranchName}" />
                        <TextBox
                            Grid.Column="1"
                            Height="30"
                            Margin="0,0,8,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding RecoveryBranchName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="2"
                            MinWidth="170"
                            Height="30"
                            Command="{Binding CreateRecoveryBranchCommand}"
                            Content="{loc:Loc FolderProject.VersionControl.CreateRecoveryBranch}" />
                        <Button
                            Grid.Column="4"
                            MinWidth="130"
                            Height="30"
                            Command="{Binding RestoreFileCommand}"
                            Content="{loc:Loc FolderProject.VersionControl.Restore}" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc FolderProject.VersionControl.Tab.Branches}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Branches}"
                        SelectedItem="{Binding SelectedBranch}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="220"
                                Header="{loc:Loc FolderProject.VersionControl.BranchName}"
                                Binding="{Binding Name}" />
                            <DataGridTextColumn
                                Width="2*"
                                MinWidth="360"
                                Header="{loc:Loc FolderProject.VersionControl.BranchTip}"
                                Binding="{Binding TipCommitId}" />
                            <DataGridCheckBoxColumn
                                Width="80"
                                Header="{loc:Loc FolderProject.VersionControl.BranchCurrent}"
                                Binding="{Binding IsCurrent}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource ABrush.Foreground.Deeper}"
                        Text="{Binding BranchActionHint}"
                        TextWrapping="Wrap" />
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc FolderProject.VersionControl.BranchName}" />
                        <TextBox
                            Grid.Column="1"
                            Height="30"
                            Margin="0,0,8,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="2"
                            MinWidth="100"
                            Height="30"
                            Margin="0,0,8,0"
                            Command="{Binding CreateBranchCommand}"
                            Content="{loc:Loc FolderProject.VersionControl.CreateBranch}" />
                        <Button
                            Grid.Column="3"
                            MinWidth="130"
                            Height="30"
                            Command="{Binding RenameBranchCommand}"
                            Content="{loc:Loc FolderProject.VersionControl.RenameBranch}" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.ColumnSpan="5"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                MinWidth="120"
                                Height="30"
                                Margin="0,0,8,0"
                                Command="{Binding SwitchBranchCommand}"
                                Content="{loc:Loc FolderProject.VersionControl.SwitchBranch}" />
                            <Button
                                MinWidth="120"
                                Height="30"
                                Margin="0,0,8,0"
                                Command="{Binding PrepareMergeCommand}"
                                Content="{loc:Loc FolderProject.VersionControl.PrepareMerge}" />
                            <Button
                                MinWidth="120"
                                Height="30"
                                Command="{Binding DeleteBranchCommand}"
                                Content="{loc:Loc FolderProject.VersionControl.DeleteBranch}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc FolderProject.VersionControl.Tab.Merge}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.ColumnSpan="5"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding MergeSummary}" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc FolderProject.VersionControl.MergeSource}" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,18,0"
                            Height="30"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding CanSelectMergeSource}"
                            ItemsSource="{Binding MergeSources}"
                            SelectedItem="{Binding SelectedMergeSource}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc FolderProject.VersionControl.MergeTarget}" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="3"
                            Height="30"
                            Margin="0,0,8,0"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding CanSelectMergeSource}"
                            ItemsSource="{Binding MergeTargets}"
                            SelectedItem="{Binding SelectedMergeTarget}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="4"
                            MinWidth="110"
                            Height="30"
                            Command="{Binding BeginMergeCommand}"
                            Content="{loc:Loc FolderProject.VersionControl.BeginMerge}" />
                    </Grid>

                    <DataGrid
                        Grid.Row="1"
                        Margin="0,10,0,10"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding MergeConflicts}"
                        SelectedItem="{Binding SelectedMergeConflict}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="1.1*"
                                MinWidth="170"
                                Header="{loc:Loc FolderProject.VersionControl.Path}"
                                Binding="{Binding DisplayPath}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="170"
                                Header="{loc:Loc FolderProject.VersionControl.MergeAncestor}"
                                Binding="{Binding AncestorText}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="170"
                                Header="{loc:Loc FolderProject.VersionControl.MergeCurrent}"
                                Binding="{Binding CurrentText}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="170"
                                Header="{loc:Loc FolderProject.VersionControl.MergeIncoming}"
                                Binding="{Binding IncomingText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button
                                MinWidth="120"
                                Height="30"
                                Margin="0,0,8,0"
                                Command="{Binding UseCurrentCommand}"
                                Content="{loc:Loc FolderProject.VersionControl.UseCurrent}" />
                            <Button
                                MinWidth="120"
                                Height="30"
                                Command="{Binding UseIncomingCommand}"
                                Content="{loc:Loc FolderProject.VersionControl.UseIncoming}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Text="{loc:Loc FolderProject.VersionControl.CommitMessage}" />
                            <TextBox
                                Grid.Column="1"
                                Height="30"
                                Margin="0,0,8,0"
                                VerticalContentAlignment="Center"
                                Text="{Binding MergeMessage, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="2"
                                MinWidth="110"
                                Height="30"
                                Margin="0,0,8,0"
                                Command="{Binding CompleteMergeCommand}"
                                Content="{loc:Loc FolderProject.VersionControl.CompleteMerge}" />
                            <Button
                                Grid.Column="3"
                                MinWidth="100"
                                Height="30"
                                Command="{Binding AbortMergeCommand}"
                                Content="{loc:Loc FolderProject.VersionControl.AbortMerge}" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border
            Grid.Row="2"
            Margin="0,9,0,0"
            Padding="6,3"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource GroupBox.Static.Border}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar
                    Height="4"
                    Margin="0,0,0,4"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToCollapsedConverter}}" />
                <TextBlock
                    Grid.Row="1"
                    MinHeight="20"
                    VerticalAlignment="Center"
                    Text="{Binding BusyMessage}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToCollapsedConverter}}" />
                <TextBlock
                    Grid.Row="1"
                    MinHeight="20"
                    VerticalAlignment="Center"
                    Text="{Binding StatusMessage}"
                    Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToHiddenConverter}}" />
            </Grid>
        </Border>
    </Grid>
</windowhandling:AssetEditorWindow>
