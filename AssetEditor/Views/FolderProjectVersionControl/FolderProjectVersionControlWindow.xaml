<windowhandling:AssetEditorWindow
    x:Class="AssetEditor.Views.FolderProjectVersionControl.FolderProjectVersionControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui"
    xmlns:viewmodels="clr-namespace:AssetEditor.ViewModels"
    xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui"
    d:DataContext="{d:DesignInstance Type=viewmodels:FolderProjectVersionControlViewModel}"
    mc:Ignorable="d"
    Title="{loc:Loc FolderProject.VersionControl.Tab.Merge}"
    Width="680"
    Height="460"
    MinWidth="560"
    MinHeight="380"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource CustomWindowStyle}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Background="{DynamicResource AeBrush.Canvas}">
    <windowhandling:AssetEditorWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FolderProjectGitStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToCollapsedConverter" />
        </ResourceDictionary>
    </windowhandling:AssetEditorWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,5"
                    Foreground="{DynamicResource AeBrush.TextMuted}"
                    Text="{loc:Loc FolderProject.VersionControl.MergeSource}" />
                <ComboBox
                    Style="{StaticResource AeInput.ComboBox}"
                    Height="30"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="{loc:Loc FolderProject.VersionControl.MergeSource}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding MergeSources}"
                    SelectedItem="{Binding SelectedMergeSource}" />
            </StackPanel>
            <Path
                Grid.Column="1"
                Margin="0,23,0,0"
                Width="12"
                Height="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M 1,5 H 11 M 8,2 L 11,5 L 8,8"
                Stroke="{DynamicResource AeBrush.TextMuted}"
                StrokeThickness="1.25" />
            <StackPanel Grid.Column="2">
                <TextBlock
                    Margin="0,0,0,5"
                    Foreground="{DynamicResource AeBrush.TextMuted}"
                    Text="{loc:Loc FolderProject.VersionControl.MergeTarget}" />
                <ComboBox
                    Style="{StaticResource AeInput.ComboBox}"
                    Height="30"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="{loc:Loc FolderProject.VersionControl.MergeTarget}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding MergeTargets}"
                    SelectedItem="{Binding SelectedMergeTarget}" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Orientation="Horizontal">
                <Button
                    MinWidth="86"
                    Height="28"
                    Margin="0,0,6,0"
                    Command="{Binding BeginMergeCommand}"
                    Content="{loc:Loc FolderProject.VersionControl.BeginMerge}"
                    Style="{StaticResource AeButton.Primary}" />
                <Button
                    MinWidth="86"
                    Height="28"
                    Command="{Binding AbortMergeCommand}"
                    Content="{loc:Loc FolderProject.VersionControl.AbortMerge}"
                    Style="{StaticResource AeButton.Danger}" />
            </StackPanel>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource AeBrush.TextMuted}"
                Text="{Binding MergeSummary}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding MergeSummary}" />
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="0,0,0,5"
                FontWeight="SemiBold"
                Text="{loc:Loc FolderProject.VersionControl.MergeConflicts}" />
            <DataGrid
                x:Name="MergeConflictsGrid"
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                ItemsSource="{Binding MergeConflicts}"
                SelectedItem="{Binding SelectedMergeConflict}"
                SelectionChanged="MergeConflicts_SelectionChanged"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Style="{StaticResource AeTable.Grid}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="360"
                        Header="{loc:Loc FolderProject.VersionControl.Path}"
                        Binding="{Binding DisplayPath}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button
                MinWidth="86"
                Height="28"
                DockPanel.Dock="Right"
                Command="{Binding CompleteMergeCommand}"
                Content="{loc:Loc FolderProject.VersionControl.CompleteMerge}"
                Style="{StaticResource AeButton.Primary}" />
            <StackPanel Orientation="Horizontal">
                <Button
                    MinWidth="110"
                    Height="28"
                    Margin="0,0,6,0"
                    Command="{Binding UseCurrentCommand}"
                    Content="{loc:Loc FolderProject.VersionControl.UseCurrent}"
                    Style="{StaticResource AeButton.Secondary}" />
                <Button
                    MinWidth="110"
                    Height="28"
                    Command="{Binding UseIncomingCommand}"
                    Content="{loc:Loc FolderProject.VersionControl.UseIncoming}"
                    Style="{StaticResource AeButton.Secondary}" />
            </StackPanel>
        </DockPanel>

        <Border
            Grid.Row="4"
            MinHeight="28"
            Margin="0,10,0,0"
            Padding="0,7,0,0"
            BorderBrush="{DynamicResource AeBrush.Border}"
            BorderThickness="0,1,0,0">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource AeBrush.TextMuted}"
                Text="{Binding StatusMessage}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding StatusMessage}" />
        </Border>

        <progress:OperationProgressWindowHost
            Grid.RowSpan="5"
            CurrentDetailText="{Binding LoadingProgressDetailText}"
            IsOperationActive="{Binding IsLoadingOperation}"
            IsProgressIndeterminate="{Binding LoadingProgressIsIndeterminate}"
            ProgressMaximum="{Binding LoadingProgressMaximum}"
            ProgressValue="{Binding LoadingProgressValue}"
            StatusText="{Binding LoadingProgressStatusText}"
            WindowTitle="{loc:Loc OperationProgress.GitOperation}" />
    </Grid>
</windowhandling:AssetEditorWindow>
