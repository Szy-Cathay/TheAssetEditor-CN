<Window x:Class="AssetEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AssetEditor.Views"
        xmlns:historyViews="clr-namespace:AssetEditor.Views.FolderProjectHistory"
        xmlns:viewFactory="clr-namespace:Shared.Ui.Common.DataTemplates;assembly=Shared.Ui"
        xmlns:datatemplates="clr-namespace:Shared.Ui.Common.DataTemplates;assembly=Shared.Ui"
        xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
        xmlns:common="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:viewmodels="clr-namespace:AssetEditor.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        x:Name="window"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="600"
        ResizeMode="CanResize"
        Style="{StaticResource CustomWindowStyle}"
        WindowStartupLocation="CenterScreen"
        Title="{Binding ApplicationTitle, UpdateSourceTrigger=PropertyChanged}"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource AeBrush.Canvas}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource AeSize.ProminentControlHeight}"
                      ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Template>
        <ControlTemplate TargetType="Window">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <AdornerDecorator>
                    <ContentPresenter />
                </AdornerDecorator>
            </Border>
        </ControlTemplate>
    </Window.Template>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/GridSplitterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <datatemplates:EditorTemplateSelector x:Key="EditorSelector" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:MenuBarView x:Name="MainMenuBar" Grid.Row="0" />

        <Grid Grid.Row="1" Background="{DynamicResource AeBrush.Surface2}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding FileTreeColumnWidth, Mode=TwoWay}">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="MinWidth" Value="240" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPackFileExplorerVisible}" Value="False">
                                    <Setter Property="MinWidth" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="ActivityRail"
                Grid.Column="0">

                <ScrollViewer Grid.Column="0" Margin="0,0,0,48" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel>
                <ListBox
                    x:Name="ActivityBar"
                    VerticalAlignment="Top"
                    Grid.Column="0"
                    Style="{StaticResource AeShell.ActivityBar}"
                    SelectedIndex="{Binding HistoryWorkspace.SelectedSidebarTabIndex, Mode=TwoWay}">
                    <ListBoxItem
                        AutomationProperties.Name="{loc:Loc MainWindow.Activity.Resources}"
                        ToolTip="{loc:Loc MainWindow.Activity.Resources}">
                        <materialIcons:MaterialIcon
                            Width="17"
                            Height="17"
                            Kind="FolderOutline" />
                    </ListBoxItem>
                    <ListBoxItem
                        AutomationProperties.Name="{loc:Loc MainWindow.Activity.History}"
                        IsEnabled="{Binding DataContext.HistoryWorkspace.IsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{loc:Loc MainWindow.Activity.History}">
                        <materialIcons:MaterialIcon
                            Width="17"
                            Height="17"
                            Kind="History" />
                    </ListBoxItem>
                </ListBox>
                        <Border Height="1" Margin="10,8" Background="{DynamicResource AeBrush.Border}" />
                        <ItemsControl x:Name="EditorShortcuts" ItemsSource="{Binding MenuBar.Editors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding OpenEditorCommand}" IsEnabled="{Binding IsEnabled}"
                                            Style="{StaticResource AeShell.EditorShortcut}" ToolTip="{Binding DisplayName}"
                                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding DisplayName}">
                                        <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="19" Height="19" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Column="0" Margin="4,0,4,8" VerticalAlignment="Bottom"
                        Width="32" Height="32" Command="{Binding MenuBar.OpenSettingsWindowCommand}"
                        Style="{StaticResource AeShell.EditorShortcut}" ToolTip="{loc:Loc MainWindow.Shortcut.Settings}"
                        AutomationProperties.Name="{loc:Loc MainWindow.Shortcut.Settings}">
                    <materialIcons:MaterialIcon Kind="CogOutline" Width="18" Height="18" />
                </Button>

            </Grid>

            <Border x:Name="WorkspaceShell" Grid.Column="1"
                    Background="{DynamicResource AeBrush.Surface1}"
                    Visibility="{Binding IsPackFileExplorerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <TabControl
                    x:Name="WorkspaceSidebar"
                    Style="{StaticResource AeShell.WorkspaceSidebar}"
                    SelectedIndex="{Binding HistoryWorkspace.SelectedSidebarTabIndex, Mode=TwoWay}">
                    <TabItem>
                        <views:FileTreeView
                            x:Name="ResourceTreeView"
                            Padding="4"
                            DataContext="{Binding DataContext.FileTree, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </TabItem>
                    <TabItem
                        IsEnabled="{Binding DataContext.HistoryWorkspace.IsEnabled, RelativeSource={RelativeSource AncestorType=Window}}">
                        <historyViews:FolderProjectHistoryView
                            DataContext="{Binding DataContext.HistoryWorkspace.History, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter
                Grid.Column="2"
                Style="{StaticResource AeVerticalGridSplitterStyle}"
                Visibility="{Binding IsPackFileExplorerVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <views:CachedTabControl
                x:Name="EditorsTabControl"
                Grid.Column="3"
                Style="{StaticResource AeShell.EditorTabs}"
                ItemsSource="{Binding EditorManager.CurrentEditorsList, UpdateSourceTrigger=PropertyChanged}"
                SelectionChanged="OnEditorSelectionChanged"
                SelectedIndex="{Binding EditorManager.SelectedEditorIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                ContentTemplateSelector="{StaticResource EditorSelector}"
                viewFactory:ToolFactoryParameter.ViewFactory="{Binding ToolsFactory}">

                <views:CachedTabControl.Resources>
                    <common:BindingProxy x:Key="Proxy" Data="{Binding}" />
                </views:CachedTabControl.Resources>

                <views:CachedTabControl.ItemContainerStyle>
                    <Style
                        TargetType="{x:Type TabItem}"
                        BasedOn="{StaticResource AeShell.EditorTabItem}">
                        <EventSetter Event="Drop" Handler="TabItem_Drop" />
                        <EventSetter Event="PreviewMouseMove" Handler="TabItem_MouseMove" />
                        <EventSetter Event="PreviewMouseDown" Handler="TabItem_MouseDown" />
                        <Setter Property="AllowDrop" Value="True" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="behaviors:MouseMiddleClick.Command" Value="{Binding Source={StaticResource Proxy}, Path=Data.CloseToolCommand}" />
                        <Setter Property="behaviors:MouseMiddleClick.CommandParameter" Value="{Binding}" />
                    </Style>
                </views:CachedTabControl.ItemContainerStyle>

                <views:CachedTabControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.Resources>
                                <common:BindingProxy x:Key="GridProxy" Data="{Binding}" />
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid.ContextMenu>
                                <ContextMenu Style="{StaticResource AeMenu.Context}">
                                    <ContextMenu.Resources>
                                        <Style
                                            TargetType="{x:Type MenuItem}"
                                            BasedOn="{StaticResource AeMenu.Item}" />
                                    </ContextMenu.Resources>
                                    <MenuItem
                                        Header="{loc:Loc MainWindow.TabContextMenu.Close}"
                                        Command="{Binding Source={StaticResource Proxy}, Path=Data.CloseToolCommand}"
                                        CommandParameter="{Binding Source={StaticResource GridProxy}, Path=Data}" />
                                    <MenuItem Header="{loc:Loc MainWindow.TabContextMenu.CloseMultiple}">
                                        <MenuItem
                                            Header="{loc:Loc MainWindow.TabContextMenu.CloseOtherTabs}"
                                            Command="{Binding Source={StaticResource Proxy}, Path=Data.CloseOtherToolsCommand}"
                                            CommandParameter="{Binding Source={StaticResource GridProxy}, Path=Data}" />
                                        <MenuItem
                                            Header="{loc:Loc MainWindow.TabContextMenu.CloseAllTabs}"
                                            Command="{Binding Source={StaticResource Proxy}, Path=Data.CloseAllToolsCommand}"
                                            CommandParameter="{Binding Source={StaticResource GridProxy}, Path=Data}" />
                                        <MenuItem
                                            Header="{loc:Loc MainWindow.TabContextMenu.CloseTabsToLeft}"
                                            Command="{Binding Source={StaticResource Proxy}, Path=Data.CloseToolsToLeftCommand}"
                                            CommandParameter="{Binding Source={StaticResource GridProxy}, Path=Data}" />
                                        <MenuItem
                                            Header="{loc:Loc MainWindow.TabContextMenu.CloseTabsToRight}"
                                            Command="{Binding Source={StaticResource Proxy}, Path=Data.CloseToolsToRightCommand}"
                                            CommandParameter="{Binding Source={StaticResource GridProxy}, Path=Data}" />
                                    </MenuItem>
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <Ellipse
                                Grid.Column="0"
                                Width="6"
                                Height="6"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource AeBrush.Danger}"
                                IsHitTestVisible="False"
                                Visibility="{Binding HasUnsavedChanges, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AeText.Body}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                AutomationProperties.Name="{loc:Loc MainWindow.TabContextMenu.Close}"
                                Command="{Binding DataContext.CloseToolCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=TabControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource AeShell.TabCloseButton}"
                                ToolTip="{loc:Loc MainWindow.TabContextMenu.Close}">
                                <materialIcons:MaterialIcon
                                    Width="14"
                                    Height="14"
                                    Kind="Close" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </views:CachedTabControl.ItemTemplate>
            </views:CachedTabControl>
        </Grid>

        <Border
            x:Name="ApplicationStatusBar"
            Grid.Row="2"
            Style="{StaticResource AeShell.StatusBar}">
            <Grid Margin="8,4" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingPacks}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock
                        MaxWidth="260"
                        Style="{StaticResource AeShell.StatusText}"
                        Text="{Binding ApplicationTitle}" />
                    <Border
                        Width="1"
                        Height="12"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AeBrush.Border}" />
                    <TextBlock
                        MaxWidth="260"
                        Style="{StaticResource AeShell.StatusText}"
                        Text="{Binding CurrentGame}" />
                    <Border
                        Width="1"
                        Height="12"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AeBrush.Border}" />
                    <TextBlock
                        MaxWidth="360"
                        Style="{StaticResource AeShell.StatusText}"
                        Text="{Binding EditablePackFile}" />
                </StackPanel>

                <TextBlock
                    x:Name="UpdateCheckStatusText"
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource AeBrush.Warning}"
                    Style="{StaticResource AeShell.StatusText}"
                    Text="{Binding UpdateCheckStatus}"
                    ToolTip="{Binding UpdateCheckStatus}"
                    Visibility="{Binding HasUpdateCheckFailure, Converter={StaticResource BoolToVisibilityConverter}}" />

                <progress:OperationProgressWindowHost
                    x:Name="ApplicationLoadingProgress"
                    CurrentDetailText="{Binding LoadingProgressDetailText}"
                    IsOperationActive="{Binding IsLoadingPacks}"
                    IsProgressIndeterminate="{Binding LoadingProgressIsIndeterminate}"
                    ProgressMaximum="{Binding LoadingProgressMaximum}"
                    ProgressValue="{Binding LoadingProgressValue}"
                    StatusText="{Binding LoadingStatusText}"
                    WindowTitle="{Binding LoadingStatusText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
