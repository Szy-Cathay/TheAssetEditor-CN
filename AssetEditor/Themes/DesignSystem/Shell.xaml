<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:views="clr-namespace:AssetEditor.Views">
    <Style x:Key="AeShell.ActivityItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource AeInteraction.Selectable}">
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Height" Value="{StaticResource AeSize.ActivityRailWidth}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AeFocus.Keyboard}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border Margin="4" Background="{TemplateBinding Background}" CornerRadius="{StaticResource AeRadius.Control}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AeShell.ActivityBar" TargetType="{x:Type ListBox}">
        <Setter Property="Width" Value="{StaticResource AeSize.ActivityRailWidth}" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AeShell.ActivityItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AeShell.EditorShortcut" TargetType="{x:Type Button}" BasedOn="{StaticResource AeButton.Icon}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource AeRadius.Control}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="{StaticResource AeInteraction.DisabledOpacity}" />
                            <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AeBrush.SurfaceHover}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AeBrush.AccentSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextPrimary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AeShell.WorkspaceSidebar" TargetType="{x:Type TabControl}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter
                            x:Name="PART_SelectedContentHost"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentSource="SelectedContent"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="AeShell.EditorTabItem"
        BasedOn="{StaticResource AeTab.Item}"
        TargetType="{x:Type TabItem}">
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="Padding" Value="8,0,4,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border
                        x:Name="TabOutline"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Margin="2,3"
                        BorderThickness="0"
                        CornerRadius="{StaticResource AeRadius.EditorTab}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            ContentSource="Header"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="AeShell.TabCloseButton"
        BasedOn="{StaticResource AeButton.Icon}"
        TargetType="{x:Type Button}">
        <Setter Property="Width" Value="20" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style x:Key="AeShell.EditorTabs" TargetType="{x:Type views:CachedTabControl}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource AeBrush.Canvas}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:CachedTabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            x:Name="EditorTabStrip"
                            Background="{DynamicResource AeBrush.Surface1}">
                            <TabPanel
                                x:Name="HeaderPanel"
                                MinHeight="{StaticResource AeSize.TabHeight}"
                                IsItemsHost="True"
                                KeyboardNavigation.TabIndex="1"
                                Panel.ZIndex="1" />
                            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource AeBrush.Border}" IsHitTestVisible="False" />
                        </Grid>
                        <Border
                            Grid.Row="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            KeyboardNavigation.DirectionalNavigation="Contained"
                            KeyboardNavigation.TabIndex="2">
                            <Grid>
                                <Grid x:Name="PART_ItemsHolder" />
                                <StackPanel
                                    x:Name="EmptyEditorState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                    <materialIcons:MaterialIcon Kind="CubeOutline" Width="40" Height="40"
                                                               Margin="0,0,0,16" Foreground="{DynamicResource AeBrush.TextMuted}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource AeText.PageTitle}"
                                        Text="{loc:Loc MainWindow.EmptyEditor.Title}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource AeEmptyState.Description}"
                                        Text="{loc:Loc MainWindow.EmptyEditor.Description}" />
                                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Button Margin="0,0,8,0" Command="{Binding MenuBar.CreateFolderProjectCommand}"
                                                Content="{loc:Loc MainWindow.Shortcut.CreateProject}" Style="{StaticResource AeButton.Primary}" />
                                        <Button Command="{Binding MenuBar.OpenFolderProjectCommand}"
                                                Content="{loc:Loc MainWindow.Shortcut.OpenProject}" Style="{StaticResource AeButton.Secondary}" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc MainWindow.RecentProjects}" Style="{StaticResource AeText.SectionTitle}"
                                               Margin="0,16,0,8" />
                                    <TextBlock x:Name="RecentProjectsEmpty" Text="{loc:Loc MainWindow.RecentProjects.Empty}"
                                               Style="{StaticResource AeText.Caption}" Visibility="Collapsed" />
                                    <ListBox x:Name="RecentProjectsList" ItemsSource="{Binding MenuBar.RecentFolderProjects}"
                                             MaxHeight="240" MinWidth="360" MaxWidth="560" Style="{StaticResource AeList.View}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource AeList.Item}">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding Command}" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Header}"
                                                        HorizontalContentAlignment="Stretch" Height="Auto" MinHeight="44" Padding="8,4">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource AeButton.Quiet}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="{DynamicResource AeBrush.AccentSoft}" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <DockPanel>
                                                        <materialIcons:MaterialIcon Kind="FolderOutline" Width="18" Height="18" Margin="0,0,12,0" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource AeText.Caption}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="EditorTabStrip" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EmptyEditorState" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="RecentProjectsList" Property="HasItems" Value="False">
                            <Setter TargetName="RecentProjectsEmpty" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="AeShell.SidebarHeader"
        BasedOn="{StaticResource AeText.Body}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AeShell.StatusBar" TargetType="{x:Type Border}">
        <Setter Property="MinHeight" Value="{StaticResource AeSize.CompactRowHeight}" />
        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style
        x:Key="AeShell.StatusText"
        BasedOn="{StaticResource AeText.Caption}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</ResourceDictionary>
