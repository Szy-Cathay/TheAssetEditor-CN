<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style
        x:Key="AeMenu.Bar"
        BasedOn="{StaticResource {x:Type Menu}}"
        TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface1}" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextSecondary}" />
        <Setter Property="Padding" Value="4,0" />
    </Style>

    <Style
        x:Key="AeMenu.Item"
        BasedOn="{StaticResource {x:Type MenuItem}}"
        TargetType="{x:Type MenuItem}">
        <Setter Property="MinHeight" Value="{StaticResource AeSize.CompactRowHeight}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource AeBrush.SurfaceHover}" />
                <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource AeBrush.AccentSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextMuted}" />
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="AeMenu.Context"
        BasedOn="{StaticResource {x:Type ContextMenu}}"
        TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface2}" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style
        x:Key="AeToolTip"
        BasedOn="{StaticResource {x:Type ToolTip}}"
        TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface2}" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="AeFeedback.Notice" TargetType="{x:Type Border}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AeRadius.Control}" />
    </Style>

    <Style x:Key="AeFeedback.Icon" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="8.5" />
    </Style>

    <Style
        x:Key="AeFeedback.SuccessIcon"
        BasedOn="{StaticResource AeFeedback.Icon}"
        TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AeBrush.Success}" />
    </Style>

    <Style
        x:Key="AeFeedback.WarningIcon"
        BasedOn="{StaticResource AeFeedback.Icon}"
        TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AeBrush.Warning}" />
    </Style>

    <Style
        x:Key="AeFeedback.DangerIcon"
        BasedOn="{StaticResource AeFeedback.Icon}"
        TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AeBrush.Danger}" />
    </Style>

    <Style x:Key="AeEmptyState.Panel" TargetType="{x:Type Border}">
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AeRadius.Surface}" />
    </Style>

    <Style x:Key="AeEmptyState.Title" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextPrimary}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="AeEmptyState.Description" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextMuted}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AeProgress.Bar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface3}" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid ClipToBounds="True">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="2" />
                        <Border
                            x:Name="PART_Track"
                            Background="Transparent"
                            CornerRadius="2" />
                        <Border
                            x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="AeScrollBar.Compact"
        BasedOn="{StaticResource CompactScrollBarStyle}"
        TargetType="{x:Type ScrollBar}">
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Opacity" Value="0.75" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
