<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=netstandard">
    <sys:Double x:Key="AeSpace.1">4</sys:Double>
    <sys:Double x:Key="AeSpace.2">8</sys:Double>
    <sys:Double x:Key="AeSpace.3">12</sys:Double>
    <sys:Double x:Key="AeSpace.4">16</sys:Double>
    <sys:Double x:Key="AeSpace.6">24</sys:Double>
    <sys:Double x:Key="AeSpace.8">32</sys:Double>

    <sys:Double x:Key="AeSize.ActivityRailWidth">44</sys:Double>
    <sys:Double x:Key="AeSize.TabHeight">28</sys:Double>
    <GridLength x:Key="AeSize.TabGridLength">28</GridLength>
    <sys:Double x:Key="AeSize.CompactRowHeight">24</sys:Double>
    <sys:Double x:Key="AeSize.ControlHeight">28</sys:Double>
    <sys:Double x:Key="AeSize.ProminentControlHeight">32</sys:Double>
    <sys:Double x:Key="AeSize.SplitterHitTarget">8</sys:Double>
    <sys:Double x:Key="AeSize.ScrollBarThumb">4</sys:Double>
    <sys:Double x:Key="AeSize.ScrollBarThumbActive">6</sys:Double>
    <sys:Double x:Key="AeSize.ScrollBarThickness">6</sys:Double>

    <CornerRadius x:Key="AeRadius.Compact">4</CornerRadius>
    <CornerRadius x:Key="AeRadius.Control">7</CornerRadius>
    <CornerRadius x:Key="AeRadius.Surface">10</CornerRadius>
    <CornerRadius x:Key="AeRadius.Overlay">12</CornerRadius>
    <CornerRadius x:Key="AeRadius.EditorTab">7</CornerRadius>

    <sys:Double x:Key="AeInteraction.DisabledOpacity">0.42</sys:Double>

    <Duration x:Key="AeMotion.Pressed">0:0:0.090</Duration>
    <Duration x:Key="AeMotion.Release">0:0:0.160</Duration>
    <Duration x:Key="AeMotion.Hover">0:0:0.120</Duration>
    <Duration x:Key="AeMotion.Selection">0:0:0.140</Duration>
    <Duration x:Key="AeMotion.Overlay">0:0:0.160</Duration>
    <Duration x:Key="AeMotion.WindowEnter">0:0:0.280</Duration>
    <Duration x:Key="AeMotion.WindowExit">0:0:0.200</Duration>
    <Duration x:Key="AeMotion.Indeterminate">0:0:1.200</Duration>
    <sys:Double x:Key="AeMotion.WindowScale">0.96</sys:Double>
    <sys:Double x:Key="AeMotion.OverlayOffset">2</sys:Double>

    <Storyboard x:Key="AeMotion.ButtonPressStoryboard" x:Shared="False">
        <DoubleAnimation
            Storyboard.TargetName="InteractionScale"
            Storyboard.TargetProperty="ScaleX"
            To="0.985"
            Duration="0:0:0.070">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation
            Storyboard.TargetName="InteractionScale"
            Storyboard.TargetProperty="ScaleY"
            To="0.985"
            Duration="0:0:0.070">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="AeMotion.ButtonReleaseStoryboard" x:Shared="False">
        <DoubleAnimation
            Storyboard.TargetName="InteractionScale"
            Storyboard.TargetProperty="ScaleX"
            To="1"
            Duration="0:0:0.120">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation
            Storyboard.TargetName="InteractionScale"
            Storyboard.TargetProperty="ScaleY"
            To="1"
            Duration="0:0:0.120">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
</ResourceDictionary>
