<UserControl x:Class="CommonControls.FilterDialog.CollapsableFilterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:filterdialog="clr-namespace:CommonControls.FilterDialog"
             xmlns:loc="clr-namespace:Shared.Ui.Common"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="self"
             Background="Transparent"
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <Label
            Grid.Row="0"
            Grid.Column="0"
            Width="{Binding LabelTotalWidth, ElementName=self}"
            Content="{Binding LabelText, ElementName=self}"
            Style="{StaticResource AeForm.Label}"
            Visibility="{Binding ShowLabel, ElementName=self, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToCollapsedConverter}}" />

        <TextBox
            x:Name="SelectedFileName"
            Grid.Row="0"
            Grid.Column="1"
            IsReadOnly="True" />
        <Button
            x:Name="BrowseButton"
            Grid.Row="0"
            Grid.Column="2"
            Margin="6,0,0,0"
            Content="{loc:Loc General.Browse}"
            Style="{StaticResource AeButton.Secondary}" />
        <Button
            x:Name="ClearButton"
            Grid.Row="0"
            Grid.Column="3"
            Margin="4,0,0,0"
            Content="{materialIcons:MaterialIconExt Kind=Close}"
            Style="{StaticResource AeButton.Icon}"
            ToolTip="{loc:Loc General.Clear}" />

        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,0">
            <filterdialog:FilterUserControl  
                SearchItems="{Binding SearchItems, ElementName=self, UpdateSourceTrigger=PropertyChanged}"  
                SelectedItem="{Binding SelectedItem, ElementName=self, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                x:Name="FilterBox" 
                DisplayMemberPath="{Binding DisplayMemberPath, ElementName=self}" 
                InnerContent="{Binding InnerContent, ElementName=self}"  
                OnSearch="{Binding OnSearch, ElementName=self}"/>
        </Grid>
    </Grid>
</UserControl>
