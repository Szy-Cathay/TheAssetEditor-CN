<UserControl x:Class="CommonControls.FilterDialog.FilterUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors"
             xmlns:loc="clr-namespace:Shared.Ui.Common"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="self"
             Background="{DynamicResource AeBrush.Canvas}"
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="itemstyle" TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                <EventSetter Event="MouseDoubleClick" Handler="ResultList_MouseDoubleClick" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel >
        <DockPanel DockPanel.Dock="Top" Margin="0,5,0,5">
            <Label Style="{StaticResource AeForm.Label}" DockPanel.Dock="Left" Content="{loc:Loc General.Filter}" VerticalContentAlignment="Center"/>
            <TextBox x:Name="SearchTextBox" Height="20" behaviors:TextBoxExtensions.Watermark="{loc:Loc Shared.Filter.SearchHint}"/>
        </DockPanel>

        <ContentPresenter DockPanel.Dock="Top" Content="{Binding InnerContent, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
        <ListView 
            ItemContainerStyle="{StaticResource itemstyle}"
            SelectedItem="{Binding SelectedItem, ElementName=self, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
            x:Name="ResultList"
           
            DisplayMemberPath="{Binding DisplayMemberPath, ElementName=self, UpdateSourceTrigger=PropertyChanged}"
            Height="150" VerticalAlignment="Top"/>

    </DockPanel>
</UserControl>
