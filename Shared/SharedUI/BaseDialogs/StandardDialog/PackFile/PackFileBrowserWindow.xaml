<windowhandling:AssetEditorWindow x:Class="Shared.Ui.BaseDialogs.StandardDialog.PackFile.PackFileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:packfiletree="clr-namespace:Shared.Ui.BaseDialogs.PackFileTree"
        xmlns:loc="clr-namespace:Shared.Ui.Common"
        xmlns:windowhandling="clr-namespace:WindowHandling"
        mc:Ignorable="d"
        Title="{loc:Loc Shared.PackFileBrowserWindow.Title}" Height="520" Width="860"
        MinHeight="420" MinWidth="720" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        Background="{DynamicResource AeBrush.Canvas}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SelectionHint" Margin="12,12,12,0" Style="{StaticResource AeText.Body}" TextWrapping="Wrap"/>
        <packfiletree:PackFileBrowserView Grid.Row="1"
            Margin="12"
            DataContext="{Binding ViewModel, Mode=OneTime}"
            KeyboardNavigation.IsTabStop="True"
            KeyboardNavigation.TabIndex="0"
            ShowTitle="False" />
        <Border Grid.Row="2" Style="{StaticResource AeWorkflow.DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc General.Cancel}" IsCancel="True" MinWidth="88" Margin="0,0,8,0" Style="{StaticResource AeButton.Secondary}"/>
            <Button x:Name="ConfirmButton"
                HorizontalAlignment="Right"
                MinWidth="88"
                Click="Button_Click"
                Content="{loc:Loc Shared.PackFileBrowserWindow.Ok}"
                IsDefault="True"
                Style="{StaticResource AeButton.Primary}" />
            </StackPanel>
        </Border>
    </Grid>
</windowhandling:AssetEditorWindow>
