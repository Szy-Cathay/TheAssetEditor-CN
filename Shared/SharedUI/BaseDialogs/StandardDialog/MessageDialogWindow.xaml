<windowhandling:AssetEditorWindow
    x:Class="Shared.Ui.BaseDialogs.StandardDialog.MessageDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Shared.Ui.Common"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:windowhandling="clr-namespace:WindowHandling"
    Width="440"
    MinHeight="156"
    MaxHeight="560"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Background="{DynamicResource AeBrush.Canvas}"
    Foreground="{DynamicResource AeBrush.TextPrimary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource AeWorkflow.DialogBody}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon
                    x:Name="MessageIcon"
                    Width="20"
                    Height="20"
                    Margin="0,1,12,0"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Kind="InformationOutline"
                    Visibility="Collapsed" />
                <ScrollViewer
                    Grid.Column="1"
                    MaxHeight="420"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="MessageText"
                        LineHeight="19"
                        Style="{StaticResource AeText.Body}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Style="{StaticResource AeWorkflow.DialogFooter}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="OkButton"
                    MinWidth="88"
                    Click="OkButton_Click"
                    Content="{loc:Loc General.Ok}"
                    IsDefault="True"
                    Style="{StaticResource AeButton.Primary}" />
                <Button
                    x:Name="YesButton"
                    MinWidth="88"
                    Click="YesButton_Click"
                    Content="{loc:Loc General.Yes}"
                    IsDefault="True"
                    Style="{StaticResource AeButton.Primary}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="NoButton"
                    MinWidth="88"
                    Margin="8,0,0,0"
                    Click="NoButton_Click"
                    Content="{loc:Loc General.No}"
                    IsCancel="False"
                    Style="{StaticResource AeButton.Secondary}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="CancelButton"
                    MinWidth="88"
                    Margin="8,0,0,0"
                    Click="CancelButton_Click"
                    Content="{loc:Loc General.Cancel}"
                    IsCancel="True"
                    Style="{StaticResource AeButton.Secondary}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</windowhandling:AssetEditorWindow>
