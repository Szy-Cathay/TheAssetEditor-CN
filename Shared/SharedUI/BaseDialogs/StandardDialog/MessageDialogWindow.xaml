<windowhandling:AssetEditorWindow
    x:Class="Shared.Ui.BaseDialogs.StandardDialog.MessageDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Shared.Ui.Common"
    xmlns:windowhandling="clr-namespace:WindowHandling"
    Width="440"
    MinHeight="156"
    MaxHeight="560"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AeBrush.Canvas}"
    Foreground="{DynamicResource AeBrush.TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            MaxHeight="420"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <TextBlock
                x:Name="MessageText"
                FontSize="12"
                LineHeight="19"
                TextWrapping="Wrap" />
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="OkButton"
                MinWidth="88"
                Height="30"
                Click="OkButton_Click"
                Content="{loc:Loc General.Ok}"
                IsDefault="True" />
            <Button
                x:Name="YesButton"
                MinWidth="88"
                Height="30"
                Click="YesButton_Click"
                Content="{loc:Loc General.Yes}"
                IsDefault="True"
                Visibility="Collapsed" />
            <Button
                x:Name="NoButton"
                MinWidth="88"
                Height="30"
                Margin="8,0,0,0"
                Click="NoButton_Click"
                Content="{loc:Loc General.No}"
                IsCancel="True"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</windowhandling:AssetEditorWindow>
