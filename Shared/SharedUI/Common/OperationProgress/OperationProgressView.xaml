<UserControl
    x:Class="Shared.Ui.Common.OperationProgress.OperationProgressView"
    x:Name="ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{DynamicResource AeBrush.TextPrimary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="{Binding ElementName=ProgressView, Path=StatusText}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource AeText.SectionTitle}">
                    <Setter Property="Grid.Row" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=ProgressView, Path=UseLeadingIndicator}" Value="True">
                            <Setter Property="Grid.Row" Value="1" />
                            <Setter Property="Margin" Value="0,10,0,0" />
                            <Setter Property="TextAlignment" Value="Center" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock
            Margin="0,8,0,0"
            Foreground="{DynamicResource AeBrush.TextSecondary}"
            Text="{Binding ElementName=ProgressView, Path=CurrentDetailText}"
            TextTrimming="CharacterEllipsis"
            ToolTip="{Binding ElementName=ProgressView, Path=CurrentDetailText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource AeText.Caption}">
                    <Setter Property="Grid.Row" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=ProgressView, Path=UseLeadingIndicator}" Value="True">
                            <Setter Property="Grid.Row" Value="2" />
                            <Setter Property="TextAlignment" Value="Center" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid MinHeight="28">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Grid.Row" Value="2" />
                    <Setter Property="Margin" Value="0,12,0,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=ProgressView, Path=UseLeadingIndicator}" Value="True">
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                IsIndeterminate="{Binding ElementName=ProgressView, Path=IsProgressIndeterminate}"
                Maximum="{Binding ElementName=ProgressView, Path=ProgressMaximum}"
                Value="{Binding ElementName=ProgressView, Path=ProgressValue}" VerticalAlignment="Center">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource AeProgress.Bar}">
                        <Style.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <Grid x:Name="IndeterminateIndicator" Grid.ColumnSpan="2" Width="24" Height="24" HorizontalAlignment="Center">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ElementName=ProgressView, Path=IsProgressIndeterminate}" Value="True" />
                                    <Condition Binding="{Binding ElementName=ProgressView, Path=IsOperationActive}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Ellipse Margin="2" Stroke="{DynamicResource AeBrush.Border}" StrokeThickness="2" />
                <Path Data="M 12,2 A 10,10 0 1 1 2,12" Stroke="{DynamicResource AeBrush.TextPrimary}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="RingRotation" />
                    </Path.RenderTransform>
                </Path>
            </Grid>
            <TextBlock
                Grid.Column="1"
                Margin="12,0,0,0"
                Foreground="{DynamicResource AeBrush.TextMuted}"
                Style="{StaticResource AeText.Caption}"
                Text="{Binding ElementName=ProgressView, Path=ProgressSummaryText}"
                VerticalAlignment="Center" />
        </Grid>

        <Expander
            x:Name="DetailsExpander"
            Grid.Row="3"
            Margin="0,10,0,0"
            Expanded="OnDetailsExpansionChanged"
            Header="{Binding ElementName=ProgressView, Path=DetailsHeaderText}"
            Collapsed="OnDetailsExpansionChanged">
            <Expander.Style>
                <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=ProgressView, Path=ShowDetails}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="IsExpanded" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <Border
                Margin="0,8,0,0"
                Style="{StaticResource AeWorkflow.ProgressHistory}">
                <ListBox
                    x:Name="DetailsList"
                    MinHeight="96"
                    MaxHeight="260"
                    Style="{StaticResource AeList.View}"
                    ItemsSource="{Binding ElementName=ProgressView, Path=DetailHistory}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling" />
            </Border>
        </Expander>
    </Grid>
</UserControl>
