<UserControl
    x:Class="Shared.Ui.Common.OperationProgress.OperationProgressView"
    x:Name="ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="14"
            Text="{Binding ElementName=ProgressView, Path=StatusText}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            Opacity="0.72"
            Text="{Binding ElementName=ProgressView, Path=CurrentDetailText}"
            TextTrimming="CharacterEllipsis"
            ToolTip="{Binding ElementName=ProgressView, Path=CurrentDetailText}" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                Height="8"
                IsIndeterminate="{Binding ElementName=ProgressView, Path=IsProgressIndeterminate}"
                Maximum="{Binding ElementName=ProgressView, Path=ProgressMaximum}"
                Value="{Binding ElementName=ProgressView, Path=ProgressValue}" />
            <TextBlock
                Grid.Column="1"
                Margin="12,0,0,0"
                Opacity="0.72"
                Text="{Binding ElementName=ProgressView, Path=ProgressSummaryText}"
                VerticalAlignment="Center" />
        </Grid>

        <Expander
            x:Name="DetailsExpander"
            Grid.Row="3"
            Margin="0,10,0,0"
            Expanded="OnDetailsExpansionChanged"
            Header="{Binding ElementName=ProgressView, Path=DetailsHeaderText}"
            Collapsed="OnDetailsExpansionChanged">
            <Border
                Margin="0,8,0,0"
                Padding="8"
                BorderBrush="{DynamicResource TextBox.Static.Border}"
                BorderThickness="1"
                CornerRadius="3">
                <ListBox
                    x:Name="DetailsList"
                    MinHeight="96"
                    MaxHeight="260"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding ElementName=ProgressView, Path=DetailHistory}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling" />
            </Border>
        </Expander>
    </Grid>
</UserControl>
