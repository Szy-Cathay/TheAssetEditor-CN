<windowHandling:AssetEditorWindow
    x:Class="Shared.Ui.Common.OperationProgress.OperationProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress"
    xmlns:windowHandling="clr-namespace:WindowHandling"
    Title="{Binding WindowTitle}"
    Width="700"
    MinHeight="170"
    MaxHeight="700"
    Background="{DynamicResource AeBrush.Canvas}"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource CustomWindowStyle}"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <progress:OperationProgressView
            x:Name="ProgressView"
            CurrentDetailText="{Binding CurrentDetailText}"
            IsOperationActive="{Binding IsOperationActive}"
            IsProgressIndeterminate="{Binding IsProgressIndeterminate}"
            ProgressMaximum="{Binding ProgressMaximum}"
            ProgressValue="{Binding ProgressValue}"
            StatusText="{Binding StatusText}"
            UseDeferredVisibility="False" />

        <Button
            Grid.Row="1"
            MinWidth="88"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Command="{Binding CancelCommand}"
            Content="{Binding CancelText}">
            <Button.Style>
                <Style
                    TargetType="Button"
                    BasedOn="{StaticResource AeButton.Secondary}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CancelCommand}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</windowHandling:AssetEditorWindow>
