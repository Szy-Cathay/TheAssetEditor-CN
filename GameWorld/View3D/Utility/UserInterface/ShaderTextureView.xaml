<UserControl x:Class="GameWorld.Core.Utility.UserInterface.ShaderTextureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameWorld.Core.Utility.UserInterface"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d" 
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}"
             d:DesignHeight="40" d:DesignWidth="800">
    <UserControl.Resources>
        <local:TextureFileNameConverter x:Key="TextureFileNameConverter" />
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AeButton.Icon}" />
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource AeInput.TextBox}" />
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource AeInput.CheckBox}" />
        <ControlTemplate x:Key="ValidationErrorTemplate">
            <Border BorderBrush="{DynamicResource AeBrush.Danger}" BorderThickness="2">
                <AdornedElementPlaceholder/>
                <Border.ToolTip>
                    <ToolTip>
                        <ToolTip.Triggers>
                            <EventTrigger RoutedEvent="ToolTip.Opened">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ToolTip.Triggers>
                        <TextBlock Text="{Binding Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" Foreground="{DynamicResource AeBrush.Danger}"/>
                    </ToolTip>
                </Border.ToolTip>
            </Border>
        </ControlTemplate>


    </UserControl.Resources>
    <DockPanel>
        <CheckBox Margin="2,0,2,0"  IsChecked="{Binding ShouldRenderTexture, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalContentAlignment="Center" ToolTip="{loc:Loc ShaderTexture.ApplyTexture}"/>
        <Button Margin="1" Command="{Binding HandleClearTextureCommand}" DockPanel.Dock="Right"
                ToolTip="{loc:Loc ShaderTexture.RemoveTexture}" AutomationProperties.Name="{loc:Loc ShaderTexture.RemoveTexture}">
            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button Margin="1" Command="{Binding HandleBrowseTextureCommand}" DockPanel.Dock="Right"
                ToolTip="{loc:Loc ShaderTexture.BrowseFile}" AutomationProperties.Name="{loc:Loc ShaderTexture.BrowseFile}">
            <materialIcons:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button Margin="1" Command="{Binding HandlePreviewTextureCommand}" DockPanel.Dock="Right"
                ToolTip="{loc:Loc ShaderTexture.PreviewTexture}" AutomationProperties.Name="{loc:Loc ShaderTexture.PreviewTexture}">
            <materialIcons:MaterialIcon Kind="EyeOutline" Width="16" Height="16"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Grid Margin="2">
        <TextBox x:Name="PathEditor" Text="{Binding Path, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalContentAlignment="Center"
                 AutomationProperties.Name="{loc:Loc ShaderTexture.Path}">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource AeInput.TextBox}">
                    <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationErrorTemplate}"/>
                    <Setter Property="ToolTip" Value="{Binding Path}" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="False">
                            <Setter Property="Foreground" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="true">
                            <Setter Property="ToolTip" Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBlock x:Name="PathFileName" Margin="8,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource AeBrush.TextPrimary}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource TextureFileNameConverter}" Mode="OneWay">
                    <Binding Path="FileName" />
                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                    <Binding RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </TextBlock.Text>
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PathEditor}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
