<UserControl
    x:Class="Editors.AnimationVisualEditors.AnimationWorkbench.AnimationWorkbenchLayerView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1120"
    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.Title}"
    FocusVisualStyle="{StaticResource AeFocus.Keyboard}"
    Focusable="True"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown"
    Unloaded="Root_Unloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <Style x:Key="LayerBoneTreeItem" TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource AeTree.Item}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}" />
                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Margin="12" Padding="16" Style="{StaticResource AeSurface.Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource AeText.PageTitle}" Text="{loc:Loc AnimationWorkbench.Layer.Title}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Layer.Subtitle}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Padding="12,4" VerticalAlignment="Center" Background="{DynamicResource AeBrush.AccentSoft}" BorderBrush="{DynamicResource AeBrush.Accent}" BorderThickness="1" CornerRadius="{StaticResource AeRadius.Control}">
                    <TextBlock x:Name="HeaderStateText" Style="{StaticResource AeText.Label}" Text="{loc:Loc AnimationWorkbench.Layer.LivePreview}" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="360" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.9*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <Border Padding="16" Style="{StaticResource AeSurface.Control}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc AnimationWorkbench.Layer.BoneMask}" />
                            <TextBlock x:Name="SelectedBonesText" Grid.Column="1" Style="{StaticResource AeText.Technical}" />
                        </Grid>
                        <TextBox
                            x:Name="SearchTextBox"
                            Grid.Row="1"
                            Margin="0,12,0,8"
                            AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.SearchBones}"
                            Style="{StaticResource AeInput.TextBox}"
                            TextChanged="SearchTextBox_TextChanged" />
                        <Border Grid.Row="2" Padding="4" BorderBrush="{DynamicResource AeBrush.Border}" BorderThickness="1" CornerRadius="{StaticResource AeRadius.Control}">
                            <TreeView
                                x:Name="BoneTree"
                                AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.BoneTree}"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource LayerBoneTreeItem}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <CheckBox
                                            AutomationProperties.Name="{Binding Name}"
                                            Content="{Binding Name}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource AeInput.CheckBox}" />
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                        <TextBlock Grid.Row="3" Margin="0,12,0,8" Style="{StaticResource AeText.Label}" Text="{loc:Loc AnimationWorkbench.Layer.SavedMasks}" />
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="SavedMaskComboBox"
                                AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.SavedMasks}"
                                Style="{StaticResource AeInput.ComboBox}" />
                            <Button
                                x:Name="LoadMaskButton"
                                Grid.Column="2"
                                AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.LoadMask}"
                                Click="LoadMaskButton_Click"
                                Content="{loc:Loc AnimationWorkbench.Layer.LoadMask}"
                                Style="{StaticResource AeButton.Secondary}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="16" Style="{StaticResource AeSurface.Control}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc AnimationWorkbench.Layer.LayerParameters}" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource AeText.Label}" Text="{loc:Loc AnimationWorkbench.Layer.Mode}" />
                                <ComboBox
                                    x:Name="ModeComboBox"
                                    Grid.Column="1"
                                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.Mode}"
                                    SelectionChanged="ModeComboBox_SelectionChanged"
                                    Style="{StaticResource AeInput.ComboBox}">
                                    <ComboBoxItem Content="{loc:Loc AnimationWorkbench.Layer.Mode.Override}" />
                                    <ComboBoxItem Content="{loc:Loc AnimationWorkbench.Layer.Mode.Additive}" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource AeText.Label}" Text="{loc:Loc AnimationWorkbench.Layer.Reference}" />
                                <ComboBox
                                    x:Name="ReferenceComboBox"
                                    Grid.Column="1"
                                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.Reference}"
                                    SelectionChanged="ReferenceComboBox_SelectionChanged"
                                    Style="{StaticResource AeInput.ComboBox}">
                                    <ComboBoxItem Content="{loc:Loc AnimationWorkbench.Layer.Reference.FirstFrame}" />
                                    <ComboBoxItem Content="{loc:Loc AnimationWorkbench.Layer.Reference.RestPose}" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource AeText.Label}" Text="{loc:Loc AnimationWorkbench.Layer.Weight}" />
                                <Slider
                                    x:Name="WeightSlider"
                                    Grid.Column="1"
                                    Margin="8,0"
                                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.Weight}"
                                    Maximum="1"
                                    Minimum="0"
                                    SmallChange="0.05"
                                    Style="{StaticResource AeEditor.PlaybackSlider}"
                                    ValueChanged="WeightSlider_ValueChanged" />
                                <TextBlock x:Name="WeightText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AeText.Technical}" />
                            </Grid>

                            <TextBlock Margin="0,16,0,8" Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc AnimationWorkbench.Layer.OutputImpact}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Layer.SelectedBones}" />
                                <TextBlock x:Name="ImpactBonesText" Grid.Column="1" Style="{StaticResource AeText.Technical}" />
                                <TextBlock Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Layer.OutputFrames}" />
                                <TextBlock x:Name="OutputFramesText" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource AeText.Technical}" />
                                <TextBlock Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Layer.OutputDuration}" />
                                <TextBlock x:Name="OutputDurationText" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource AeText.Technical}" />
                                <TextBlock Grid.Row="3" Margin="0,4,0,0" Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Layer.Resampling}" />
                                <TextBlock x:Name="ResampleText" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource AeText.Caption}" TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Margin="0,16,0,8" Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc AnimationWorkbench.Layer.Diagnostics}" />
                            <TextBlock x:Name="DiagnosticText" Style="{StaticResource AeText.Caption}" TextWrapping="Wrap" />

                            <TextBlock Margin="0,16,0,8" Style="{StaticResource AeText.Label}" Text="{loc:Loc AnimationWorkbench.Layer.MaskName}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="MaskNameTextBox"
                                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.MaskName}"
                                    Style="{StaticResource AeInput.TextBox}" />
                                <Button
                                    x:Name="SaveMaskButton"
                                    Grid.Column="2"
                                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.SaveMask}"
                                    Click="SaveMaskButton_Click"
                                    Content="{loc:Loc AnimationWorkbench.Layer.SaveMask}"
                                    Style="{StaticResource AeButton.Secondary}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Style="{StaticResource AeText.Label}" Text="{loc:Loc AnimationWorkbench.Layer.ReadyHint}" TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="RefreshPreviewButton"
                    Grid.Column="1"
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.RefreshPreview}"
                    Click="RefreshPreviewButton_Click"
                    Content="{loc:Loc AnimationWorkbench.Layer.RefreshPreview}"
                    Style="{StaticResource AeButton.Secondary}" />
                <Button
                    x:Name="ApplyButton"
                    Grid.Column="3"
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.Apply}"
                    Click="ApplyButton_Click"
                    Content="{loc:Loc AnimationWorkbench.Layer.Apply}"
                    Style="{StaticResource AeButton.Primary}" />
                <Button
                    x:Name="CancelButton"
                    Grid.Column="5"
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Layer.Cancel}"
                    Click="CancelButton_Click"
                    Content="{loc:Loc AnimationWorkbench.Layer.Cancel}"
                    Style="{StaticResource AeButton.Quiet}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
