<UserControl
    x:Class="Editors.AnimationVisualEditors.AnimationWorkbench.TrustedAnimationPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="1500"
    AutomationProperties.Name="{loc:Loc DisplayName.AnimationWorkbench}"
    Background="{DynamicResource AeBrush.Canvas}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToCollapsedConverter" />
            <Style BasedOn="{StaticResource AeInput.TextBox}" TargetType="{x:Type TextBox}" />
            <Style BasedOn="{StaticResource AeButton.Secondary}" TargetType="{x:Type Button}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,8,8"
                VerticalAlignment="Center"
                Style="{StaticResource AeText.Label}"
                Text="{loc:Loc AnimationWorkbench.TrustedPreview.Model}" />
            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,8,8"
                IsReadOnly="True"
                Text="{Binding Model.Path}"
                ToolTip="{Binding Model.Path}" />
            <TextBox
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,0,8,8"
                IsReadOnly="True"
                Text="{Binding Model.Source}"
                ToolTip="{Binding Model.Source}" />
            <Expander
                Grid.Row="0"
                Grid.Column="3"
                Margin="0,0,8,8"
                Header="{loc:Loc AnimationWorkbench.TrustedPreview.Diagnostic}"
                Style="{StaticResource AeInput.ExpandableField}"
                Visibility="{Binding HasModelDiagnostic, Converter={StaticResource BoolToCollapsedConverter}}">
                <TextBox
                    MinWidth="320"
                    IsReadOnly="True"
                    Text="{Binding Model.Diagnostic}"
                    TextWrapping="Wrap" />
            </Expander>
            <ToggleButton
                Grid.Row="0"
                Grid.Column="4"
                Margin="0,0,0,8"
                AutomationProperties.Name="{loc:Loc AnimationWorkbench.TrustedPreview.ShowModel}"
                IsChecked="{Binding ShowModel, Mode=TwoWay}"
                IsEnabled="{Binding IsReady}"
                Style="{StaticResource AeButton.VisibilityToggle}"
                ToolTip="{loc:Loc AnimationWorkbench.TrustedPreview.ShowModel}" />

            <TextBlock
                Grid.Row="1"
                Margin="0,0,8,8"
                VerticalAlignment="Center"
                Style="{StaticResource AeText.Label}"
                Text="{loc:Loc AnimationWorkbench.TrustedPreview.Skeleton}" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,8,8"
                IsReadOnly="True"
                Text="{Binding Skeleton.Path}"
                ToolTip="{Binding Skeleton.Path}" />
            <TextBox
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,0,8,8"
                IsReadOnly="True"
                Text="{Binding Skeleton.Source}"
                ToolTip="{Binding Skeleton.Source}" />
            <Expander
                Grid.Row="1"
                Grid.Column="3"
                Margin="0,0,8,8"
                Header="{loc:Loc AnimationWorkbench.TrustedPreview.Diagnostic}"
                Style="{StaticResource AeInput.ExpandableField}"
                Visibility="{Binding HasSkeletonDiagnostic, Converter={StaticResource BoolToCollapsedConverter}}">
                <TextBox
                    MinWidth="320"
                    IsReadOnly="True"
                    Text="{Binding Skeleton.Diagnostic}"
                    TextWrapping="Wrap" />
            </Expander>
            <ToggleButton
                Grid.Row="1"
                Grid.Column="4"
                Margin="0,0,0,8"
                AutomationProperties.Name="{loc:Loc AnimationWorkbench.TrustedPreview.ShowSkeleton}"
                IsChecked="{Binding ShowSkeleton, Mode=TwoWay}"
                IsEnabled="{Binding IsReady}"
                Style="{StaticResource AeButton.VisibilityToggle}"
                ToolTip="{loc:Loc AnimationWorkbench.TrustedPreview.ShowSkeleton}" />

            <TextBlock
                Grid.Row="2"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Style="{StaticResource AeText.Label}"
                Text="{loc:Loc AnimationWorkbench.TrustedPreview.Animation}" />
            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,0,8,0"
                IsReadOnly="True"
                Text="{loc:Loc AnimationWorkbench.TrustedPreview.NotSelected}" />
            <TextBox
                Grid.Row="2"
                Grid.Column="2"
                Margin="0,0,8,0"
                IsReadOnly="True"
                Text="{Binding Animation.Source}" />
            <Expander
                Grid.Row="2"
                Grid.Column="3"
                Margin="0,0,8,0"
                Header="{loc:Loc AnimationWorkbench.TrustedPreview.Diagnostic}"
                Style="{StaticResource AeInput.ExpandableField}"
                Visibility="{Binding HasAnimationDiagnostic, Converter={StaticResource BoolToCollapsedConverter}}">
                <TextBox
                    MinWidth="320"
                    IsReadOnly="True"
                    Text="{Binding Animation.Diagnostic}"
                    TextWrapping="Wrap" />
            </Expander>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            ClipToBounds="True"
            Style="{StaticResource AeSurface.Panel}">
            <Grid>
                <ContentControl
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.TrustedPreview.Viewport}"
                    Content="{Binding GameWorld}" />
                <Border
                    Padding="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource AeSurface.Overlay}">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Command="{Binding FocusModelCommand}"
                            Content="{loc:Loc AnimationWorkbench.TrustedPreview.FocusModel}"
                            IsEnabled="{Binding IsReady}" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding ShowFrontCommand}"
                            Content="{loc:Loc AnimationWorkbench.TrustedPreview.FrontView}"
                            IsEnabled="{Binding IsReady}" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding ResetCameraCommand}"
                            Content="{loc:Loc AnimationWorkbench.TrustedPreview.ResetCamera}"
                            IsEnabled="{Binding IsReady}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                AutomationProperties.Name="{loc:Loc AnimationWorkbench.TrustedPreview.NoAnimation}"
                IsEnabled="False"
                Style="{StaticResource AeEditor.PlaybackToggle}"
                ToolTip="{loc:Loc AnimationWorkbench.TrustedPreview.NoAnimation}">
                <Canvas Width="16" Height="16">
                    <Path
                        Data="M 4,2 L 14,8 L 4,14 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" />
                </Canvas>
            </ToggleButton>
            <Slider
                Grid.Column="1"
                Margin="8,0"
                IsEnabled="False"
                Maximum="1"
                Style="{StaticResource AeEditor.PlaybackSlider}"
                Value="0" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource AeText.Caption}"
                Text="{loc:Loc AnimationWorkbench.TrustedPreview.ReadOnlyTimeline}" />
        </Grid>
    </Grid>
</UserControl>
