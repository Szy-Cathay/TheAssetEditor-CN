<UserControl
    x:Class="Editors.AnimationVisualEditors.AnimationWorkbench.AnimationWorkbenchView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Editors.AnimationVisualEditors.AnimationWorkbench"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:player="clr-namespace:AnimationEditor.Common.AnimationPlayer;assembly=Editors.Shared.Core"
    d:DesignHeight="940"
    d:DesignWidth="1600"
    AutomationProperties.Name="{loc:Loc DisplayName.AnimationWorkbench}"
    Background="{DynamicResource AeBrush.Canvas}"
    Focusable="True"
    FocusVisualStyle="{StaticResource AeFocus.Keyboard}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}"
    PreviewKeyDown="Root_PreviewKeyDown"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/GridSplitterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Margin="8"
        Style="{StaticResource AeSurface.Panel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="5" />
            <RowDefinition Height="300" MinHeight="190" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="12,8"
            Background="Transparent"
            BorderBrush="{DynamicResource AeBrush.Border}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.LoadAnimationA}"
                    Command="{Binding BrowseAnimationACommand}"
                    Content="{loc:Loc AnimationWorkbench.Shell.LoadAnimationA}"
                    IsEnabled="{Binding IsWorkbenchEnabled}"
                    Style="{StaticResource AeButton.Primary}" />
                <Button
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.LoadAnimationB}"
                    Command="{Binding BrowseAnimationBCommand}"
                    Content="{loc:Loc AnimationWorkbench.Shell.LoadAnimationB}"
                    IsEnabled="{Binding CanBrowseAnimationB}" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.LoadTargetSkeleton}"
                    Command="{Binding BrowseTargetSkeletonCommand}"
                    Content="{loc:Loc AnimationWorkbench.Shell.LoadTargetSkeleton}"
                    IsEnabled="{Binding IsWorkbenchEnabled}" />
                <Button
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.LoadPreviewModel}"
                    Command="{Binding BrowsePreviewModelCommand}"
                    Content="{loc:Loc AnimationWorkbench.Shell.LoadPreviewModel}"
                    IsEnabled="{Binding CanBrowsePreviewModel}" />

                <Button
                    Grid.Column="5"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.PreviewAnimationA}"
                    Command="{Binding SelectAnimationACommand}"
                    Content="{loc:Loc AnimationWorkbench.Shell.PreviewAnimationA}"
                    IsEnabled="{Binding CanEdit}" />
                <Button
                    Grid.Column="6"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.PreviewAnimationB}"
                    Command="{Binding SelectAnimationBCommand}"
                    Content="{loc:Loc AnimationWorkbench.Shell.PreviewAnimationB}"
                    IsEnabled="{Binding CanSelectAnimationB}" />
                <Button
                    Grid.Column="7"
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.PreviewResult}"
                    Command="{Binding SelectResultCommand}"
                    Content="{loc:Loc AnimationWorkbench.Shell.PreviewResult}"
                    IsEnabled="{Binding CanSelectResult}" />

                <StackPanel
                    Grid.Column="9"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AeBrush.Accent}"
                        Style="{StaticResource AeText.Label}"
                        Text="{loc:Loc AnimationWorkbench.Shell.Warhammer3Badge}" />
                    <Button
                        AutomationProperties.HelpText="{Binding SaveUnavailableReason}"
                        AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.SaveAsNewResource}"
                        Command="{Binding SaveAsNewResourceCommand}"
                        Content="{loc:Loc AnimationWorkbench.Shell.SaveAsNewResource}"
                        IsEnabled="{Binding CanSave}"
                        Style="{StaticResource AeButton.Primary}"
                        ToolTip="{Binding SaveUnavailableReason}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="190" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="720" MinWidth="600" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="12"
                Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Style="{StaticResource AeText.SectionTitle}"
                        Text="{loc:Loc AnimationWorkbench.Shell.Sources}" />
                    <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AnimationWorkbenchSourceItem}">
                                <Border
                                    Padding="0,8"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource AeBrush.Border}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Top"
                                            Style="{StaticResource AeText.SectionTitle}"
                                            Text="{Binding Slot}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                Style="{StaticResource AeText.Body}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding FullPath}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Style="{StaticResource AeText.Caption}"
                                                Text="{Binding Details}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Grid.Row="3"
                        Style="{StaticResource AeText.SectionTitle}"
                        Text="{loc:Loc AnimationWorkbench.Shell.TargetBones}" />
                    <ListBox
                        Grid.Row="4"
                        Margin="0,8,0,0"
                        AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.TargetBones}"
                        ItemsSource="{Binding BoneNames}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling" />
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="1"
                AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.LeftSplitter}"
                Style="{StaticResource AeVerticalGridSplitterStyle}" />

            <Border
                Grid.Column="2"
                Background="{DynamicResource AeBrush.Canvas}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl
                        AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.Viewport}"
                        Content="{Binding GameWorld}" />
                    <Border
                        HorizontalAlignment="Left"
                        Margin="12"
                        Padding="8,4"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AeBrush.Surface2}">
                        <StackPanel>
                            <TextBlock
                                MaxWidth="520"
                                Style="{StaticResource AeText.Caption}"
                                Text="{Binding StatusText}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Margin="0,4,0,0"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AeText.Caption}"
                                    Text="{loc:Loc AnimationWorkbench.Shell.PreviewModelVisibility}" />
                                <ToggleButton
                                    Margin="2,0,8,0"
                                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.PreviewModelVisibility}"
                                    IsChecked="{Binding ShowPreviewModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding HasPreviewModel}"
                                    Style="{StaticResource AeButton.VisibilityToggle}"
                                    ToolTip="{loc:Loc AnimationWorkbench.Shell.PreviewModelVisibility}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AeText.Caption}"
                                    Text="{loc:Loc AnimationWorkbench.Shell.PreviewSkeletonVisibility}" />
                                <ToggleButton
                                    Margin="2,0,8,0"
                                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.PreviewSkeletonVisibility}"
                                    IsChecked="{Binding ShowPreviewSkeleton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanBrowsePreviewModel}"
                                    Style="{StaticResource AeButton.VisibilityToggle}"
                                    ToolTip="{loc:Loc AnimationWorkbench.Shell.PreviewSkeletonVisibility}" />
                                <Button
                                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.ClearPreviewModel}"
                                    Command="{Binding ClearPreviewModelCommand}"
                                    Content="{loc:Loc AnimationWorkbench.Shell.ClearPreviewModel}"
                                    IsEnabled="{Binding CanClearPreviewModel}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <player:AnimationPlayerView
                        Grid.Row="1"
                        DataContext="{Binding Player}" />
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="3"
                AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.RightSplitter}"
                Style="{StaticResource AeVerticalGridSplitterStyle}" />

            <Border
                Grid.Column="4"
                Background="Transparent">
                <TabControl
                    x:Name="ToolTabs"
                    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.ToolsAndIssues}"
                    SelectionChanged="ToolTabs_SelectionChanged">
                    <TabItem Header="{loc:Loc AnimationWorkbench.Shell.Issues}" Tag="Issues">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource AeText.SectionTitle}"
                                Text="{loc:Loc AnimationWorkbench.Shell.IssuesTitle}" />
                            <ListBox
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.IssuesTitle}"
                                ItemsSource="{Binding Diagnostics}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="4"
                                            Style="{StaticResource AeText.Body}"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{loc:Loc AnimationWorkbench.Shell.Blend}" Tag="Blend">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <local:AnimationWorkbenchBlendView
                                Controller="{Binding BlendController}" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{loc:Loc AnimationWorkbench.Shell.Layer}" Tag="Layer">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <local:AnimationWorkbenchLayerView
                                Controller="{Binding LayerController}" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{loc:Loc AnimationWorkbench.Shell.Retarget}" Tag="Retarget">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <local:AnimationWorkbenchRetargetView
                                Controller="{Binding RetargetController}" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{loc:Loc AnimationWorkbench.Shell.BaseAnimation}" Tag="BaseAnimation">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <local:AnimationWorkbenchBaseAnimationView
                                Controller="{Binding DataContext.BaseAnimationController, ElementName=Root}" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{loc:Loc AnimationWorkbench.Shell.MetaData}" Tag="MetaData">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <local:AnimationWorkbenchMetaDataView
                                Controller="{Binding DataContext.MetaDataController, ElementName=Root}" />
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <GridSplitter
            Grid.Row="2"
            AutomationProperties.Name="{loc:Loc AnimationWorkbench.Shell.TimelineSplitter}"
            Style="{StaticResource AeHorizontalGridSplitterStyle}" />

        <Border
            Grid.Row="3"
            IsEnabled="{Binding CanEdit}"
            Background="Transparent">
            <local:AnimationWorkbenchTimelineView
                AutomationProperties.Name="{loc:Loc AnimationWorkbench.Timeline.Title}"
                Controller="{Binding TimelineController}" />
        </Border>

        <Border
            Grid.Row="4"
            Padding="12,8"
            Background="{DynamicResource AeBrush.Surface2}"
            BorderBrush="{DynamicResource AeBrush.Border}"
            BorderThickness="0,1,0,0">
            <TextBlock
                Style="{StaticResource AeText.Caption}"
                Text="{Binding StatusText}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
    </Border>
</UserControl>
