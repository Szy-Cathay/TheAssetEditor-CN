<UserControl
    x:Class="Editors.AnimationVisualEditors.AnimationWorkbench.AnimationWorkbenchRetargetView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Editors.AnimationVisualEditors.AnimationWorkbench"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1120"
    AutomationProperties.Name="{loc:Loc AnimationWorkbench.Retarget.Title}"
    FocusVisualStyle="{StaticResource AeFocus.Keyboard}"
    Focusable="True"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown"
    Unloaded="Root_Unloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Margin="12" Padding="16" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource AeText.PageTitle}" Text="{loc:Loc AnimationWorkbench.Retarget.Title}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Retarget.Subtitle}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    x:Name="HeaderStateText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AeBrush.Accent}"
                    Style="{StaticResource AeText.Label}"
                    Text="{loc:Loc AnimationWorkbench.Retarget.LivePreview}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.7*" />
                </Grid.ColumnDefinitions>

                <Border Padding="16" Background="Transparent">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc AnimationWorkbench.Retarget.MappingList}" />
                            <TextBlock x:Name="MappingCountText" Grid.Column="1" Style="{StaticResource AeText.Technical}" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="SearchTextBox"
                                AutomationProperties.Name="{loc:Loc AnimationWorkbench.Retarget.Search}"
                                Style="{StaticResource AeInput.TextBox}"
                                TextChanged="Filter_Changed" />
                            <CheckBox
                                x:Name="UnmappedOnlyCheckBox"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{loc:Loc AnimationWorkbench.Retarget.UnmappedOnly}"
                                Checked="Filter_Changed"
                                Content="{loc:Loc AnimationWorkbench.Retarget.UnmappedOnly}"
                                Style="{StaticResource AeInput.CheckBox}"
                                Unchecked="Filter_Changed" />
                        </Grid>
                        <Grid Grid.Row="2" Margin="8,0,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Retarget.TargetBone}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Retarget.SourceBone}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Retarget.Confidence}" />
                        </Grid>
                        <Border Grid.Row="3" BorderBrush="{DynamicResource AeBrush.Border}" BorderThickness="1">
                            <ListBox
                                x:Name="MappingList"
                                ScrollViewer.CanContentScroll="True"
                                Style="{StaticResource AeList.View}"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,4" BorderBrush="{DynamicResource AeBrush.Border}" BorderThickness="0,0,0,1">
                                                <Grid MinHeight="36">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="1.25*" />
                                                        <ColumnDefinition Width="88" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource AeText.Label}" Text="{Binding TargetBoneName}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            Foreground="{DynamicResource AeBrush.Warning}"
                                                            Style="{StaticResource AeText.Caption}"
                                                            Text="{loc:Loc AnimationWorkbench.Retarget.CoreBone}"
                                                            Visibility="{Binding IsCoreBone, Converter={StaticResource BooleanToVisibility}}" />
                                                    </StackPanel>
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        Margin="8,0"
                                                        AutomationProperties.Name="{Binding TargetBoneName}"
                                                        DisplayMemberPath="Name"
                                                        ItemsSource="{Binding DataContext.SourceOptions, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        SelectedValue="{Binding SourceBoneIndex, Mode=OneWay}"
                                                        SelectedValuePath="Index"
                                                        SelectionChanged="SourceBoneComboBox_SelectionChanged"
                                                        Style="{StaticResource AeInput.ComboBox}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AeText.Label}">
                                                                <Setter Property="Text" Value="{loc:Loc AnimationWorkbench.Retarget.Confidence.None}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Confidence}" Value="{x:Static local:AnimationWorkbenchRetargetConfidence.Low}">
                                                                        <Setter Property="Text" Value="{loc:Loc AnimationWorkbench.Retarget.Confidence.Low}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Confidence}" Value="{x:Static local:AnimationWorkbenchRetargetConfidence.Medium}">
                                                                        <Setter Property="Text" Value="{loc:Loc AnimationWorkbench.Retarget.Confidence.Medium}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Confidence}" Value="{x:Static local:AnimationWorkbenchRetargetConfidence.High}">
                                                                        <Setter Property="Text" Value="{loc:Loc AnimationWorkbench.Retarget.Confidence.High}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Confidence}" Value="{x:Static local:AnimationWorkbenchRetargetConfidence.Manual}">
                                                                        <Setter Property="Text" Value="{loc:Loc AnimationWorkbench.Retarget.Confidence.Manual}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="16" Background="Transparent">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc AnimationWorkbench.Retarget.Summary}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Retarget.Mapped}" />
                                <TextBlock x:Name="MappedCountText" Grid.Column="1" Style="{StaticResource AeText.Technical}" />
                                <TextBlock Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Retarget.Unmapped}" />
                                <TextBlock x:Name="UnmappedCountText" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource AeText.Technical}" />
                                <TextBlock Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Retarget.CoreMapped}" />
                                <TextBlock x:Name="CoreCountText" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource AeText.Technical}" />
                                <TextBlock Grid.Row="3" Margin="0,4,0,0" Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Retarget.ProfileState}" />
                                <TextBlock x:Name="ProfileStateText" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource AeText.Label}" />
                            </Grid>

                            <TextBlock Margin="0,16,0,8" Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc AnimationWorkbench.Retarget.Diagnostics}" />
                            <TextBlock x:Name="DiagnosticText" Style="{StaticResource AeText.Caption}" TextWrapping="Wrap" />

                            <TextBlock Margin="0,16,0,8" Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc AnimationWorkbench.Retarget.ConfidenceLegend}" />
                            <TextBlock Style="{StaticResource AeText.Caption}" Text="{loc:Loc AnimationWorkbench.Retarget.ConfidenceHint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource AeText.Label}" Text="{loc:Loc AnimationWorkbench.Retarget.ReadyHint}" TextWrapping="Wrap" />
                <Button x:Name="AutoMapButton" Grid.Column="1" AutomationProperties.Name="{loc:Loc AnimationWorkbench.Retarget.AutoMap}" Click="AutoMapButton_Click" Content="{loc:Loc AnimationWorkbench.Retarget.AutoMap}" Style="{StaticResource AeButton.Secondary}" />
                <Button x:Name="SaveProfileButton" Grid.Column="3" AutomationProperties.Name="{loc:Loc AnimationWorkbench.Retarget.SaveProfile}" Click="SaveProfileButton_Click" Content="{loc:Loc AnimationWorkbench.Retarget.SaveProfile}" Style="{StaticResource AeButton.Secondary}" />
                <Button x:Name="RefreshPreviewButton" Grid.Column="5" AutomationProperties.Name="{loc:Loc AnimationWorkbench.Retarget.RefreshPreview}" Click="RefreshPreviewButton_Click" Content="{loc:Loc AnimationWorkbench.Retarget.RefreshPreview}" Style="{StaticResource AeButton.Secondary}" />
                <Button x:Name="ApplyButton" Grid.Column="7" AutomationProperties.Name="{loc:Loc AnimationWorkbench.Retarget.Apply}" Click="ApplyButton_Click" Content="{loc:Loc AnimationWorkbench.Retarget.Apply}" Style="{StaticResource AeButton.Primary}" />
                <Button x:Name="CancelButton" Grid.Column="9" AutomationProperties.Name="{loc:Loc AnimationWorkbench.Retarget.Cancel}" Click="CancelButton_Click" Content="{loc:Loc AnimationWorkbench.Retarget.Cancel}" Style="{StaticResource AeButton.Quiet}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
