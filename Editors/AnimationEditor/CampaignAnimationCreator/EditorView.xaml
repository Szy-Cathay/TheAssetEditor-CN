<UserControl x:Class="AnimationEditor.CampaignAnimationCreator.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnimationEditor.CampaignAnimationCreator"
              xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="32,0,8,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Style="{StaticResource AeForm.Label}" Grid.Column="0" Grid.Row="0" Content="{loc:Loc CampaignAnim.RootBone}"/>
        <ComboBox Grid.Column="1" Grid.Row="0"
                  Margin="0,2,0,2"
                  IsEditable="True"
                  IsTextSearchEnabled="false"
                  DisplayMemberPath="BoneName"
                  Text="{Binding ModelBoneList.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                  ItemsSource="{Binding ModelBoneList.Values}"
                  SelectedItem="{Binding ModelBoneList.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource AeButton.Primary}" Content="{loc:Loc CampaignAnim.Convert}" Margin="0,8,0,2" Click="{s:MethodBinding Convert}" />
        <Button Grid.Row="2" Grid.Column="1" Content="{loc:Loc General.Save}" Margin="0,2,0,2" Click="{s:MethodBinding SaveAnimation}" />
    </Grid>
</UserControl>
