<UserControl x:Class="AnimationEditor.MountAnimationCreator.Views.SaveAndPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AnimationEditor.MountAnimationCreator"
              xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Expander IsExpanded="True" Header="{loc:Loc MountAnim.SaveAndPreviewHeader}">
        <Border BorderThickness="0">
            <StackPanel Grid.IsSharedSizeScope="True">
                <DockPanel Grid.Row="0" Margin="10,5,10,0">
                    <Button Content="{loc:Loc MountAnim.UpdatePreview}" Click="{s:MethodBinding CreateMountAnimationAction}" IsEnabled="{Binding CanPreview.Value, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <Grid Grid.Row="2" Margin="10,5,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SaveLabel" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource AeForm.Label}" Grid.Column="0" Content="{loc:Loc MountAnim.SelectedFragment}"/>
                    <ComboBox Grid.Column="1"
                          IsEditable="True"
                          IsTextSearchEnabled="false"
                          DisplayMemberPath="FileName"
                          Text="{Binding ActiveOutputFragment.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                          ItemsSource="{Binding ActiveOutputFragment.Values}" 
                          SelectedItem="{Binding ActiveOutputFragment.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    <Button Grid.Column="2" Content=".." Width="25" Margin="2,0,0,0" Click="{s:MethodBinding ViewOutputFragmentAction}" />
                </Grid>

                <Grid Grid.Row="3" Margin="10,5,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SaveLabel" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource AeForm.Label}" Grid.Column="0" Content="{loc:Loc MountAnim.SelectedSlot}"/>
                    <ComboBox Grid.Column="1"
                          IsEditable="True"
                          IsTextSearchEnabled="false"
                          DisplayMemberPath="Entry.Value.Slot.Value"
                          Text="{Binding ActiveFragmentSlot.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                          ItemsSource="{Binding ActiveFragmentSlot.Values}" 
                          SelectedItem="{Binding ActiveFragmentSlot.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                         
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ComboBoxItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsValid.Value}" Value="false">
                                        <Setter Property="Foreground" Value="{DynamicResource AeBrush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>

                    </ComboBox>
                    <Button Grid.Column="2" Content="{loc:Loc MountAnim.SaveToFragment}" Margin="3,0,0,0" Click="{s:MethodBinding AddAnimationToFragment}" IsEnabled="{Binding CanAddToFragment.Value, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Grid Grid.Row="4" Margin="10,5,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="0.5*"/>
                    </Grid.ColumnDefinitions>

                    <Button  Grid.Column="0" Click="{s:MethodBinding SaveCurrentAnimationAction}" Content="{loc:Loc MountAnim.SaveCurrent}" IsEnabled="{Binding CanSave.Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,1,0"/>
                    <Button  Grid.Column="1" Click="{s:MethodBinding BatchProcessUsingTableAction}" Content="{loc:Loc MountAnim.BatchSaveUsingTable}" IsEnabled="false" Margin="1,0,1,0" />
                    <Button  Grid.Column="2" Click="{s:MethodBinding BatchProcessUsingFragmentsAction}" Content="{loc:Loc MountAnim.BatchSaveUsingFragments}" IsEnabled="{Binding CanBatchProcess.Value, UpdateSourceTrigger=PropertyChanged}" Margin="1,0,0,0"/>
                </Grid>

                <Grid Grid.Row="5" Margin="10,5,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SaveLabel" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource AeForm.Label}" Grid.Column="0" Content="{loc:Loc MountAnim.SavePrefix}"/>
                    <TextBox Grid.Column="1" Margin="0,0,8,0" VerticalContentAlignment="Center" Text="{Binding SavePrefixText.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    <Label Style="{StaticResource AeForm.Label}" Grid.Column="2" Content="{loc:Loc MountAnim.AnimVersion}"/>
                    <ComboBox Grid.Column="3" HorizontalAlignment="Right" ItemsSource="{Binding AnimationOutputFormats}" SelectedItem="{Binding SelectedAnimationOutputFormat.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    <Label Style="{StaticResource AeForm.Label}" Grid.Column="4" Content="{loc:Loc MountAnim.EnsureUnique}"/>
                    <CheckBox Grid.Column="5" HorizontalAlignment="Right" VerticalContentAlignment="Center" IsChecked="{Binding EnsureUniqeFileName.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Expander>
</UserControl>
