<UserControl x:Class="Editors.AnimationMeta.SuperView.SuperViewWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Editors.AnimationMeta.SuperView"
             xmlns:inspection="clr-namespace:Editors.AnimationMeta.SuperView.Inspection"
             xmlns:reference="clr-namespace:AnimationEditor.Common.ReferenceModel;assembly=Editors.Shared.Core"
             xmlns:player="clr-namespace:AnimationEditor.Common.AnimationPlayer;assembly=Editors.Shared.Core"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             Background="{DynamicResource AeBrush.Canvas}"
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/GridSplitterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LeftColumnWidth, Mode=TwoWay}" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding RightColumnWidth, Mode=TwoWay}" MinWidth="460" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="PreviewArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel x:Name="SceneToolbar" Background="{DynamicResource AeBrush.Surface1}">
                <Menu Style="{StaticResource AeMenu.Bar}">
                    <MenuItem Header="{loc:Loc EditorHost.Menu.Camera}">
                        <MenuItem Header="{loc:Loc EditorHost.Menu.FocusSelection}" Command="{Binding FocusCameraCommand}" />
                        <MenuItem Header="{loc:Loc EditorHost.Menu.Reset}" Command="{Binding ResetCameraCommand}" />
                    </MenuItem>
                    <MenuItem Header="{loc:Loc FactionTint.Menu}" Command="{Binding OpenFactionColourSettingsCommand}" />
                </Menu>
            </WrapPanel>
            <ContentControl x:Name="Viewport" Grid.Row="1" Content="{Binding GameWorld}" />
            <player:AnimationPlayerView x:Name="Playback" Grid.Row="2" DataContext="{Binding Player}" />
        </Grid>
        <GridSplitter Grid.Column="1" Style="{StaticResource AeVerticalGridSplitterStyle}" />
        <TabControl x:Name="InspectorCategories" Grid.Column="2"
                    SelectedIndex="{Binding SelectedInspectorTabIndex, Mode=TwoWay}"
                    ItemContainerStyle="{StaticResource AeTab.Item}"
                    Background="{DynamicResource AeBrush.Surface1}"
                    BorderThickness="0" Padding="0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="{loc:Loc SuperView.Workspace.Resources}">
                <ListView x:Name="ReferenceResources"
                          ItemsSource="{Binding SceneObjects}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="{loc:Loc SuperView.Workspace.Resources}"
                          Style="{StaticResource AeList.View}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AeList.Item}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <reference:SceneObjectView />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabItem>
            <TabItem Header="{loc:Loc SuperView.Workspace.Metadata}">
                <local:EditorView x:Name="MetadataPanel" />
            </TabItem>
            <TabItem Header="{loc:Loc SuperView.Workspace.Preview}">
                <ScrollViewer x:Name="PreviewSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc SuperView.Workspace.Markers}" Margin="0,0,0,8" />
                        <CheckBox Content="{loc:Loc SuperView.ShowImpactPos}" IsChecked="{Binding ShowImpactPositions, Mode=TwoWay}" Style="{StaticResource AeInput.CheckBox}" Margin="0,0,0,8" />
                        <CheckBox Content="{loc:Loc SuperView.ShowTargetPos}" IsChecked="{Binding ShowTargetPositions, Mode=TwoWay}" Style="{StaticResource AeInput.CheckBox}" Margin="0,0,0,8" />
                        <CheckBox Content="{loc:Loc SuperView.ShowFirePos}" IsChecked="{Binding ShowFirePositions, Mode=TwoWay}" Style="{StaticResource AeInput.CheckBox}" Margin="0,0,0,8" />
                        <CheckBox Content="{loc:Loc SuperView.ShowSplashAttack}" IsChecked="{Binding ShowSplashAttacks, Mode=TwoWay}" Style="{StaticResource AeInput.CheckBox}" />
                        <TextBlock Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc SuperView.PreviewWind}" Margin="0,16,0,8"
                                   Visibility="{Binding CanPreviewFlagWind, Converter={StaticResource B2VConverter}}" />
                        <Grid x:Name="FlagWindControls" ToolTip="{loc:Loc SuperView.PreviewWindHint}"
                              Visibility="{Binding CanPreviewFlagWind, Converter={StaticResource B2VConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="X" Style="{StaticResource AeForm.TextLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PreviewWindX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AeInput.TextBox}">
                                <b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" /></b:Interaction.Behaviors>
                            </TextBox>
                            <TextBlock Grid.Column="2" Text="Z" Style="{StaticResource AeForm.TextLabel}" Margin="12,0,8,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" Text="{Binding PreviewWindZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AeInput.TextBox}">
                                <b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" /></b:Interaction.Behaviors>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc SuperView.Workspace.Diagnostics}">
                <inspection:MetaDataProblemListView x:Name="DiagnosticsPanel" DataContext="{Binding MetaDataProblems}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
