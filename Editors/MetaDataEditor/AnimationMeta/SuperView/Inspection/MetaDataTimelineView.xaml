<UserControl x:Class="Editors.AnimationMeta.SuperView.Inspection.MetaDataTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspection="clr-namespace:Editors.AnimationMeta.SuperView.Inspection"
             xmlns:visualisation="clr-namespace:Editors.AnimationMeta.SuperView.Visualisation"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}"
             Foreground="{DynamicResource AeBrush.TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="TimelineMarkerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AeButton.Base}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AeBrush.SurfaceHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AeBrush.Surface2}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TimelineMarkerStyle" TargetType="Border">
            <Setter Property="Height" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AeBrush.TextSecondary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource AeRadius.Compact}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Item.PreviewCategory}"
                             Value="{x:Static visualisation:CombatMetaDataPreviewCategory.Impact}">
                    <Setter Property="Background" Value="{DynamicResource AeBrush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.PreviewCategory}"
                             Value="{x:Static visualisation:CombatMetaDataPreviewCategory.Target}">
                    <Setter Property="Background" Value="{DynamicResource AeBrush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.PreviewCategory}"
                             Value="{x:Static visualisation:CombatMetaDataPreviewCategory.Fire}">
                    <Setter Property="Background" Value="{DynamicResource AeBrush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.PreviewCategory}"
                             Value="{x:Static visualisation:CombatMetaDataPreviewCategory.Splash}">
                    <Setter Property="Background" Value="{x:Static inspection:MetaDataTimelineBrushes.Splash}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.TimelineMarkerKind}"
                             Value="{x:Static inspection:MetaDataTimelineMarkerKind.Instant}">
                    <Setter Property="Width" Value="2" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.TimelineMarkerKind}"
                             Value="{x:Static inspection:MetaDataTimelineMarkerKind.Range}">
                    <Setter Property="Height" Value="5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.TimelineMarkerKind}"
                             Value="{x:Static inspection:MetaDataTimelineMarkerKind.WholeAnimation}">
                    <Setter Property="CornerRadius" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Height" Value="9" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.TextPrimary}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Item.TimelineMarkerKind}"
                                   Value="{x:Static inspection:MetaDataTimelineMarkerKind.Instant}" />
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Width" Value="5" />
                    <Setter Property="Height" Value="14" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Height="18"
                Background="{DynamicResource AeBrush.Surface1}"
                BorderBrush="{DynamicResource AeBrush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource AeRadius.Compact}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMarkers}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ItemsControl ItemsSource="{Binding Markers}"
                          HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <inspection:MetaDataTimelinePanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding SelectCommand}"
                                Style="{StaticResource TimelineMarkerButtonStyle}"
                                ToolTip="{Binding ToolTipText}"
                                AutomationProperties.Name="{Binding AutomationName}">
                            <Border x:Name="Marker"
                                    Style="{StaticResource TimelineMarkerStyle}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AeBrush.TextMuted}"
                   Text="{Binding EmptyStateText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource AeText.Caption}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMarkers}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
