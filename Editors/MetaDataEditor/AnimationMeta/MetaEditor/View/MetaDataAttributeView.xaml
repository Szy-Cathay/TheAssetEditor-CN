<UserControl x:Class="Editors.AnimationMeta.Presentation.View.MetaDataAttributeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tags="clr-namespace:Editors.AnimationMeta.Presentation"
             xmlns:superview="clr-namespace:Editors.AnimationMeta.SuperView"
             xmlns:mathviews="clr-namespace:CommonControls.MathViews;assembly=Shared.Ui"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Border
        Margin="4"
        Padding="8"
        Style="{StaticResource AeSurface.Panel}">
        <Grid MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource AeText.Body}"
                    Text="{Binding SelectedTag.Description, UpdateSourceTrigger=PropertyChanged}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTip="{Binding SelectedTag.Description}" />
                <StackPanel x:Name="SuperViewBatchControls"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding DataContext.IsAnimationMetaTabSelected, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                    Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <CheckBox
                        Margin="0,0,12,0"
                        Content="{loc:Loc SuperView.Batch.ShowAll}"
                        IsChecked="{Binding DataContext.ShowAllAnimationMetaPreviews, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding DataContext.CanToggleAnimationMetaPreviewVisibility, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                        Style="{StaticResource AeInput.CheckBox}"
                        ToolTip="{loc:Loc SuperView.Batch.ShowAllTip}" />
                    <CheckBox
                        Margin="0,0,12,0"
                        Content="{loc:Loc SuperView.Batch.FullTime}"
                        IsChecked="{Binding DataContext.ShowAllAnimationMetaForEntireAnimation, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding DataContext.CanToggleAnimationMetaDisplayTime, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                        Style="{StaticResource AeInput.CheckBox}"
                        ToolTip="{loc:Loc SuperView.Batch.FullTimeTip}" />
                    <CheckBox
                        Content="{loc:Loc SuperView.Batch.Edit3D}"
                        IsChecked="{Binding DataContext.EnableAllAnimationMeta3D, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding DataContext.CanToggleAnimationMeta3D, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                        Style="{StaticResource AeInput.CheckBox}"
                        ToolTip="{loc:Loc SuperView.Batch.Edit3DTip}" />
                </StackPanel>
            </Grid>

            <Border x:Name="SuperViewSelectedMetaDataControls"
                Grid.Row="1"
                Margin="0,0,0,8"
                Padding="0,8"
                BorderBrush="{DynamicResource AeBrush.Border}"
                BorderThickness="0,1,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding DataContext.HasSelectedSceneMarkerSettings, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock
                        Style="{StaticResource AeText.Label}"
                        Text="{loc:Loc SuperView.PreviewVisibility}" />
                    <DockPanel Margin="0,6,0,0" LastChildFill="True">
                        <Button
                            Margin="8,0,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding DataContext.FocusSelectedMetaDataActionCommand, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                            Content="{loc:Loc SuperView.FocusSelectedMeta}"
                            DockPanel.Dock="Right"
                            IsEnabled="{Binding DataContext.CanFocusSelectedMetaData, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                            Style="{StaticResource AeButton.Secondary}"
                            Visibility="{Binding DataContext.CanFocusSelectedMetaData, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Converter={StaticResource BoolToCollapsedConverter}}" />
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox
                                Margin="0,0,12,0"
                                Content="{loc:Loc SuperView.ShowImpactPos}"
                                IsChecked="{Binding DataContext.ShowImpactPositions, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource AeInput.CheckBox}"
                                Visibility="{Binding DataContext.IsImpactMetaDataSelected, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Converter={StaticResource BoolToCollapsedConverter}}" />
                            <CheckBox
                                Margin="0,0,12,0"
                                Content="{loc:Loc SuperView.ShowTargetPos}"
                                IsChecked="{Binding DataContext.ShowTargetPositions, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource AeInput.CheckBox}"
                                Visibility="{Binding DataContext.IsTargetMetaDataSelected, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Converter={StaticResource BoolToCollapsedConverter}}" />
                            <CheckBox
                                Margin="0,0,12,0"
                                Content="{loc:Loc SuperView.ShowFirePos}"
                                IsChecked="{Binding DataContext.ShowFirePositions, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource AeInput.CheckBox}"
                                Visibility="{Binding DataContext.IsFireMetaDataSelected, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Converter={StaticResource BoolToCollapsedConverter}}" />
                            <CheckBox
                                Margin="0,0,12,0"
                                Content="{loc:Loc SuperView.ShowSplashAttack}"
                                IsChecked="{Binding DataContext.ShowSplashAttacks, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource AeInput.CheckBox}"
                                Visibility="{Binding DataContext.IsSplashMetaDataSelected, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Converter={StaticResource BoolToCollapsedConverter}}" />
                            <TextBlock
                                Margin="8,0,8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource AeText.Label}"
                                Text="{loc:Loc SuperView.CombatDisplayMode.Label}"
                                ToolTip="{loc:Loc SuperView.CombatDisplayMode.ToolTip}"
                                Visibility="{Binding DataContext.CanConfigureSelectedMetaDataDisplayTime, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Converter={StaticResource BoolToCollapsedConverter}}" />
                            <RadioButton
                                Margin="0,0,12,0"
                                Content="{loc:Loc SuperView.CombatDisplayMode.ActiveTime}"
                                IsChecked="{Binding DataContext.ShowCombatMetaDataDuringActiveTime, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource AeInput.RadioButton}"
                                ToolTip="{loc:Loc SuperView.CombatDisplayMode.ToolTip}"
                                Visibility="{Binding DataContext.CanConfigureSelectedMetaDataDisplayTime, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Converter={StaticResource BoolToCollapsedConverter}}" />
                            <RadioButton
                                Content="{loc:Loc SuperView.CombatDisplayMode.EntireAnimation}"
                                IsChecked="{Binding DataContext.ShowCombatMetaDataForEntireAnimation, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource AeInput.RadioButton}"
                                ToolTip="{loc:Loc SuperView.CombatDisplayMode.ToolTip}"
                                Visibility="{Binding DataContext.CanConfigureSelectedMetaDataDisplayTime, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Converter={StaticResource BoolToCollapsedConverter}}" />
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <ListView
                Grid.Row="2"
                MinHeight="0"
                ItemsSource="{Binding SelectedTag.Variables, UpdateSourceTrigger=PropertyChanged}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Style="{StaticResource AeList.View}"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.Resources>
                    <DataTemplate DataType="{x:Type tags:BooleanAttributeViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Column="1"
                                Content="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource AeForm.Label}"
                                ToolTip="{Binding Description}" />
                            <CheckBox
                                Grid.Column="2"
                                Margin="0,3"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="{Binding Description}">
                                <CheckBox.Style>
                                    <Style
                                        TargetType="CheckBox"
                                        BasedOn="{StaticResource AeInput.CheckBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource AeBrush.Border}" />
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type tags:ChoiceAttributeViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <ContentControl
                                Grid.Column="0"
                                Margin="-4,0,0,0"
                                VerticalAlignment="Center"
                                Content="{materialIcons:MaterialIconExt Kind=Exclamation}"
                                Foreground="{DynamicResource AeBrush.Danger}"
                                Visibility="{Binding IsValid, Converter={StaticResource InvBoolToHiddenConverter}}" />
                            <Label
                                Grid.Column="1"
                                Content="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource AeForm.Label}"
                                ToolTip="{Binding Description}" />
                            <ComboBox
                                Grid.Column="2"
                                Margin="0,3"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Choices}"
                                SelectedValue="{Binding ValueAsString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="ValueAsString"
                                ToolTip="{Binding Description}">
                                <ComboBox.Style>
                                    <Style
                                        TargetType="ComboBox"
                                        BasedOn="{StaticResource AeInput.ComboBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource AeBrush.Border}" />
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type tags:AttributeViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <ContentControl
                                Grid.Column="0"
                                Margin="-4,0,0,0"
                                VerticalAlignment="Center"
                                Content="{materialIcons:MaterialIconExt Kind=Exclamation}"
                                Foreground="{DynamicResource AeBrush.Danger}"
                                Visibility="{Binding IsValid, Converter={StaticResource InvBoolToHiddenConverter}}" />
                            <Label
                                Grid.Column="1"
                                Content="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource AeForm.Label}"
                                ToolTip="{Binding Description}" />
                            <TextBox
                                Grid.Column="2"
                                Margin="0,3"
                                IsReadOnly="{Binding IsReadOnly}"
                                Style="{StaticResource AeInput.TextBox}"
                                Text="{Binding ValueAsString, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                ToolTip="{Binding Description}" />
                            <Button
                                Grid.Column="3"
                                Margin="8,3,0,3"
                                Command="{Binding DataContext.JumpToSelectedMetaDataStartActionCommand, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                Content="{loc:Loc SuperView.Time.JumpStart}"
                                ToolTip="{Binding DataContext.SelectedMetaDataStartToolTip, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}">
                                <Button.Style>
                                    <Style
                                        TargetType="Button"
                                        BasedOn="{StaticResource AeButton.Secondary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsStartTime}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.HasSelectedMetaDataTimeRange, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                Grid.Column="3"
                                Margin="8,3,0,3"
                                Command="{Binding DataContext.JumpToSelectedMetaDataEndActionCommand, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                Content="{loc:Loc SuperView.Time.JumpEnd}"
                                ToolTip="{loc:Loc SuperView.Time.JumpEndTip}">
                                <Button.Style>
                                    <Style
                                        TargetType="Button"
                                        BasedOn="{StaticResource AeButton.Secondary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEndTime}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.HasSelectedMetaDataTimeRange, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="4"
                                Background="{DynamicResource AeBrush.Border}" />
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type tags:VectorAttributeViewModel}">
                        <StackPanel>
                            <Border
                                Padding="0,3"
                                BorderBrush="{DynamicResource AeBrush.Border}"
                                BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCombatPositionAnchor}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.CanEditSelectedMetaData3D, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="1"
                                        ToolTip="{loc:Loc SuperView.Edit3D.ToolTip}">
                                        <Label.Style>
                                            <Style
                                                TargetType="Label"
                                                BasedOn="{StaticResource AeForm.Label}">
                                                <Setter Property="Content" Value="{loc:Loc SuperView.Edit3D.Title}" />
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding DataContext.CanRotateSelectedMetaData3D, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                                        Value="True">
                                                        <Setter Property="Content" Value="{loc:Loc SuperView.Edit3D.EffectTitle}" />
                                                        <Setter Property="ToolTip" Value="{loc:Loc SuperView.Edit3D.EffectToolTip}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <ToggleButton
                                                IsChecked="{Binding DataContext.IsCombatMetaData3dEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource AeInput.Switch}"
                                                ToolTip="{loc:Loc SuperView.Edit3D.ToolTip}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style
                                                        TargetType="TextBlock"
                                                        BasedOn="{StaticResource AeText.Caption}">
                                                        <Setter Property="Text" Value="{loc:Loc SuperView.Edit3D.Disabled}" />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding DataContext.IsCombatMetaData3dEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                                                Value="True">
                                                                <Setter Property="Text" Value="{loc:Loc SuperView.Edit3D.Enabled}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding DataContext.IsCombatMetaData3dEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                            Orientation="Horizontal"
                                            Visibility="{Binding DataContext.CanRotateSelectedMetaData3D, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Converter={StaticResource BoolToCollapsedConverter}}">
                                            <TextBlock
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource AeText.Caption}"
                                                Text="{loc:Loc SuperView.Edit3D.Mode}" />
                                            <RadioButton
                                                Margin="0,0,6,0"
                                                Content="{loc:Loc SuperView.Edit3D.Move}"
                                                IsChecked="{Binding DataContext.EditEffectPosition, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource AeInput.RadioButton}"
                                                ToolTip="{loc:Loc SuperView.Edit3D.MoveTip}" />
                                            <RadioButton
                                                Content="{loc:Loc SuperView.Edit3D.Rotate}"
                                                IsChecked="{Binding DataContext.EditEffectOrientation, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource AeInput.RadioButton}"
                                                ToolTip="{loc:Loc SuperView.Edit3D.RotateTip}" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding DataContext.IsCombatMetaData3dEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                            Orientation="Horizontal"
                                            Visibility="{Binding DataContext.IsSplashMetaDataSelected, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Converter={StaticResource BoolToCollapsedConverter}}">
                                            <TextBlock
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource AeText.Caption}"
                                                Text="{loc:Loc SuperView.Edit3D.Point}" />
                                            <RadioButton
                                                Margin="0,0,6,0"
                                                Content="{loc:Loc SuperView.Edit3D.SplashStart}"
                                                IsChecked="{Binding DataContext.EditSplashStart, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource AeInput.RadioButton}"
                                                ToolTip="{loc:Loc SuperView.Edit3D.SplashStartTip}" />
                                            <RadioButton
                                                Content="{loc:Loc SuperView.Edit3D.SplashEnd}"
                                                IsChecked="{Binding DataContext.EditSplashEnd, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource AeInput.RadioButton}"
                                                ToolTip="{loc:Loc SuperView.Edit3D.SplashEndTip}" />
                                        </StackPanel>
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Button
                                                MinWidth="0"
                                                Margin="0,0,2,0"
                                                Padding="6,0"
                                                Command="{Binding DataContext.UndoCombatMetaDataActionCommand, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                                Content="{loc:Loc SuperView.Edit3D.UndoShort}"
                                                IsEnabled="{Binding DataContext.CanUndoCombatMetaData, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                                Style="{StaticResource AeButton.Quiet}"
                                                ToolTip="{loc:Loc SuperView.Edit3D.UndoTip}" />
                                            <Button
                                                MinWidth="0"
                                                Padding="6,0"
                                                Command="{Binding DataContext.RedoCombatMetaDataActionCommand, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                                Content="{loc:Loc SuperView.Edit3D.RedoShort}"
                                                IsEnabled="{Binding DataContext.CanRedoCombatMetaData, RelativeSource={RelativeSource AncestorType={x:Type superview:EditorView}}}"
                                                Style="{StaticResource AeButton.Quiet}"
                                                ToolTip="{loc:Loc SuperView.Edit3D.RedoTip}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <ContentControl
                                    Grid.Column="0"
                                    Margin="-4,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{materialIcons:MaterialIconExt Kind=Exclamation}"
                                    Foreground="{DynamicResource AeBrush.Danger}"
                                    Visibility="{Binding IsValid, Converter={StaticResource InvBoolToHiddenConverter}}" />
                                <Label
                                    Grid.Column="1"
                                    Content="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource AeForm.Label}"
                                    ToolTip="{Binding Description}" />
                                <mathviews:Vector3View
                                    Grid.Column="2"
                                    MinWidth="300"
                                    Margin="0,3"
                                    HorizontalAlignment="Left"
                                    ToolTip="{Binding Description}"
                                    VerticalContentAlignment="Center"
                                    Vector3="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                <Border
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Background="{DynamicResource AeBrush.Border}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type tags:OrientationAttributeViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <ContentControl
                                Grid.Column="0"
                                Margin="-4,0,0,0"
                                VerticalAlignment="Center"
                                Content="{materialIcons:MaterialIconExt Kind=Exclamation}"
                                Foreground="{DynamicResource AeBrush.Danger}"
                                Visibility="{Binding IsValid, Converter={StaticResource InvBoolToHiddenConverter}}" />
                            <Label
                                Grid.Column="1"
                                Content="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource AeForm.Label}"
                                ToolTip="{Binding Description}" />
                            <mathviews:Vector3View
                                Grid.Column="2"
                                MinWidth="300"
                                Margin="0,3"
                                HorizontalAlignment="Left"
                                ToolTip="{Binding Description}"
                                VerticalContentAlignment="Center"
                                Vector3="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource AeBrush.Border}" />
                        </Grid>
                    </DataTemplate>
                </ListView.Resources>
            </ListView>
        </Grid>
    </Border>
</UserControl>
