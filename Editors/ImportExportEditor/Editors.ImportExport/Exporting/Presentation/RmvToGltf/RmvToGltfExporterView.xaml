<UserControl
    x:Class="Editors.ImportExport.Exporting.Presentation.RmvToGltf.RmvToGltfExporterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,16,8" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfExporter.ExportTextures}" />
        <CheckBox
            Grid.Column="1"
            Margin="0,0,0,8"
            IsChecked="{Binding ExportTextures, Mode=TwoWay}"
            Style="{StaticResource AeInput.CheckBox}" />

        <TextBlock
            Grid.Row="1"
            Margin="18,0,16,8"
            VerticalAlignment="Center"
            Foreground="{DynamicResource AeBrush.TextSecondary}"
            Text="{loc:Loc RmvToGltfExporter.ConvertMaterial}" />
        <CheckBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,8"
            IsChecked="{Binding ConvertMaterialTextureToBlender, Mode=TwoWay}"
            IsEnabled="{Binding ExportTextures}"
            Style="{StaticResource AeInput.CheckBox}"
            ToolTip="{loc:Loc RmvToGltfExporter.ToolTip.ConvertMaterial}" />

        <TextBlock
            Grid.Row="2"
            Margin="18,0,16,12"
            VerticalAlignment="Center"
            Foreground="{DynamicResource AeBrush.TextSecondary}"
            Text="{loc:Loc RmvToGltfExporter.ConvertNormal}" />
        <CheckBox
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,0,12"
            IsChecked="{Binding ConvertNormalTextureToBlue, Mode=TwoWay}"
            IsEnabled="{Binding ExportTextures}"
            Style="{StaticResource AeInput.CheckBox}"
            ToolTip="{loc:Loc RmvToGltfExporter.ToolTip.ConvertNormal}" />

        <TextBlock Grid.Row="3" Margin="0,0,16,8" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfExporter.ExportSkeleton}" />
        <CheckBox
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,0,0,8"
            IsChecked="{Binding ExportSkeleton, Mode=TwoWay}"
            IsEnabled="{Binding HasSkeleton}"
            Style="{StaticResource AeInput.CheckBox}"
            ToolTip="{loc:Loc RmvToGltfExporter.ToolTip.ExportSkeleton}" />

        <TextBlock Grid.Row="4" Margin="0,0,16,8" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfExporter.ExportAnimations}" />
        <CheckBox
            Grid.Row="4"
            Grid.Column="1"
            Margin="0,0,0,8"
            IsChecked="{Binding ExportAnimations, Mode=TwoWay}"
            IsEnabled="{Binding CanExportAnimations}"
            Style="{StaticResource AeInput.CheckBox}"
            ToolTip="{loc:Loc RmvToGltfExporter.ToolTip.ExportAnimations}" />

        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="18,0,0,0" IsEnabled="{Binding CanExportAnimations}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.ColumnSpan="2"
                Margin="0,0,0,4"
                Style="{StaticResource AeText.Caption}"
                Text="{loc:Loc RmvToGltfExporter.CompatibleAnimations}" />
            <ComboBox
                Grid.Row="1"
                AutomationProperties.Name="{loc:Loc RmvToGltfExporter.CompatibleAnimations}"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding AvailableAnimations}"
                SelectedItem="{Binding SelectedAvailableAnimation, Mode=TwoWay}"
                Style="{StaticResource AeInput.ComboBox}" />
            <Button
                Grid.Row="1"
                Grid.Column="1"
                Margin="8,0,0,0"
                Command="{Binding AddAnimationCommand}"
                Content="{loc:Loc RmvToGltfExporter.AddAnimation}"
                IsEnabled="{Binding CanAddAnimation}"
                Style="{StaticResource AeButton.Secondary}" />
            <Button
                Grid.Row="1"
                Grid.Column="2"
                Margin="8,0,0,0"
                Command="{Binding RemoveAnimationCommand}"
                Content="{loc:Loc RmvToGltfExporter.RemoveAnimation}"
                IsEnabled="{Binding CanRemoveAnimation}"
                Style="{StaticResource AeButton.Quiet}" />

            <TextBlock
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Margin="0,8,0,4"
                Style="{StaticResource AeText.Caption}"
                Text="{loc:Loc RmvToGltfExporter.AnimationFiles}" />
            <Border
                Grid.Row="3"
                Grid.ColumnSpan="3"
                Padding="4"
                Style="{StaticResource AeSurface.Control}">
                <ListBox
                    Height="64"
                    ItemsSource="{Binding AnimationFiles}"
                    SelectedItem="{Binding SelectedAnimation, Mode=TwoWay}"
                    Style="{StaticResource AeList.View}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Style="{StaticResource AeText.Technical}"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding DisplayName}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="6"
            Grid.ColumnSpan="2"
            Margin="0,12,0,0"
            Style="{StaticResource AeText.Caption}"
            Foreground="{DynamicResource AeBrush.TextMuted}"
            Text="{loc:Loc RmvToGltfExporter.LodHint}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
