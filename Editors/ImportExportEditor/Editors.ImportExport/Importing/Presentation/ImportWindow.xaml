<windowHandling:AssetEditorWindow
    x:Class="Editors.ImportExport.Importing.Presentation.ImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui"
    xmlns:windowHandling="clr-namespace:WindowHandling;assembly=Shared.Ui"
    Title="{loc:Loc ImportWindow.Title}"
    Width="720"
    MaxHeight="760"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <windowHandling:AssetEditorWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </windowHandling:AssetEditorWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,12,10"
                Style="{StaticResource AeForm.TextLabel}"
                Text="{loc:Loc ImportWindow.SelectedFile}" />
            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,10"
                IsReadOnly="True"
                Text="{Binding SystemPath}" />

            <TextBlock
                Grid.Row="1"
                Margin="0,0,12,0"
                Style="{StaticResource AeForm.TextLabel}"
                Text="{loc:Loc ImportWindow.AvailableImporters}" />
            <ComboBox
                Grid.Row="1"
                Grid.Column="1"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding PossibleImporters}"
                SelectedItem="{Binding SelectedImporter, Mode=TwoWay}" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="12"
            Background="{DynamicResource AeBrush.Surface}"
            BorderBrush="{DynamicResource AeBrush.Border}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,10"
                    FontWeight="SemiBold"
                    Text="{loc:Loc ImportWindow.ImporterSettings}" />
                <ContentControl
                    Content="{Binding SelectedImporter}"
                    ContentTemplateSelector="{StaticResource ViewTemplateDataSelector}" />
            </StackPanel>
        </Border>

        <TextBlock
            Grid.Row="2"
            Margin="0,10,0,0"
            Foreground="{DynamicResource AeBrush.TextMuted}"
            Text="{loc:Loc ImportWindow.GltfHint}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="3"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                Content="{loc:Loc General.Cancel}"
                IsCancel="True" />
            <Button
                x:Name="ImportButton"
                Click="ImportButton_Click"
                Content="{loc:Loc General.Import}"
                IsDefault="True"
                Style="{StaticResource AeButton.Primary}" />
        </StackPanel>

        <progress:OperationProgressWindowHost
            Grid.RowSpan="4"
            IsOperationActive="{Binding IsOperationActive}"
            IsProgressIndeterminate="True"
            StatusText="{loc:Loc ImportWindow.ProgressStatus}"
            WindowTitle="{loc:Loc ImportWindow.ProgressTitle}" />
    </Grid>
</windowHandling:AssetEditorWindow>
