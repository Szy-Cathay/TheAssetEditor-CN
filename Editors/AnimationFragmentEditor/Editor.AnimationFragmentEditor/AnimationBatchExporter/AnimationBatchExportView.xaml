<UserControl x:Class="CommonControls.Editors.AnimationBatchExporter.AnimationBatchExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui"
             xmlns:s="http://schemas.singulink.com/xaml"
             Background="{DynamicResource AeBrush.Canvas}"
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}"
             Loaded="ViewLoaded" Unloaded="ViewUnloaded" DataContextChanged="ViewDataContextChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="ToolTip" BasedOn="{StaticResource AeToolTip}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="360" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid IsEnabled="{Binding IsBusy.Value, Converter={StaticResource InvBoolConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="{loc:Loc AnimBatchExport.Refresh}"
                            Style="{DynamicResource AeButton.Quiet}" Click="{s:MethodBinding RefreshSources}"
                            ToolTip="{loc:Loc AnimBatchExport.RefreshHelp}" />
                    <TextBlock Text="{loc:Loc AnimBatchExport.Sources}" Style="{DynamicResource AeText.SectionTitle}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="SourcesList" Grid.Row="1" ItemsSource="{Binding PackfileList}"
                         Style="{DynamicResource AeList.View}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Process.Value, Mode=TwoWay}" HorizontalContentAlignment="Stretch"
                                      Style="{DynamicResource AeInput.CheckBox}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding Details}" Style="{DynamicResource AeText.Caption}"
                                               Foreground="{DynamicResource AeBrush.TextMuted}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Loc AnimBatchExport.Animations}" Style="{DynamicResource AeText.SectionTitle}" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Text="{Binding FilterText.Value, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         Style="{DynamicResource AeInput.TextBox}"
                         behaviors:TextBoxExtensions.Watermark="{loc:Loc AnimBatchExport.Search}"
                         AutomationProperties.Name="{loc:Loc AnimBatchExport.Search}" />
                <StackPanel Grid.Row="2" Margin="0,4,0,4">
                    <WrapPanel>
                        <Button Content="{loc:Loc AnimBatchExport.SelectFiltered}" Style="{DynamicResource AeButton.Quiet}"
                                Click="{s:MethodBinding SelectFiltered}" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc AnimBatchExport.ClearSelection}" Style="{DynamicResource AeButton.Quiet}"
                                Click="{s:MethodBinding ClearSelection}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SelectionSummary.Value}" Style="{DynamicResource AeText.Caption}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <ListBox x:Name="AnimationsList" Grid.Row="3" ItemsSource="{Binding FilteredAnimations.Value}"
                         Style="{DynamicResource AeList.View}"
                         ToolTip="{loc:Loc AnimBatchExport.SelectionTip}"
                         PreviewMouseLeftButtonDown="AnimationMouseDown" PreviewMouseMove="AnimationMouseMove"
                         PreviewMouseLeftButtonUp="AnimationMouseUp" MouseLeave="AnimationMouseLeave"
                         LostMouseCapture="AnimationLostMouseCapture" PreviewKeyDown="AnimationKeyDown"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource AeList.Item}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextSecondary}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected.Value, Mode=TwoWay}" HorizontalContentAlignment="Stretch"
                                      Style="{DynamicResource AeInput.CheckBox}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"
                                               Style="{DynamicResource AeText.Technical}" />
                                    <TextBlock Text="{Binding SourceName}" Style="{DynamicResource AeText.Caption}"
                                               Foreground="{DynamicResource AeBrush.TextMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" Text="{Binding EmptyMessage.Value}" TextWrapping="Wrap"
                           Margin="8,16" Style="{DynamicResource AeText.Caption}" IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty.Value, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <WrapPanel>
                <TextBlock Text="{loc:Loc AnimBatchExport.OutputFormat}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="OutputFormat" Width="80" ItemsSource="{Binding PossibleOutputFormats}"
                          SelectedValuePath="Version" SelectedValue="{Binding SelectedOutputFormat.Value}"
                          DisplayMemberPath="Version" ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}"
                          Style="{DynamicResource AeInput.ComboBox}" Margin="0,0,16,0"
                          IsEnabled="{Binding IsBusy.Value, Converter={StaticResource InvBoolConverter}}"
                          AutomationProperties.Name="{loc:Loc AnimBatchExport.OutputFormat}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource AeInput.ComboBoxItem}">
                            <Setter Property="ToolTip" Value="{Binding Description}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button x:Name="ExportButton" Content="{Binding ExportButtonText.Value}" IsEnabled="{Binding CanExport.Value}"
                        Style="{DynamicResource AeButton.Secondary}" Click="ExportClicked" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Text="{Binding Status.Value}" TextWrapping="Wrap" Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource AeText.Caption}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.Value}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <progress:OperationProgressWindowHost x:Name="ProgressHost" WindowTitle="{loc:Loc DisplayName.AnimationBatchExporter}"
                  IsOperationActive="{Binding IsBusy.Value}" StatusText="{Binding Status.Value}"
                  CurrentDetailText="{Binding CurrentFile.Value}" ProgressValue="{Binding CompletedCount.Value}"
                  ProgressMaximum="{Binding TotalCount.Value}" IsProgressIndeterminate="False" />
    </Grid>
</UserControl>
