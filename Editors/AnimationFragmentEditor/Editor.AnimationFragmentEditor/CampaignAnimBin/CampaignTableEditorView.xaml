<UserControl x:Class="Editors.AnimationFragmentEditor.CampaignAnimBin.CampaignTableEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:converters="clr-namespace:Editors.AnimationFragmentEditor.AnimationPack.Converters"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             Background="{DynamicResource AeBrush.Canvas}" Foreground="{DynamicResource AeBrush.TextPrimary}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/GridSplitterStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <converters:ResourceNameConverter x:Key="ResourceName"/>
            <converters:CampaignStateNameConverter x:Key="StateName"/>
            <DataTemplate x:Key="CampaignTextField">
                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}">
                    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource AeInput.TextBox}"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AeBrush.Danger}"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                </TextBox>
            </DataTemplate>
            <DataTemplate x:Key="CampaignStateField">
                <ComboBox ItemsSource="{Binding StateOptions}" SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource StateName}}" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </DataTemplate>
            <DataTemplate x:Key="CampaignBooleanField">
                <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="160" MinWidth="120"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Loc AnimPack.Campaign.Reference}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding Reference, Mode=OneWay}" IsReadOnly="True" Margin="0,0,16,0" ToolTip="{loc:Loc AnimPack.NameReadonlyTip}"/>
            <TextBlock Grid.Column="2" Text="{loc:Loc AnimPack.Table.Skeleton}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="3" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding SkeletonNames}" Text="{Binding SkeletonName, UpdateSourceTrigger=LostFocus}" ToolTip="{loc:Loc AnimPack.SkeletonTip}"/>
        </Grid>
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
            <Button Command="{Binding SaveCommand}" Content="{Binding SaveButtonText}" Style="{StaticResource AeButton.Primary}" Margin="0,0,4,4"/>
            <Button Command="{Binding UndoCommand}" Content="{loc:Loc General.Undo}" Style="{StaticResource AeButton.Quiet}" Margin="0,0,4,4"/>
            <Button Command="{Binding RedoCommand}" Content="{loc:Loc General.Redo}" Style="{StaticResource AeButton.Quiet}" Margin="0,0,4,4"/>
            <Button Command="{Binding ValidateCommand}" Content="{loc:Loc AnimPack.Check}" Style="{StaticResource AeButton.Secondary}" Margin="0,0,4,4"/>
            <Button Command="{Binding PreviewAnimationCommand}" Content="{loc:Loc AnimPack.Preview.Title}" Style="{StaticResource AeButton.Secondary}" Margin="0,0,4,4"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{loc:Loc AnimPack.Campaign.State}" Style="{StaticResource AeText.SectionTitle}" Margin="0,0,0,8"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" Style="{StaticResource AeList.View}">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name, Converter={StaticResource StateName}}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Margin="0,8,0,4">
                <Button Command="{Binding AddStateCommand}" Content="{loc:Loc General.New}" Style="{StaticResource AeButton.Secondary}" Margin="0,0,4,4"/>
                <Button Command="{Binding RenameStateCommand}" Content="{loc:Loc General.Rename}" Style="{StaticResource AeButton.Quiet}" Margin="0,0,4,4"/>
                <Button Command="{Binding DeleteStateCommand}" Content="{loc:Loc General.Delete}" Style="{StaticResource AeButton.Danger}" Margin="0,0,4,4"/>
            </WrapPanel>
            <StackPanel Grid.Row="3" Margin="0,4,0,0">
                <TextBlock Text="{loc:Loc AnimPack.Campaign.Category}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label"/>
                <TextBlock Text="{loc:Loc AnimPack.Campaign.StateHelp}" Style="{StaticResource AeText.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
        <GridSplitter Grid.Row="2" Grid.Column="1" Style="{StaticResource AeVerticalGridSplitterStyle}"/>
        <Grid Grid.Row="2" Grid.Column="2" Margin="8,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,4">
                <TextBox Width="220" Margin="0,0,8,4" Text="{Binding RowFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc AnimPack.RowSearchTip}" behaviors:TextBoxExtensions.Watermark="{loc:Loc AnimPack.RowSearchPlaceholder}"/>
                <Button Command="{Binding AddEntryCommand}" Content="{loc:Loc General.New}" Style="{StaticResource AeButton.Secondary}" Margin="0,0,4,4"/>
                <Button Command="{Binding DuplicateEntryCommand}" Content="{loc:Loc General.Duplicate}" Style="{StaticResource AeButton.Quiet}" Margin="0,0,4,4"/>
                <Button Command="{Binding DeleteEntryCommand}" Content="{loc:Loc General.Delete}" Style="{StaticResource AeButton.Danger}" Margin="0,0,0,4"/>
            </WrapPanel>
            <Expander Grid.Row="1" Header="{loc:Loc AnimPack.BatchReplace}" Margin="0,0,0,8">
                <WrapPanel Margin="0,8,0,0">
                    <TextBox Width="160" Text="{Binding ReplaceFrom, UpdateSourceTrigger=LostFocus}" ToolTip="{loc:Loc AnimPack.ReplaceFrom}" behaviors:TextBoxExtensions.Watermark="{loc:Loc AnimPack.ReplaceFrom}" Margin="0,0,8,4"/>
                    <TextBox Width="160" Text="{Binding ReplaceTo, UpdateSourceTrigger=LostFocus}" ToolTip="{loc:Loc AnimPack.ReplaceTo}" behaviors:TextBoxExtensions.Watermark="{loc:Loc AnimPack.ReplaceTo}" Margin="0,0,8,4"/>
                    <Button Command="{Binding ReplacePathsCommand}" Content="{loc:Loc AnimPack.BatchReplace}" ToolTip="{loc:Loc AnimPack.Campaign.ReplaceAll}" Style="{StaticResource AeButton.Secondary}"/>
                </WrapPanel>
            </Expander>
            <Grid Grid.Row="2">
            <DataGrid x:Name="EntriesGrid" ItemsSource="{Binding FilteredRows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource AeTable.Grid}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="EntriesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{loc:Loc AnimPack.Table.AnimationFile}" SortMemberPath="Animation" Width="2*" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock ToolTip="{Binding Animation}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource AeText.Body}">
                                            <Setter Property="Text" Value="{Binding Animation, Converter={StaticResource ResourceName}}"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding Animation}" Value=""><Setter Property="Text" Value="{loc:Loc AnimPack.AnimationNotSelected}"/><Setter Property="Foreground" Value="{DynamicResource AeBrush.TextMuted}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox IsEditable="True" IsTextSearchEnabled="False" Text="{Binding Animation, UpdateSourceTrigger=LostFocus}" Tag="Animation" Loaded="ResourcePicker_Loaded"><ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel></ComboBox></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Loc AnimPack.Campaign.Type}" Binding="{Binding Type, UpdateSourceTrigger=LostFocus}" Width="100">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource AeText.Body}"/></DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox" BasedOn="{StaticResource AeInput.TextBox}"><Setter Property="IsEnabled" Value="{Binding CanEditType}"/></Style></DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="{loc:Loc AnimPack.Table.MetaFile}" SortMemberPath="Meta" Width="*" MinWidth="140">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource AeText.Body}" Text="{Binding Meta, Converter={StaticResource ResourceName}}" ToolTip="{Binding Meta}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox IsEditable="True" IsTextSearchEnabled="False" Text="{Binding Meta, UpdateSourceTrigger=LostFocus}" Tag="Meta" Loaded="ResourcePicker_Loaded"><ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel></ComboBox></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc AnimPack.Table.SoundFile}" SortMemberPath="Sound" Width="*" MinWidth="140">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource AeText.Body}" Text="{Binding Sound, Converter={StaticResource ResourceName}}" ToolTip="{Binding Sound}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox IsEditable="True" IsTextSearchEnabled="False" Text="{Binding Sound, UpdateSourceTrigger=LostFocus}" Tag="Sound" Loaded="ResourcePicker_Loaded"><ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel></ComboBox></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Border IsHitTestVisible="False">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource AeEmptyState.Panel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FilteredRows.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AeEmptyState.Title}"><Setter Property="Text" Value="{loc:Loc AnimPack.Rows.FilterEmptyTitle}"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Text" Value="{loc:Loc AnimPack.Campaign.EmptyTitle}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <TextBlock TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AeEmptyState.Description}"><Setter Property="Text" Value="{loc:Loc AnimPack.Rows.FilterEmptyDescription}"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Text" Value="{loc:Loc AnimPack.Campaign.EmptyDescription}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
            </Border>
            </Grid>
            <Expander Grid.Row="3" Header="{loc:Loc AnimPack.Campaign.Parameters}" IsExpanded="True" Margin="0,8,0,0">
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding SelectedRow.Fields}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="220" Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        <ContentControl Grid.Column="1" Content="{Binding}" HorizontalContentAlignment="Stretch">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource CampaignTextField}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStateReference}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource CampaignStateField}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource CampaignBooleanField}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <Button Command="{Binding OpenAnimationCommand}" Content="{loc:Loc AnimPack.OpenAnimation}" Style="{StaticResource AeButton.Quiet}" Margin="0,0,4,0"/>
                            <Button Command="{Binding OpenMetaCommand}" Content="{loc:Loc AnimPack.OpenMeta}" Style="{StaticResource AeButton.Quiet}" Margin="0,0,4,0"/>
                            <Button Command="{Binding OpenSoundCommand}" Content="{loc:Loc AnimPack.OpenSound}" Style="{StaticResource AeButton.Quiet}"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
        </Grid>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding ValidationSummary}" Style="{StaticResource AeText.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
