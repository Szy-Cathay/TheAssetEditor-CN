<UserControl x:Class="CommonControls.Editors.AnimationPack.AnimationPackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:texteditor="clr-namespace:CommonControls.Editors.TextEditor;assembly=Editors.Shared.Core"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:local="clr-namespace:CommonControls.Editors.AnimationPack"
             xmlns:converters="clr-namespace:Editors.AnimationFragmentEditor.AnimationPack.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource AeBrush.Canvas}"
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".3*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- File Menu -->
        <DockPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="{loc:Loc AnimPack.FileMenu}">
                    <MenuItem Header="{loc:Loc General.Save}" Command="{Binding SaveActionCommand}"/>
                    <Separator/>
                    <MenuItem Header="{loc:Loc AnimPack.NewAnimSetWh3}"  Command="{Binding CreateEmptyWarhammer3AnimSetFileActionCommand}" />
                    <Separator/>
                    <MenuItem Header="{loc:Loc AnimPack.ExportAnimSlotsWh3}"  Command="{Binding ExportAnimationSlotsWh3ActionCommand}" />
                    <MenuItem Header="{loc:Loc AnimPack.ExportAnimSlotsWh2}"  Command="{Binding ExportAnimationSlotsWh2ActionCommand}" />
                </MenuItem>
                <MenuItem Header="{loc:Loc AnimPack.ViewMenu}">
                    <MenuItem Header="{loc:Loc AnimPack.TableView}" IsCheckable="True" IsChecked="{Binding IsTableView}"/>
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- Left side - file list and filter -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" 
                     Text="{Binding AnimationPackItems.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                     behaviors:TextBoxExtensions.Watermark="{loc:Loc AnimPack.Watermark}">
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource AeInput.TextBox}">
                        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface2}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AnimationPackItems.FilterValid, UpdateSourceTrigger=PropertyChanged}" Value="false">
                                <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.Danger}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <ListView Grid.Row="1" ItemsSource="{Binding AnimationPackItems.Values}" SelectedItem="{Binding AnimationPackItems.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnknownFile, UpdateSourceTrigger=PropertyChanged}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AeBrush.Danger}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUnknownFile, UpdateSourceTrigger=PropertyChanged}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextPrimary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc AnimPack.ContextMenuRename}" Command="{Binding RenameActionCommand}" />
                        <MenuItem Header="{loc:Loc AnimPack.ContextMenuRemove}" Command="{Binding RemoveActionCommand}"/>
                        <MenuItem Header="{loc:Loc AnimPack.ContextMenuCopyFullPath}" Command="{Binding CopyFullPathActionCommand}"/>
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding IsChanged.Value, Converter={StaticResource BoolToChangedPrefixStr}, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Margin="4,0,0,0" Grid.Column="1" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                
                
            </ListView>
        </Grid>

        <!-- Right side - dual view -->
        <Grid Grid.Row="1" Grid.Column="2">
            <!-- Table view (default) -->
            <local:AnimSetTableEditorView
                DataContext="{Binding TableEditorVM}"
                Visibility="{Binding DataContext.IsTableView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>

            <!-- XML text view (fallback) -->
            <texteditor:TextEditorView
                DataContext="{Binding SelectedItemViewModel, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding DataContext.IsTableView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}"/>
        </Grid>

    </Grid>
</UserControl>
