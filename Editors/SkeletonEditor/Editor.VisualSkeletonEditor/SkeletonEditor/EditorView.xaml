<UserControl x:Class="Editor.VisualSkeletonEditor.SkeletonEditor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:mathviews="clr-namespace:CommonControls.MathViews;assembly=Shared.Ui"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             Background="{DynamicResource AeBrush.Canvas}"
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}"
             d:DesignHeight="850" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AeButton.Secondary}" />
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource AeInput.TextBox}" />
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource AeInput.CheckBox}" />
        <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource AeTree.View}" />
        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource AeTree.Item}" />
        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextSecondary}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12">
        <TextBlock
            Margin="0,0,0,8"
            Style="{StaticResource AeText.SectionTitle}"
            Text="{loc:Loc SkeletonEditor.Header}" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource AeForm.Label}" Content="{loc:Loc SkeletonEditor.Skeleton}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,8,2" IsReadOnly="True" Text="{Binding SkeletonName, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Row="0" Grid.Column="2" Width="72" Margin="0,2,0,2" Content="{loc:Loc General.Load}" Click="{s:MethodBinding LoadSkeletonAction}"/>
            <ToggleButton
                Grid.Row="0"
                Grid.Column="3"
                Margin="2,2,0,2"
                AutomationProperties.Name="{loc:Loc General.ToggleVisibility}"
                IsChecked="{Binding ShowSkeleton, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Style="{StaticResource AeButton.VisibilityToggle}"
                ToolTip="{loc:Loc General.ToggleVisibility}" />

            <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource AeForm.Label}" Content="{loc:Loc SkeletonEditor.RefMesh}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,8,2" IsReadOnly="True" Text="{Binding RefMeshName, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Row="1" Grid.Column="2" Width="72" Margin="0,2,0,2" Content="{loc:Loc General.Load}" Click="{s:MethodBinding LoadRefMeshAction}"/>
            <ToggleButton
                Grid.Row="1"
                Grid.Column="3"
                Margin="2,2,0,2"
                AutomationProperties.Name="{loc:Loc General.ToggleVisibility}"
                IsChecked="{Binding ShowRefMesh, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Style="{StaticResource AeButton.VisibilityToggle}"
                ToolTip="{loc:Loc General.ToggleVisibility}" />
        </Grid>

        <Border Height="360" Padding="4" Style="{StaticResource AeSurface.Panel}">
            <TreeView ItemsSource="{Binding Bones, UpdateSourceTrigger=PropertyChanged}">
                <b:Interaction.Behaviors>
                    <behaviors:BindableSelectedItemBehavior SelectedItem="{Binding SelectedBone, Mode=TwoWay}" />
                </b:Interaction.Behaviors>

                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource AeTree.Item}">
                        <Setter Property="IsExpanded" Value="True" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Path=Children, UpdateSourceTrigger=PropertyChanged}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BoneName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text=" - "/>
                            <TextBlock Text="{Binding BoneIndex, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{loc:Loc General.New}"  Click="{s:MethodBinding CreateBoneAction}" Margin="0,0,2,0"/>
            <Button Grid.Column="1" Content="{loc:Loc General.Duplicate}"  Click="{s:MethodBinding DuplicateBoneAction}"  Margin="2,0,2,0"/>
            <Button Grid.Column="2" Content="{loc:Loc General.Copy}"  Click="{s:MethodBinding CopyBoneAction}" Margin="2,0,2,0"/>
            <Button Grid.Column="3" Content="{loc:Loc General.Paste}"  Click="{s:MethodBinding PasteBoneAction}" Margin="2,0,2,0"/>
            <Button Grid.Column="4" Content="{loc:Loc General.Delete}" Click="{s:MethodBinding DeleteBoneAction}" Margin="2,0,0,0" Style="{StaticResource AeButton.Danger}"/>
        </Grid>

        <Border Height="1" Margin="0,12,0,8" Background="{DynamicResource AeBrush.Border}"/>
        <TextBlock Margin="0,0,0,6" Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc AnimReTarget.Settings}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource AeForm.Label}" Content="{loc:Loc SkeletonEditor.SourceSkeleton}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" Text="{Binding SourceSkeletonName, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"/>

            <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource AeForm.Label}" Content="{loc:Loc SkeletonEditor.SelectedBoneScale}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" Text="{Binding BoneVisualScale, UpdateSourceTrigger=LostFocus, Mode=TwoWay}">
                <b:Interaction.Behaviors>
                    <behaviors:TextBoxInputBehavior InputMode="DecimalInput"/>
                </b:Interaction.Behaviors>
            </TextBox>

            <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource AeForm.Label}" Content="{loc:Loc SkeletonEditor.Focus}"/>
            <Button Grid.Row="2" Grid.Column="1" Width="140" Margin="0,2,0,2" HorizontalAlignment="Left" Content="{loc:Loc SkeletonEditor.FocusSelectedBone}" Click="{s:MethodBinding FocusSelectedBoneAction}"/>

            <Label Grid.Row="3" Grid.Column="0" Style="{StaticResource AeForm.Label}" Content="{loc:Loc SkeletonEditor.WorldTransforms}"/>
            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding ShowBonesAsWorldTransform, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>

            <Label Grid.Row="4" Grid.Column="0" Style="{StaticResource AeForm.Label}" Content="{loc:Loc SkeletonEditor.IsTechSkeleton}"/>
            <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding IsTechSkeleton, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
        </Grid>

        <Border Height="1" Margin="0,12,0,8" Background="{DynamicResource AeBrush.Border}"/>
        <TextBlock Margin="0,0,0,6" Style="{StaticResource AeText.SectionTitle}" Text="{loc:Loc SkeletonEditor.SelectedBone}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource AeForm.Label}" Content="{loc:Loc SkeletonEditor.Name}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" Text="{Binding SelectedBoneName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource AeForm.Label}" Content="{loc:Loc SkeletonEditor.Translation}"/>
            <mathviews:Vector3View Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" Vector3="{Binding SelectedBoneTranslationOffset, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource AeForm.Label}" Content="{loc:Loc SkeletonEditor.Rotation}"/>
            <mathviews:Vector3View Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" Vector3="{Binding SelectedBoneRotationOffset, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <Label Grid.Row="3" Grid.Column="0" Style="{StaticResource AeForm.Label}" Content="{loc:Loc SkeletonEditor.LengthScale}"/>
            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,2,8,2" Text="{Binding BoneScale, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"/>
                <Button Grid.Column="1" Width="72" Margin="0,2,0,2" Content="{loc:Loc SkeletonEditor.Bake}" Click="{s:MethodBinding BakeSkeletonAction}"/>
            </Grid>
        </Grid>

        <Button Width="120" Margin="0,12,0,0" HorizontalAlignment="Right" Content="{loc:Loc General.Save}" Click="{s:MethodBinding SaveSkeletonAction}" Style="{StaticResource AeButton.Primary}"/>
    </StackPanel>
    </ScrollViewer>
</UserControl>
