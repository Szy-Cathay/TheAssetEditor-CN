<UserControl x:Class="AnimationEditor.Common.AnimationPlayer.AnimationPlayerView"
             x:Name="PlayerRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnimationEditor.Common.AnimationPlayer"
             xmlns:basecontrol="clr-namespace:Editors.Shared.Core.Common.BaseControl"
              xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             d:DesignWidth="800"
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}">
    <UserControl.Resources>
        <ResourceDictionary>
            <basecontrol:HostTemplateSelector x:Key="TimelineAnnotationSelector" />
            <BooleanToVisibilityConverter x:Key="FrameInformationVisibility" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        Background="{DynamicResource AeBrush.Surface1}"
        BorderBrush="{DynamicResource AeBrush.Border}"
        BorderThickness="0,1,0,0">
        <Expander
            x:Name="AnimationPlayerExpander" Style="{StaticResource AeEditor.PlaybackExpander}"
            Padding="8,4"
            IsExpanded="{Binding IsEnabled.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
            Header="{loc:Loc SharedAnimPlayer.Title}"
            AutomationProperties.Name="{loc:Loc SharedAnimPlayer.Title}">
            <Grid Margin="0,4,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="PlaybackCommandRow"
                    HorizontalAlignment="Center"
                    Visibility="{Binding PlayerControlsVisibility.Value, Mode=OneWay}">
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Button
                            Click="{s:MethodBinding SetAnimationFirstFrame}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AeButton.Icon}">
                                    <Setter Property="AutomationProperties.Name" Value="{loc:Loc SharedAnimPlayer.FirstFrame}" />
                                    <Setter Property="ToolTip" Value="{loc:Loc SharedAnimPlayer.FirstFrame}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowFrameInformation, ElementName=PlayerRoot}" Value="False">
                                            <Setter Property="AutomationProperties.Name" Value="{loc:Loc SharedAnimPlayer.Start}" />
                                            <Setter Property="ToolTip" Value="{loc:Loc SharedAnimPlayer.Start}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Canvas Width="16" Height="16">
                                <Path Data="M 3,3 L 3,13 M 13,3 L 5,8 L 13,13 Z" Fill="{DynamicResource AeBrush.TextPrimary}" Stroke="{DynamicResource AeBrush.TextPrimary}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.5" />
                            </Canvas>
                        </Button>
                        <Button
                            Click="{s:MethodBinding SetAnimationPrivFrame}"
                            Visibility="{Binding ShowFrameInformation, ElementName=PlayerRoot, Converter={StaticResource FrameInformationVisibility}}"
                            AutomationProperties.Name="{loc:Loc SharedAnimPlayer.PreviousFrame}"
                            ToolTip="{loc:Loc SharedAnimPlayer.PreviousFrame}"
                            Style="{StaticResource AeButton.Icon}">
                            <Canvas Width="16" Height="16">
                                <Path Data="M 13,3 L 6,8 L 13,13 Z M 8,3 L 1,8 L 8,13 Z" Fill="{DynamicResource AeBrush.TextPrimary}" />
                            </Canvas>
                        </Button>
                        <ToggleButton
                            Click="{s:MethodBinding ToggleAnimationPausePlay}"
                            IsChecked="{Binding IsPlaying.Value, Mode=OneWay}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource AeEditor.PlaybackToggle}">
                                    <Setter Property="AutomationProperties.Name" Value="{loc:Loc SharedAnimPlayer.Play}" />
                                    <Setter Property="ToolTip" Value="{loc:Loc SharedAnimPlayer.Play}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying.Value}" Value="True">
                                            <Setter Property="AutomationProperties.Name" Value="{loc:Loc SharedAnimPlayer.Pause}" />
                                            <Setter Property="ToolTip" Value="{loc:Loc SharedAnimPlayer.Pause}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <Canvas Width="16" Height="16">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M 4,2 L 14,8 L 4,14 Z" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying.Value}" Value="True">
                                                    <Setter Property="Data" Value="M 3,2 L 7,2 L 7,14 L 3,14 Z M 10,2 L 14,2 L 14,14 L 10,14 Z" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Canvas>
                        </ToggleButton>
                        <Button
                            Click="{s:MethodBinding SetAnimationNextFrame}"
                            Visibility="{Binding ShowFrameInformation, ElementName=PlayerRoot, Converter={StaticResource FrameInformationVisibility}}"
                            AutomationProperties.Name="{loc:Loc SharedAnimPlayer.NextFrame}"
                            ToolTip="{loc:Loc SharedAnimPlayer.NextFrame}"
                            Style="{StaticResource AeButton.Icon}">
                            <Canvas Width="16" Height="16">
                                <Path Data="M 3,3 L 10,8 L 3,13 Z M 8,3 L 15,8 L 8,13 Z" Fill="{DynamicResource AeBrush.TextPrimary}" />
                            </Canvas>
                        </Button>
                        <Button
                            Click="{s:MethodBinding SetAnimationLastFrame}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AeButton.Icon}">
                                    <Setter Property="AutomationProperties.Name" Value="{loc:Loc SharedAnimPlayer.LastFrame}" />
                                    <Setter Property="ToolTip" Value="{loc:Loc SharedAnimPlayer.LastFrame}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowFrameInformation, ElementName=PlayerRoot}" Value="False">
                                            <Setter Property="AutomationProperties.Name" Value="{loc:Loc SharedAnimPlayer.End}" />
                                            <Setter Property="ToolTip" Value="{loc:Loc SharedAnimPlayer.End}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Canvas Width="16" Height="16">
                                <Path Data="M 3,3 L 11,8 L 3,13 Z M 13,3 L 13,13" Fill="{DynamicResource AeBrush.TextPrimary}" Stroke="{DynamicResource AeBrush.TextPrimary}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.5" />
                            </Canvas>
                        </Button>
                    </StackPanel>
                </Grid>

                <WrapPanel
                    x:Name="PlaybackInformationRow"
                    Grid.Row="1"
                    Visibility="{Binding PlayerControlsVisibility.Value, Mode=OneWay}"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center">
                    <TextBlock
                        Margin="12,2,0,2"
                        VerticalAlignment="Center"
                        Style="{StaticResource AeText.Technical}"
                        Visibility="{Binding PlayerControlsVisibility.Value, Mode=OneWay}">
                        <Run Text="{loc:Loc SharedAnimPlayer.Time}" />
                        <Run Text="{Binding SelectedAnimationCurrentTime.Value, StringFormat=N2}" />
                        <Run Text=" / " />
                        <Run Text="{Binding SelectedAnimationMaxTime.Value, StringFormat=N2}" />
                        <Run Text="{loc:Loc SharedAnimPlayer.Seconds}" />
                    </TextBlock>
                    <TextBlock
                        Margin="12,2,0,2"
                        VerticalAlignment="Center"
                        Style="{StaticResource AeText.Technical}"
                        Visibility="{Binding ShowFrameInformation, ElementName=PlayerRoot, Converter={StaticResource FrameInformationVisibility}}">
                        <Run Text="{loc:Loc SharedAnimPlayer.Frame}" />
                        <Run Text="{Binding SelectedAnimationCurrentFrame.Value}" />
                        <Run Text=" / " />
                        <Run Text="{Binding SelectedAnimationFrameCount.Value}" />
                    </TextBlock>
                    <TextBlock
                        Margin="12,2,0,2"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowFrameInformation, ElementName=PlayerRoot, Converter={StaticResource FrameInformationVisibility}}">
                        <Run Text="{Binding SelectedAnimationFps.Value, StringFormat=N2}" />
                        <Run Text="{loc:Loc SharedAnimPlayer.Fps}" />
                    </TextBlock>
                    <CheckBox
                        Margin="12,2,0,2"
                        VerticalAlignment="Center"
                        Content="{loc:Loc SharedAnimPlayer.Loop}"
                        IsChecked="{Binding LoopAnimation.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Visibility="{Binding PlayerControlsVisibility.Value, Mode=OneWay}" />
                </WrapPanel>

                <Grid
                    x:Name="PlaybackTimelineRow"
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    Visibility="{Binding PlayerControlsVisibility.Value, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Slider
                        Maximum="{Binding SelectedAnimationMaxTime.Value, Mode=OneWay}"
                        Style="{StaticResource AeEditor.PlaybackSlider}" behaviors:SliderScrubbing.IsScrubbing="{Binding IsScrubbing, Mode=TwoWay}"
                        Value="{Binding PlaybackPositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ContentControl
                        Grid.Row="1"
                        Content="{Binding TimelineAnnotationContent, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource TimelineAnnotationSelector}" />
                </Grid>
            </Grid>
        </Expander>
    </Border>
</UserControl>
