<UserControl x:Class="AnimationEditor.Common.AnimationPlayer.AnimationPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnimationEditor.Common.AnimationPlayer"
             xmlns:basecontrol="clr-namespace:Editors.Shared.Core.Common.BaseControl"
              xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             d:DesignWidth="800"
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}">
    <UserControl.Resources>
        <ResourceDictionary>
            <basecontrol:HostTemplateSelector x:Key="TimelineAnnotationSelector" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        Margin="8,4,8,8"
        Padding="6"
        Background="{DynamicResource AeBrush.Surface2}"
        BorderBrush="{DynamicResource AeBrush.Border}"
        BorderThickness="1"
        CornerRadius="{StaticResource AeRadius.Control}">
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="PlaybackCommandRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="{loc:Loc AnimationView.Animation}" />
                    <ToggleButton
                        IsChecked="{Binding IsEnabled.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource AeInput.Switch}" />
                </StackPanel>

                <Grid
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Visibility="{Binding PlayerControlsVisibility.Value, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource AeText.Label}"
                            Text="{loc:Loc SharedAnimPlayer.MainAnimation}" />
                        <ComboBox
                            MinWidth="140"
                            MaxWidth="220"
                            DisplayMemberPath="SlotName.Value"
                            ItemsSource="{Binding PlayerItems, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectedMainAnimation, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,12,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Button
                            Click="{s:MethodBinding SetAnimationFirstFrame}"
                            Style="{StaticResource AeButton.Icon}">
                            <Canvas Width="16" Height="16">
                                <Path Data="M 3,3 L 3,13 M 13,3 L 5,8 L 13,13 Z" Fill="{DynamicResource AeBrush.TextPrimary}" Stroke="{DynamicResource AeBrush.TextPrimary}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.5" />
                            </Canvas>
                        </Button>
                        <Button
                            Click="{s:MethodBinding SetAnimationPrivFrame}"
                            Style="{StaticResource AeButton.Icon}">
                            <Canvas Width="16" Height="16">
                                <Path Data="M 13,3 L 6,8 L 13,13 Z M 8,3 L 1,8 L 8,13 Z" Fill="{DynamicResource AeBrush.TextPrimary}" />
                            </Canvas>
                        </Button>
                        <ToggleButton
                            Click="{s:MethodBinding ToggleAnimationPausePlay}"
                            IsChecked="{Binding IsPlaying.Value, Mode=OneWay}"
                            Style="{StaticResource AeEditor.PlaybackToggle}">
                            <Canvas Width="16" Height="16">
                                <Path Data="M 4,2 L 14,8 L 4,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" />
                            </Canvas>
                        </ToggleButton>
                        <Button
                            Click="{s:MethodBinding SetAnimationNextFrame}"
                            Style="{StaticResource AeButton.Icon}">
                            <Canvas Width="16" Height="16">
                                <Path Data="M 3,3 L 10,8 L 3,13 Z M 8,3 L 15,8 L 8,13 Z" Fill="{DynamicResource AeBrush.TextPrimary}" />
                            </Canvas>
                        </Button>
                        <Button
                            Click="{s:MethodBinding SetAnimationLastFrame}"
                            Style="{StaticResource AeButton.Icon}">
                            <Canvas Width="16" Height="16">
                                <Path Data="M 3,3 L 11,8 L 3,13 Z M 13,3 L 13,13" Fill="{DynamicResource AeBrush.TextPrimary}" Stroke="{DynamicResource AeBrush.TextPrimary}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.5" />
                            </Canvas>
                        </Button>
                    </StackPanel>

                    <ItemsControl
                        Grid.Column="2"
                        MaxHeight="52"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding PlayerItems, UpdateSourceTrigger=PropertyChanged}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PlayerName" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PlayerFrames" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Margin="4,1"
                                        Style="{StaticResource AeText.Label}"
                                        Text="{Binding SlotName.Value}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Margin="10,1,4,1">
                                        <Run Text="{loc:Loc SharedAnimPlayer.Frame}" />
                                        <Run Text="{Binding MaxFrames.Value}" />
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="10,1,4,1"
                                        Text="{Binding AnimationName.Value}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding AnimationName.Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <Grid
                x:Name="PlaybackTimelineRow"
                Grid.Row="1"
                Margin="0,6,0,0"
                Visibility="{Binding PlayerControlsVisibility.Value, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center">
                    <Run Text="{loc:Loc SharedAnimPlayer.Time}" />
                    <Run Text="{Binding SelectedAnimationCurrentTime.Value, StringFormat=N2}" />
                    <Run Text=" / " />
                    <Run Text="{Binding SelectedAnimationMaxTime.Value, StringFormat=N2}" />
                    <Run Text="{loc:Loc SharedAnimPlayer.Seconds}" />
                </TextBlock>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Slider
                        Maximum="{Binding SelectedAnimationMaxTime.Value, Mode=OneWay}"
                        Style="{StaticResource AeEditor.PlaybackSlider}"
                        Value="{Binding PlaybackPositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ContentControl
                        Grid.Row="1"
                        Content="{Binding TimelineAnnotationContent, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource TimelineAnnotationSelector}" />
                </Grid>
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Run Text="{loc:Loc SharedAnimPlayer.Frame}" />
                    <Run Text="{Binding SelectedAnimationCurrentFrame.Value}" />
                    <Run Text=" / " />
                    <Run Text="{Binding SelectedAnimationFrameCount.Value}" />
                </TextBlock>
                <TextBlock Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Run Text="{Binding SelectedAnimationFps.Value}" />
                    <Run Text="{loc:Loc SharedAnimPlayer.Fps}" />
                </TextBlock>
                <CheckBox
                    Grid.Column="4"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Content="{loc:Loc SharedAnimPlayer.Loop}"
                    IsChecked="{Binding LoopAnimation.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
