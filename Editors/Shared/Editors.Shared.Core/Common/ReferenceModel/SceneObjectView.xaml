<UserControl x:Class="AnimationEditor.Common.ReferenceModel.SceneObjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             d:DesignWidth="800">
    <Expander
        Margin="10,0,0,0"
        IsEnabled="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
        IsExpanded="{Binding IsExpanded, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
        Visibility="{Binding IsControlVisible, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToCollapsedConverter}}">
        <Expander.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding SubHeaderName, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" />
            </StackPanel>
        </Expander.Header>

        <Grid Margin="22,4,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="{loc:Loc SceneObject.Mesh}"
                Style="{StaticResource AeForm.Label}" />
            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,2,0,2"
                IsReadOnly="True"
                Text="{Binding Data.MeshName.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            <Button
                Grid.Row="0"
                Grid.Column="2"
                Margin="4,2,0,2"
                Content="{loc:Loc General.Browse}"
                Click="{s:MethodBinding BrowseMesh}" />
            <ToggleButton
                Grid.Row="0"
                Grid.Column="3"
                Margin="4,2,0,2"
                AutomationProperties.Name="{loc:Loc General.ToggleVisibility}"
                IsChecked="{Binding Data.ShowMesh.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Style="{StaticResource AeButton.VisibilityToggle}"
                ToolTip="{loc:Loc General.ToggleVisibility}" />
            <Button
                Grid.Row="0"
                Grid.Column="4"
                Margin="2"
                Content="{loc:Loc SceneObject.RemoveMesh}"
                Click="{s:MethodBinding RemoveMesh}"
                Style="{StaticResource AeButton.Icon}" />

            <Label
                Grid.Row="1"
                Grid.Column="0"
                Content="{loc:Loc SceneObject.Skeleton}"
                Style="{StaticResource AeForm.Label}" />
            <Expander
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="0,2,0,2"
                IsExpanded="False"
                Style="{StaticResource AeInput.ExpandableField}">
                <Expander.Header>
                    <TextBox
                        MinHeight="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsHitTestVisible="False"
                        IsReadOnly="True"
                        Text="{Binding Data.SkeletonName.Value, UpdateSourceTrigger=PropertyChanged}" />
                </Expander.Header>
                <TreeView
                    MaxHeight="400"
                    ItemsSource="{Binding SkeletonInformation.Bones, UpdateSourceTrigger=PropertyChanged}">
                    <b:Interaction.Behaviors>
                        <behaviors:BindableSelectedItemBehavior
                            SelectedItem="{Binding SkeletonInformation.SelectedBone, Mode=TwoWay}" />
                    </b:Interaction.Behaviors>
                    <TreeView.ItemContainerStyle>
                        <Style
                            BasedOn="{StaticResource {x:Type TreeViewItem}}"
                            TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Path=Children, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding BoneName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text=" - " />
                                <TextBlock Text="{Binding BoneIndex, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Expander>
            <ToggleButton
                Grid.Row="1"
                Grid.Column="3"
                Margin="4,2,0,2"
                AutomationProperties.Name="{loc:Loc General.ToggleVisibility}"
                IsChecked="{Binding Data.ShowSkeleton.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Style="{StaticResource AeButton.VisibilityToggle}"
                ToolTip="{loc:Loc General.ToggleVisibility}" />

            <Border
                Grid.Row="2"
                Grid.ColumnSpan="5"
                Height="1"
                Margin="0,3"
                Background="{DynamicResource AeBrush.Border}" />

            <Label
                Grid.Row="3"
                Grid.Column="0"
                Content="{loc:Loc SceneObject.Fragment}"
                Style="{StaticResource AeForm.Label}" />
            <ComboBox
                Grid.Row="3"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Margin="0,2,0,2"
                DisplayMemberPath="FileName"
                IsEditable="True"
                IsTextSearchEnabled="False"
                ItemsSource="{Binding FragAndSlotSelection.FragmentList.Values}"
                SelectedItem="{Binding FragAndSlotSelection.FragmentList.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Text="{Binding FragAndSlotSelection.FragmentList.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            <Button
                Grid.Row="3"
                Grid.Column="4"
                Margin="2"
                Content="..."
                Click="{s:MethodBinding ViewFragment}"
                Style="{StaticResource AeButton.Icon}" />

            <Label
                Grid.Row="4"
                Grid.Column="0"
                Content="{loc:Loc SceneObject.Slot}"
                Style="{StaticResource AeForm.Label}" />
            <ComboBox
                Grid.Row="4"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                Margin="0,2,0,2"
                DisplayMemberPath="SlotName"
                IsEditable="True"
                IsTextSearchEnabled="False"
                ItemsSource="{Binding FragAndSlotSelection.FragmentSlotList.Values}"
                SelectedItem="{Binding FragAndSlotSelection.FragmentSlotList.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Text="{Binding FragAndSlotSelection.FragmentSlotList.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

            <Border
                Grid.Row="5"
                Grid.ColumnSpan="5"
                Height="1"
                Margin="0,3"
                Background="{DynamicResource AeBrush.Border}" />

            <Label
                Grid.Row="6"
                Grid.Column="0"
                Content="{loc:Loc SceneObject.AnimationFile}"
                Style="{StaticResource AeForm.Label}" />
            <TextBox
                Grid.Row="6"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                Margin="0,2,0,2"
                IsReadOnly="True"
                Text="{Binding FragAndSlotSelection.AnimationFileName, UpdateSourceTrigger=PropertyChanged}" />

            <Label
                Grid.Row="7"
                Grid.Column="0"
                Content="{loc:Loc SceneObject.MetaFile}"
                Style="{StaticResource AeForm.Label}" />
            <TextBox
                Grid.Row="7"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                Margin="0,2,0,2"
                IsReadOnly="True"
                Text="{Binding FragAndSlotSelection.MetaDataName, UpdateSourceTrigger=PropertyChanged}" />

            <Label
                Grid.Row="8"
                Grid.Column="0"
                Content="{loc:Loc SceneObject.PersistMetaFile}"
                Style="{StaticResource AeForm.Label}" />
            <TextBox
                Grid.Row="8"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                Margin="0,2,0,2"
                IsReadOnly="True"
                Text="{Binding FragAndSlotSelection.MetaDataPersistName, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
    </Expander>
</UserControl>
