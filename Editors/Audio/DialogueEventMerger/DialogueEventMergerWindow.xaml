<Window
    x:Class="Editors.Audio.DialogueEventMerger.DialogueEventMergerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:DialogueEventMerger="clr-namespace:Editors.Audio.DialogueEventMerger"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui"
    d:DataContext="{d:DesignInstance Type=DialogueEventMerger:DialogueEventMergerViewModel}"
    mc:Ignorable="d"
    Width="700"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    Closing="OnClosing"
    Closed="OnClosed"
    Title="{loc:Loc DialogueEventMerger.Title}"
    Background="{DynamicResource AeBrush.Canvas}"
    FontFamily="{DynamicResource AeFont.Family}"
    FontWeight="{DynamicResource AeFont.Weight.Normal}"
    Foreground="{DynamicResource AeBrush.TextPrimary}">

    <Window.Resources>
        <ResourceDictionary Source="/Editors.Audio;component/AudioUiStyles.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto"/>
            <RowDefinition
                Height="Auto"/>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition 
                Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock  
            Grid.Row="0"  
            Text="{loc:Loc DialogueEventMerger.Description}"  
            HorizontalAlignment="Left"
            Margin="10, 10, 10, 0"
            TextWrapping="Wrap"/>

        <Grid 
            Grid.Row="1" 
            Margin="10"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition 
                    Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid 
                Grid.Row="0">
                
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto"/>
                    <RowDefinition 
                        Height="Auto"/>
                    <RowDefinition 
                        Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition 
                        Width="180"/>
                    <ColumnDefinition 
                        Width="*"/>
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Row="0" 
                    Grid.Column="0" 
                    Content="{loc:Loc DialogueEventMerger.SoundBankSuffix}"
                    ToolTip="{loc:Loc DialogueEventMerger.SoundBankSuffix.ToolTip}"/>

                <TextBox 
                    Grid.Row="0" 
                    Grid.Column="1"
                    Text="{Binding SoundBankSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center"
                    Padding="2, 0, 0, 0"/>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource AeBrush.Warning}"
                    Text="{Binding SoundBankSuffixError}"
                    TextWrapping="Wrap"/>

                <Label
                    Grid.Row="2"
                    Grid.Column="0" 
                    Margin="0, 10, 0, 0"
                    Content="{loc:Loc DialogueEventMerger.ModdedSoundBanks}"
                    ToolTip="{loc:Loc DialogueEventMerger.ModdedSoundBanks.ToolTip}"/>

                <ListBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0, 10, 0, 0"
                    MaxHeight="500"
                    ItemsSource="{Binding ModdedSoundBanks}"
                    SelectionMode="Extended"
                    VerticalAlignment="Stretch"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox 
                                IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                <TextBlock 
                                    Text="{Binding FilePath}" />
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="10,0,10,8">
            <progress:OperationProgressView
                CurrentDetailText="{Binding LoadStatus}"
                IsOperationActive="{Binding IsBusy}"
                IsProgressIndeterminate="True"
                StatusText="{loc:Loc OperationProgress.AudioMerge}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock
                Margin="0,4,0,0"
                Text="{Binding LoadStatus}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <StackPanel 
            Grid.Row="3"
            Orientation="Horizontal" 
            HorizontalAlignment="Right" 
            Margin="10, 0, 10, 10">

            <Button
                Content="{loc:Loc General.SelectAll}"
                Style="{StaticResource AeButton.Quiet}"
                Margin="0,0,5,0"
                Command="{Binding SelectAllCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolConverter}}"/>

            <Button
                Content="{loc:Loc General.SelectNone}"
                Style="{StaticResource AeButton.Quiet}"
                Margin="0,0,15,0"
                Command="{Binding SelectNoneCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolConverter}}"/>

            <Button 
                Content="{loc:Loc General.Ok}"
                Style="{StaticResource AeButton.Primary}"
                Width="75"
                Margin="0, 0, 5, 0"
                Command="{Binding GenerateMergedDialogueEventSoundBankCommand}" 
                IsDefault="True"
                IsEnabled="{Binding IsOkButtonEnabled}"/>

            <Button 
                Content="{loc:Loc General.Cancel}"
                Style="{StaticResource AeButton.Secondary}"
                Width="75"
                Margin="5, 0, 0, 0"
                IsCancel="True"
                Command="{Binding CloseWindowActionCommand}"/>
        </StackPanel>
    </Grid>
</Window>
