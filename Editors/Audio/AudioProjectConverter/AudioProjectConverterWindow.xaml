<Window
    x:Class="Editors.Audio.AudioProjectConverter.AudioProjectConverterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:AudioProjectConverter="clr-namespace:Editors.Audio.AudioProjectConverter"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui"
    d:DataContext="{d:DesignInstance Type=AudioProjectConverter:AudioProjectConverterViewModel}"
    mc:Ignorable="d"
    Width="850"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    Closing="OnClosing"
    Closed="OnClosed"
    Style="{StaticResource CustomWindowStyle}"
    Title="{loc:Loc AudioProjectConverter.Title}"
    Background="{DynamicResource AeBrush.Canvas}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}">

    <Window.Resources>
        <ResourceDictionary Source="/Editors.Audio;component/AudioUiStyles.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="16,12,16,0"
            HorizontalAlignment="Left"
            Style="{StaticResource AeText.Body}"
            Text="{loc:Loc AudioProjectConverter.Description}"
            TextWrapping="Wrap" />

        <Grid
            Grid.Row="1"
            Margin="16,12,16,16"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolConverter}}">
            <Grid.Resources>
                <Style
                    TargetType="{x:Type Label}"
                    BasedOn="{StaticResource AeForm.Label}">
                    <Setter Property="Margin" Value="0,8,8,0" />
                </Style>
                <Style
                    TargetType="{x:Type TextBox}"
                    BasedOn="{StaticResource AeInput.TextBox}">
                    <Setter Property="Margin" Value="0,8,0,0" />
                </Style>
                <Style
                    TargetType="{x:Type Button}"
                    BasedOn="{StaticResource AeButton.Secondary}">
                    <Setter Property="Width" Value="64" />
                    <Setter Property="Margin" Value="8,8,0,0" />
                </Style>
                <Style
                    TargetType="{x:Type CheckBox}"
                    BasedOn="{StaticResource AeInput.CheckBox}">
                    <Setter Property="Margin" Value="0,8,0,0" />
                </Style>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CheckBox
                Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="0"
                Content="{loc:Loc AudioProjectConverter.AppendToExistingProject}"
                IsChecked="{Binding IsAppendingToExistingProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{loc:Loc AudioProjectConverter.AppendToExistingProject.ToolTip}" />

            <Label
                Grid.Row="1"
                Grid.Column="0"
                Content="{loc:Loc AudioProjectConverter.ExistingAudioProject}"
                IsEnabled="{Binding IsAppendingToExistingProject}"
                ToolTip="{loc:Loc AudioProjectConverter.ExistingAudioProject.ToolTip}" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                IsEnabled="{Binding IsAppendingToExistingProject}"
                IsReadOnly="True"
                Text="{Binding ExistingAudioProjectPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Row="1"
                Grid.Column="2"
                AutomationProperties.Name="{loc:Loc AudioProjectConverter.SelectExistingAudioProject}"
                Command="{Binding SetExistingAudioProjectPathCommand}"
                Content="..."
                IsEnabled="{Binding IsAppendingToExistingProject}"
                ToolTip="{loc:Loc AudioProjectConverter.ExistingAudioProject.ToolTip}" />

            <Label
                Grid.Row="2"
                Grid.Column="0"
                Content="{loc:Loc AudioProjectConverter.AudioProjectName}"
                IsEnabled="{Binding IsAppendingToExistingProject, Converter={StaticResource InvBoolConverter}}"
                ToolTip="{loc:Loc AudioProjectConverter.AudioProjectName.ToolTip}" />
            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                IsEnabled="{Binding IsAppendingToExistingProject, Converter={StaticResource InvBoolConverter}}"
                Text="{Binding AudioProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Label
                Grid.Row="3"
                Grid.Column="0"
                Content="{loc:Loc AudioProjectConverter.OutputDirectory}"
                IsEnabled="{Binding IsAppendingToExistingProject, Converter={StaticResource InvBoolConverter}}"
                ToolTip="{loc:Loc AudioProjectConverter.OutputDirectory.ToolTip}" />
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                IsEnabled="{Binding IsAppendingToExistingProject, Converter={StaticResource InvBoolConverter}}"
                IsReadOnly="True"
                Text="{Binding OutputDirectoryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Row="3"
                Grid.Column="2"
                AutomationProperties.Name="{loc:Loc AudioProjectConverter.OutputDirectory}"
                Command="{Binding SetOutputDirectoryPathCommand}"
                Content="..."
                IsEnabled="{Binding IsAppendingToExistingProject, Converter={StaticResource InvBoolConverter}}"
                ToolTip="{loc:Loc AudioProjectConverter.OutputDirectory.ToolTip}" />

            <Label
                Grid.Row="4"
                Grid.Column="0"
                Content="{loc:Loc AudioProjectConverter.VOActorSubstring}"
                ToolTip="{loc:Loc AudioProjectConverter.VOActorSubstring.ToolTip}" />
            <TextBox
                Grid.Row="4"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Text="{Binding VOActorSubstring, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Label
                Grid.Row="5"
                Grid.Column="0"
                Content="{loc:Loc AudioProjectConverter.WemsDirectory}"
                ToolTip="{loc:Loc AudioProjectConverter.WemsDirectory.ToolTip}" />
            <TextBox
                Grid.Row="5"
                Grid.Column="1"
                IsReadOnly="True"
                Text="{Binding WemsDirectoryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Row="5"
                Grid.Column="2"
                AutomationProperties.Name="{loc:Loc AudioProjectConverter.WemsDirectory}"
                Command="{Binding SetWemsDirectoryPathCommand}"
                Content="..."
                ToolTip="{loc:Loc AudioProjectConverter.WemsDirectory.ToolTip}" />

            <Label
                Grid.Row="6"
                Grid.Column="0"
                Content="{loc:Loc AudioProjectConverter.BnksDirectory}"
                ToolTip="{loc:Loc AudioProjectConverter.BnksDirectory.ToolTip}" />
            <TextBox
                Grid.Row="6"
                Grid.Column="1"
                IsReadOnly="True"
                Text="{Binding BnksDirectoryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Row="6"
                Grid.Column="2"
                AutomationProperties.Name="{loc:Loc AudioProjectConverter.BnksDirectory}"
                Command="{Binding SetBnksDirectoryPathCommand}"
                Content="..."
                ToolTip="{loc:Loc AudioProjectConverter.BnksDirectory.ToolTip}" />

            <CheckBox
                Grid.Row="7"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Content="{loc:Loc AudioProjectConverter.ConvertingFromWwise}"
                IsChecked="{Binding IsUsingWwiseProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{loc:Loc AudioProjectConverter.ConvertingFromWwise.ToolTip}" />

            <Label
                Grid.Row="8"
                Grid.Column="0"
                Content="{loc:Loc AudioProjectConverter.SoundbanksInfoXml}"
                IsEnabled="{Binding IsUsingWwiseProject}"
                ToolTip="{loc:Loc AudioProjectConverter.SoundbanksInfoXml.ToolTip}" />
            <TextBox
                Grid.Row="8"
                Grid.Column="1"
                IsEnabled="{Binding IsUsingWwiseProject}"
                IsReadOnly="True"
                Text="{Binding SoundbanksInfoXmlPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Row="8"
                Grid.Column="2"
                AutomationProperties.Name="{loc:Loc AudioProjectConverter.SoundbanksInfoXml}"
                Command="{Binding SetSoundbanksInfoXmlPathCommand}"
                Content="..."
                IsEnabled="{Binding IsUsingWwiseProject}"
                ToolTip="{loc:Loc AudioProjectConverter.SoundbanksInfoXml.ToolTip}" />
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="16,0,16,12">
            <progress:OperationProgressWindowHost
                CurrentDetailText="{Binding ProgressDetail}"
                IsOperationActive="{Binding IsBusy}"
                IsProgressIndeterminate="{Binding ProgressIsIndeterminate}"
                ProgressMaximum="{Binding ProgressMaximum}"
                ProgressValue="{Binding ProgressValue}"
                StatusText="{Binding Status}"
                WindowTitle="{loc:Loc OperationProgress.AudioConvert}" />
            <TextBlock
                Text="{Binding Status}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style
                        TargetType="TextBlock"
                        BasedOn="{StaticResource AeText.Caption}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Border
            Grid.Row="3"
            Style="{StaticResource AeWorkflow.DialogFooter}">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0,0,8,0"
                    Command="{Binding ProcessAudioProjectConversionCommand}"
                    Content="{loc:Loc General.Ok}"
                    IsDefault="True"
                    IsEnabled="{Binding IsOkButtonEnabled}"
                    Style="{StaticResource AeButton.Primary}" />
                <Button
                    Width="80"
                    Command="{Binding CloseWindowActionCommand}"
                    Content="{loc:Loc General.Cancel}"
                    IsCancel="True"
                    Style="{StaticResource AeButton.Secondary}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
