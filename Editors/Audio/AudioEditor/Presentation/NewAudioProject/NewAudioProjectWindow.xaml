<Window
    x:Class="Editors.Audio.AudioEditor.Presentation.NewAudioProject.NewAudioProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:ValueConverters="clr-namespace:Editors.Audio.Shared.UI.ValueConverters"
    xmlns:Local="clr-namespace:Editors.Audio.AudioEditor.Presentation.NewAudioProject"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui"
    d:DataContext="{d:DesignInstance Type=Local:NewAudioProjectViewModel}"
    mc:Ignorable="d"
    Width="500"
    MinHeight="225"
    MaxHeight="620"
    SizeToContent="Height"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner"
    Closing="OnClosing"
    Title="{loc:Loc NewAudioProject.Title}"
    Background="{DynamicResource AeBrush.Canvas}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Editors.Audio;component/AudioUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ValueConverters:EnumConverter
                x:Key="EnumConverter"/>
            <BooleanToVisibilityConverter
                x:Key="BoolToVisibilityConverter"/>
            <DataTemplate
                x:Key="EnumToStringTemplate">
                <TextBlock
                    Text="{Binding Converter={StaticResource EnumConverter}}"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition
                Height="Auto"/>
            <RowDefinition 
                Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid 
            Grid.Row="1" 
            Margin="10"
            IsEnabled="{Binding IsCreating, Converter={StaticResource InvBoolConverter}}">
            
            <Grid.RowDefinitions>
                <RowDefinition 
                    Height="Auto"/>
                <RowDefinition 
                    Height="Auto"/>
                <RowDefinition 
                    Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid 
                Grid.Row="0">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition 
                        Width="70"/>
                    <ColumnDefinition 
                        Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto"/>
                    <RowDefinition
                        Height="Auto"/>
                </Grid.RowDefinitions>

                <Label
                    Grid.Column="0" 
                    Content="{loc:Loc NewAudioProject.Name}"/>
                
                <TextBox 
                    Grid.Column="1"
                    Text="{Binding AudioProjectFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="{loc:Loc NewAudioProject.Name.ToolTip}"
                    VerticalContentAlignment="Center"
                    Padding="2, 0, 0, 0"/>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,2,0,0"
                    Foreground="{DynamicResource AeBrush.Danger}"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Text="{Binding ValidationMessage}"/>
            </Grid>

            <Grid 
                Grid.Row="1" 
                Margin="0, 5, 0, 0">
                    
                <Grid.ColumnDefinitions>
                    <ColumnDefinition 
                        Width="70"/>
                    <ColumnDefinition 
                        Width="*"/>
                    <ColumnDefinition 
                        Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label 
                    Grid.Column="0"
                    Content="{loc:Loc NewAudioProject.Location}"/>
                
                <TextBox 
                    Grid.Column="1"
                    Text="{Binding AudioProjectDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="{loc:Loc NewAudioProject.Location.ToolTip}"
                    IsReadOnly="True"
                    VerticalContentAlignment="Center"
                    Padding="2, 0, 0, 0"/>
                
                <Button 
                    Grid.Column="2" 
                    Content="..."
                    Width="30"
                    Margin="5, 0, 0, 0" 
                    Command="{Binding SetNewFileLocationCommand}"/>
            </Grid>

            <Grid 
                Grid.Row="2"
                Margin="0, 5, 0, 0">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition 
                        Width="70"/>
                    <ColumnDefinition
                        Width="*"/>
                </Grid.ColumnDefinitions>

                <Label 
                    Grid.Column="0"
                    Content="{loc:Loc NewAudioProject.Language}" />

                <ComboBox 
                    Grid.Column="1" 
                    ToolTip="{loc:Loc NewAudioProject.Language.ToolTip}"
                    ItemsSource="{Binding Languages}" 
                    SelectedItem="{Binding SelectedLanguage}" 
                    ItemTemplate="{StaticResource EnumToStringTemplate}"/>
            </Grid>
        </Grid>

        <progress:OperationProgressView
            Grid.Row="2"
            Margin="10,0,10,6"
            CurrentDetailText="{Binding CreationStatus}"
            IsOperationActive="{Binding IsCreating}"
            IsProgressIndeterminate="True"
            StatusText="{loc:Loc OperationProgress.AudioCreate}"
            Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}" />

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="10, 0, 10, 10">
            
            <Button 
                Content="{loc:Loc General.Ok}"
                Style="{StaticResource AeButton.Primary}"
                Width="75"
                Margin="0, 0, 5, 0"
                Command="{Binding CreateAudioProjectCommand}" 
                IsDefault="True"
                IsEnabled="{Binding IsOkButtonEnabled}"/>
            
            <Button 
                Content="{loc:Loc General.Cancel}"
                Style="{StaticResource AeButton.Secondary}"
                Width="75"
                Margin="5, 0, 0, 0"
                Command="{Binding CancelOrCloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>
