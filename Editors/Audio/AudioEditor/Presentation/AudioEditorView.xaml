<UserControl 
    x:Class="Editors.Audio.AudioEditor.Presentation.AudioEditorView"
    x:Name="AudioEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:s="http://schemas.singulink.com/xaml" 
    xmlns:Local="clr-namespace:Editors.Audio.AudioEditor.Presentation"
    xmlns:AudioProjectExplorer="clr-namespace:Editors.Audio.AudioEditor.Presentation.AudioProjectExplorer"
    xmlns:AudioFilesExplorer="clr-namespace:Editors.Audio.AudioEditor.Presentation.AudioFilesExplorer"
    xmlns:AudioProjectEditor="clr-namespace:Editors.Audio.AudioEditor.Presentation.AudioProjectEditor"
    xmlns:Settings="clr-namespace:Editors.Audio.AudioEditor.Presentation.Settings"
    xmlns:AudioProjectViewer="clr-namespace:Editors.Audio.AudioEditor.Presentation.AudioProjectViewer"
    xmlns:WaveformVisualiser="clr-namespace:Editors.Audio.AudioEditor.Presentation.WaveformVisualiser"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:progress="clr-namespace:Shared.Ui.Common.OperationProgress;assembly=Shared.Ui"
    d:DataContext="{d:DesignInstance Type=Local:AudioEditorViewModel}"
    mc:Ignorable="d" 
    Background="{DynamicResource AeBrush.Canvas}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}"
    d:DesignWidth="1200" d:DesignHeight="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Editors.Audio;component/AudioUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition 
                Height="*"/>
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Grid.Column="0">
            
            <Grid.RowDefinitions>
                <RowDefinition 
                    Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*"/>
                <ColumnDefinition
                    Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Menu 
                Grid.Row="0" 
                Grid.Column="0"
                Margin="0, 5, 5, 0">
                <MenuItem 
                    Header="{loc:Loc AudioEditor.Menu.File}"
                    HorizontalAlignment="Left">
                    <MenuItem 
                        Header="{loc:Loc AudioEditor.Menu.File.NewAudioProject}"
                        Command="{Binding NewAudioProjectCommand}"
                        IsEnabled="{Binding IsEditorIdle}"/>
                    <MenuItem 
                        Header="{loc:Loc AudioEditor.Menu.File.OpenAudioProject}"
                        Command="{Binding LoadAudioProjectCommand}"
                        IsEnabled="{Binding IsEditorIdle}"/>
                    <MenuItem
                        Header="{loc:Loc AudioEditor.Menu.File.CancelLoad}"
                        Command="{Binding LoadAudioProjectCancelCommand}"
                        IsEnabled="{Binding IsLoading}"/>
                    <Separator/>
                    <MenuItem 
                        Header="{loc:Loc AudioEditor.Menu.File.SaveAudioProject}"
                        Command="{Binding SaveAudioProjectCommand}"
                        IsEnabled="{Binding CanEditAudioProject}"/>
                    <MenuItem 
                        Header="{loc:Loc AudioEditor.Menu.File.CompileAudioProject}"
                        Command="{Binding CompileAudioProjectCommand}"
                        IsEnabled="{Binding CanEditAudioProject}"/>
                    <MenuItem
                        Header="{loc:Loc AudioEditor.Menu.File.CancelCompile}"
                        Command="{Binding CompileAudioProjectCancelCommand}"
                        IsEnabled="{Binding IsCompiling}"/>
                    <Separator/>
                    <MenuItem 
                        Header="{loc:Loc AudioEditor.Menu.File.RefreshSourceIds}"
                        Command="{Binding RefreshSourceIdsCommand}"
                        IsEnabled="{Binding CanEditAudioProject}"/>
                </MenuItem>
                <MenuItem 
                    Header="{loc:Loc AudioEditor.Menu.Tools}"
                    IsEnabled="{Binding IsEditorIdle}"
                    HorizontalAlignment="Left">
                    <MenuItem 
                        Header="{loc:Loc AudioEditor.Menu.Tools.DialogueEventMerger}"
                        Command="{Binding OpenDialogueEventMergerCommand}"/>
                    <MenuItem
                        Header="{loc:Loc AudioEditor.Menu.Tools.AudioProjectMerger}"
                        Command="{Binding OpenAudioProjectMergerCommand}"/>
                    <MenuItem 
                        Header="{loc:Loc AudioEditor.Menu.Tools.AudioProjectConverter}"
                        Command="{Binding OpenAudioProjectConverterCommand}"/>
                </MenuItem>
            </Menu>

            <Grid
                Grid.Row="0"
                Grid.Column="1"
                Margin="10, 5, 10, 0"
                VerticalAlignment="Center">
                <progress:OperationProgressView
                    Width="460"
                    CurrentDetailText="{Binding CompileStatus}"
                    IsOperationActive="{Binding IsBusy}"
                    IsProgressIndeterminate="True"
                    StatusText="{loc:Loc OperationProgress.AudioCompile}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    MinWidth="72"
                    MaxWidth="360"
                    VerticalAlignment="Center"
                    Text="{Binding CompileStatus}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding CompileStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <Border 
            Grid.Row="1" 
            Height="1" 
            Background="{DynamicResource AeBrush.Border}"
            Margin="0, 5, 0, 0"/>

        <Grid 
            Grid.Row="2">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition 
                    Width="2*"
                    MinWidth="300"/>
                <ColumnDefinition 
                    Width="Auto"/>
                <ColumnDefinition 
                    Width="3*"
                    MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <Grid 
                Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition 
                        Height="*"/>
                </Grid.RowDefinitions>

                <Grid 
                    Grid.Row="1">

                    <Grid.RowDefinitions>
                        <RowDefinition 
                            Height="*"/>
                        <RowDefinition 
                            Height="Auto"/>
                        <RowDefinition 
                            Height="*"/>
                        <RowDefinition 
                            Height="Auto"/>
                        <RowDefinition 
                            Height="Auto"/>
                    </Grid.RowDefinitions>

                    <AudioProjectExplorer:AudioProjectExplorerView
                        Grid.Row="0"
                        Grid.Column="0"
                        DataContext="{Binding AudioProjectExplorerViewModel}"/>

                    <GridSplitter
                        Grid.Row="1"
                        Height="5"
                        Background="{DynamicResource AeBrush.Border}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Rows"/>

                    <AudioFilesExplorer:AudioFilesExplorerView 
                        Grid.Row="2"
                        Grid.Column="0"
                        DataContext="{Binding AudioFilesExplorerViewModel}"/>

                    <GridSplitter
                        Grid.Row="3"
                        Height="5"
                        Background="{DynamicResource AeBrush.Border}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Rows"
                        Visibility="{Binding WaveformVisualiserViewModel.HasSelectedAudio, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <WaveformVisualiser:WaveformVisualiserView 
                        Grid.Row="4"
                        Grid.Column="0"
                        DataContext="{Binding WaveformVisualiserViewModel}"
                        Visibility="{Binding HasSelectedAudio, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Grid>

            <GridSplitter 
                Grid.Column="1" 
                Width="5" 
                Background="{DynamicResource AeBrush.Border}"
                VerticalAlignment="Stretch" 
                HorizontalAlignment="Center"
                ResizeBehavior="PreviousAndNext" 
                ResizeDirection="Columns"/>
            
            <Grid 
                Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition 
                        Height="Auto"/>
                    <RowDefinition 
                        Height="Auto"/>
                    <RowDefinition 
                        Height="Auto"/>
                    <RowDefinition 
                        Height="*"/>
                </Grid.RowDefinitions>

                <AudioProjectEditor:AudioProjectEditorView
                    Grid.Row="0"
                    Grid.Column="0"
                    DataContext="{Binding AudioProjectEditorViewModel}"/>

                <Border 
                    Grid.Row="1"
                    Height="5" 
                    Background="{DynamicResource AeBrush.Border}"
                    Visibility="{Binding IsSettingsBorderVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Settings:SettingsView 
                    Grid.Row="2"
                    Grid.Column="0"
                    DataContext="{Binding SettingsViewModel}"/>

                <AudioProjectViewer:AudioProjectViewerView 
                    Grid.Row="3"
                    Grid.Column="0"
                    DataContext="{Binding AudioProjectViewerViewModel}"/>
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Panel.ZIndex="2"
            Background="{DynamicResource AeBrush.Surface1}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding IsAudioProjectLoaded}"
                            Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource AeBrush.TextMuted}"
                Text="{Binding EmptyStateText}"
                TextAlignment="Center"
                TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
