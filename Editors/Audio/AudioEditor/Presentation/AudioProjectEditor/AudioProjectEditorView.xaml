<UserControl 
    x:Class="Editors.Audio.AudioEditor.Presentation.AudioProjectEditor.AudioProjectEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:Behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
    xmlns:AudioProjectEditor="clr-namespace:Editors.Audio.AudioEditor.Presentation.AudioProjectEditor"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    d:DataContext="{d:DesignInstance Type=AudioProjectEditor:AudioProjectEditorViewModel}"
    mc:Ignorable="d"
    Background="{DynamicResource AeBrush.Canvas}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}"
    d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Editors.Audio;component/AudioUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid
        Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVisibilityConverter}}">

        <Grid.RowDefinitions>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition 
                Height="Auto"/>
        </Grid.RowDefinitions>

        <Label 
            Grid.Row="0" 
            Margin="0, 0, 0, 5"
            Content="{Binding EditorLabel}"/>

        <Grid 
            Grid.Row="1" 
            MinHeight="25" 
            Margin="0, 0, 0, 5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="Auto"/>
                <ColumnDefinition 
                    Width="Auto"/>
                <ColumnDefinition 
                    Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button 
                Grid.Column="0"
                Content="{Binding CommitButtonLabel}"
                Style="{StaticResource AeButton.Primary}"
                ToolTipService.ShowOnDisabled="True"
                Command="{Binding AddRowsToViewerCommand}" 
                Margin="5, 0, 0, 0" 
                Width="80"
                VerticalAlignment="Center" 
                HorizontalAlignment="Left"
                IsEnabled="{Binding IsAddRowButtonEnabled}">
                
                <Button.ToolTip>
                    <ToolTip>
                        <TextBlock TextWrapping="Wrap" Text="{Binding CommitButtonToolTip}"/>
                    </ToolTip>
                </Button.ToolTip>
            </Button>

            <Button
                Grid.Column="1"
                Margin="5, 0, 0, 0"
                Width="80"
                Content="{loc:Loc General.Cancel}"
                Style="{StaticResource AeButton.Secondary}"
                Command="{Binding CancelEditCommand}"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <CheckBox 
                Grid.Column="2"
                Content="{loc:Loc AudioProjectEditor.ShowModdedStatesOnly}"
                ToolTip="{loc:Loc AudioProjectEditor.ShowModdedStatesOnly.ToolTip}"
                ToolTipService.ShowOnDisabled="True"
                Margin="5, 0, 0, 0" 
                VerticalAlignment="Center" 
                IsChecked="{Binding ShowModdedStatesOnly, Mode=TwoWay}" 
                HorizontalAlignment="Left" 
                IsEnabled="{Binding IsShowModdedStatesCheckBoxEnabled}"
                Visibility="{Binding IsShowModdedStatesCheckBoxVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
        
        <!-- Setting CanUserAddRows to false ensures that data won't go missing from the last row when a new row is added. Wtf WPF. -->
        <DataGrid 
            Grid.Row="2"
            Margin="0, 0, 0, 0"
            AutoGenerateColumns="False"
            Behaviors:DataGridColumnsBehavior.Columns ="{Binding DataGridColumns}"
            CanUserAddRows="False" 
            ItemsSource="{Binding Table.DefaultView}"
            EnableRowVirtualization="True" 
            EnableColumnVirtualization="True"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>
