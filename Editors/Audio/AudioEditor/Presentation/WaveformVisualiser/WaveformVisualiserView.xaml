<UserControl x:Class="Editors.Audio.AudioEditor.Presentation.WaveformVisualiser.WaveformVisualiserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Editors.Audio.AudioEditor.Presentation.WaveformVisualiser"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             d:DataContext="{d:DesignInstance Type=local:WaveformVisualiserViewModel}"
             mc:Ignorable="d" 
             Background="{DynamicResource AeBrush.Canvas}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}"
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="/Editors.Audio;component/AudioUiStyles.xaml" />
    </UserControl.Resources>
    <Grid
        Background="{DynamicResource AeBrush.Canvas}">
        
        <Grid.RowDefinitions>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition 
                Height="Auto"/>
        </Grid.RowDefinitions>

        <Label
            Grid.Row="0" 
            Margin="0, 0, 0, 5"
            Content="{Binding WaveformVisualiserLabel}"/>

        <Grid
            Grid.Row="1"
            x:Name="AudioWaveformGrid"
            Cursor="Hand"
            ToolTip="{loc:Loc WaveformVisualiser.Seek.ToolTip}"
            MouseLeftButtonDown="OnWaveformMouseLeftButtonDown">

            <Image
                Stretch="None"
                SnapsToDevicePixels="True"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="{Binding AudioWaveformBaseImageSource}"
                Width="{Binding WaveformPixelWidth}"
                Height="{Binding WaveformPixelHeight}"/>

            <Image
                Stretch="None"
                SnapsToDevicePixels="True"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="{Binding AudioWaveformOverlayImageSource}"
                Width="{Binding WaveformPixelWidth}"
                Height="{Binding WaveformPixelHeight}">

                <Image.Clip>
                    <RectangleGeometry 
                        Rect="{Binding AudioWaveformOverlayClip}"/>
                </Image.Clip>
            </Image>
        </Grid>
        
        <Grid
            Grid.Row="2"
            Margin="0, 5, 0, 0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="5,0,5,4"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource AeBrush.TextMuted}"
                Text="{Binding PlaybackStatus}"
                TextTrimming="CharacterEllipsis"/>

            <Grid
                Grid.Row="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="5, 0, 0, 5"
                Panel.ZIndex="10">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding CurrentPlaybackTime, StringFormat={}{0:mm\\:ss\\.ff}}"/>
            </Grid>

            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
                <Button
                    Margin="0, 0, 4, 5"
                    Width="70"
                    Content="{Binding PlayPauseLabel}"
                    Style="{StaticResource AeButton.Primary}"
                    IsEnabled="{Binding HasSelectedAudio}"
                    Command="{Binding PlayPauseCommand}"/>
                <Button
                    Margin="4, 0, 0, 5"
                    Width="55"
                    Content="{loc:Loc WaveformVisualiser.Stop}"
                    Style="{StaticResource AeButton.Secondary}"
                    IsEnabled="{Binding HasSelectedAudio}"
                    Command="{Binding StopCommand}"/>
            </StackPanel>

            <Grid
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0, 0, 5, 5"
                Panel.ZIndex="10">

                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding TotalPlaybackTime, StringFormat={}{0:mm\\:ss\\.ff}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
