<UserControl 
    x:Class="Editors.Audio.AudioEditor.Presentation.AudioFilesExplorer.AudioFilesExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ValueConverters="clr-namespace:Editors.Audio.AudioEditor.Presentation.AudioFilesExplorer.ValueConverters"
    xmlns:Models="clr-namespace:Editors.Audio.AudioEditor.Presentation.Shared.Models"
    xmlns:Controls="clr-namespace:Editors.Audio.AudioEditor.Presentation.Shared.Controls"
    xmlns:AudioFilesExplorer="clr-namespace:Editors.Audio.AudioEditor.Presentation.AudioFilesExplorer"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    d:DataContext="{d:DesignInstance Type=AudioFilesExplorer:AudioFilesExplorerViewModel}"
    mc:Ignorable="d"
    Background="{DynamicResource AeBrush.Canvas}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}"
    d:DesignHeight="250" 
    d:DesignWidth="500">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Editors.Audio;component/AudioUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ValueConverters:ImageConverter
                x:Key="ImageValueConverter"/>
            <BooleanToVisibilityConverter
                x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition
                Height="Auto"/>
            <RowDefinition 
                Height="*"/>
        </Grid.RowDefinitions>

        <Label 
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="0, 0, 0, 5"
            Content="{Binding AudioFilesExplorerLabel}"/>

        <Grid
            Grid.Row="1">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition 
                    Width="Auto"/>
                <ColumnDefinition 
                    Width="Auto"/>
                <ColumnDefinition 
                    Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button 
                Grid.Column="0"
                Margin="5, 0, 0, 0"
                Width="180" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Left"
                Style="{StaticResource AeButton.Quiet}"
                Content="{loc:Loc AudioFilesExplorer.ToggleCollapseExpand}"
                ToolTip="{loc:Loc AudioFilesExplorer.ToggleCollapseExpand.ToolTip}" 
                Command="{Binding CollapseOrExpandTreeCommand}"/>

            <Button 
                Grid.Column="1"
                Margin="5, 0, 0, 0" 
                Width="100" 
                Style="{StaticResource AeButton.Primary}"
                Content="{loc:Loc AudioFilesExplorer.SetAudioFiles}"
                ToolTip="{loc:Loc AudioFilesExplorer.SetAudioFiles.ToolTip}"
                ToolTipService.ShowOnDisabled="True"
                Command="{Binding SetAudioFilesCommand}" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Left"
                IsEnabled="{Binding IsSetAudioFilesButtonEnabled}"/>
            
            <Button 
                Grid.Column="2"
                Margin="5, 0, 0, 0" 
                Width="120" 
                Content="{loc:Loc AudioFilesExplorer.AddToAudioFiles}"
                ToolTip="{loc:Loc AudioFilesExplorer.AddToAudioFiles.ToolTip}"
                ToolTipService.ShowOnDisabled="True"
                Command="{Binding AddToAudioFilesCommand}" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Left"
                IsEnabled="{Binding IsAddAudioFilesButtonEnabled}"/>
        </Grid>

        <!-- Search and Clear Button -->
        <Grid 
            Grid.Row="2"
            Margin="5, 5, 5, 0">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition 
                    Width="*"/>
            </Grid.ColumnDefinitions>

            <Border 
                SnapsToDevicePixels="True" 
                BorderBrush="{DynamicResource AeBrush.Border}"
                BorderThickness="1">
                
                <Grid>
                    <TextBox 
                        x:Name="FilterTextBoxItem" 
                        Style="{StaticResource HintedTextBox}" 
                        KeyboardNavigation.TabIndex="0" 
                        FontSize="12" 
                        BorderThickness="0"
                        KeyboardNavigation.IsTabStop="True"
                        HorizontalAlignment="Stretch" Padding="2.5, 0, 0, 0"  Height="24" VerticalContentAlignment="Center" 
                        Text="{Binding FilterQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=350}"
                        Tag="{loc:Loc AudioFilesExplorer.SearchHint}">
                    </TextBox>

                    <Button 
                        Padding="2" 
                        Width="24" 
                        Height="24" 
                        HorizontalAlignment="Right"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource AeButton.Icon}"
                        Click="OnClearButtonClick" 
                        Command="{Binding ClearTextCommand}">
                        <materialIcons:MaterialIcon Width="14" Height="14" Kind="Close" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Controls:MultiSelectTreeView
            x:Name="AudioFilesTreeView"
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Margin="0, 5, 0, 0"
            Padding="0, 5, 0, 5"
            ItemsSource="{Binding AudioFilesTree}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            Background="{DynamicResource AeBrush.Surface1}"
            BorderBrush="Transparent"
            SelectedItems="{Binding SelectedTreeNodes, Mode=TwoWay}"
            MouseDoubleClick="OnMouseDoubleClick"
            Style="{StaticResource {x:Type TreeView}}">

            <Controls:MultiSelectTreeView.ItemContainerStyle>
                <Style 
                    TargetType="{x:Type TreeViewItem}" 
                    BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter 
                        Property="IsExpanded" 
                        Value="{Binding IsExpanded, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <Setter 
                        Property="Visibility">
                        <Setter.Value>
                            <Binding 
                                Path="IsVisible" 
                                Converter="{StaticResource BoolToVisibilityConverter}" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger 
                            Property="Controls:MultiSelectTreeView.IsMultiSelected" 
                            Value="True">
                            <Setter 
                                Property="Background" 
                                Value="{DynamicResource AeBrush.AccentSoft}" />
                            <Setter 
                                Property="BorderBrush" 
                                Value="{DynamicResource AeBrush.Accent}" />
                            <Setter 
                                Property="Foreground" 
                                Value="{DynamicResource AeBrush.TextPrimary}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Controls:MultiSelectTreeView.ItemContainerStyle>

            <Controls:MultiSelectTreeView.ItemTemplate>
                <HierarchicalDataTemplate 
                    DataType="{x:Type Models:AudioFilesTreeNode}" 
                    ItemsSource="{Binding Children}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition 
                                Width="Auto" />
                            <ColumnDefinition 
                                Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image 
                            Grid.Column="0" 
                            Width="16" 
                            Height="16" 
                            Source="{Binding Path=., Converter={StaticResource ImageValueConverter}}" />
                        <TextBlock 
                            Grid.Column="1" 
                            Margin="4,0,0,0" 
                            Text="{Binding FileName}" />
                    </Grid>
                </HierarchicalDataTemplate>
            </Controls:MultiSelectTreeView.ItemTemplate>
        </Controls:MultiSelectTreeView>
    </Grid>
</UserControl>
