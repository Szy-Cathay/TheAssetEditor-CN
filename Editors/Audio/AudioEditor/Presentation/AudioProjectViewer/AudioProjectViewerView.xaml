<UserControl 
    x:Class="Editors.Audio.AudioEditor.Presentation.AudioProjectViewer.AudioProjectViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:Behaviours="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
    xmlns:AudioProjectViewer="clr-namespace:Editors.Audio.AudioEditor.Presentation.AudioProjectViewer"
    xmlns:ValueConverters="clr-namespace:Editors.Audio.AudioEditor.Presentation.AudioProjectViewer.ValueConverters"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    d:DataContext="{d:DesignInstance Type=AudioProjectViewer:AudioProjectViewerViewModel}"
    mc:Ignorable="d" 
    Background="{DynamicResource AeBrush.Canvas}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}"
    d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Editors.Audio;component/AudioUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter
                x:Key="BoolToVisibilityConverter"/>
            <ValueConverters:ActionEventRowEnablementConverter
                x:Key="ActionEventRowEnablementConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Visibility="{Binding IsViewerVisible, Converter={StaticResource BoolToVisibilityConverter}}">

        <Grid.RowDefinitions>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition 
                Height="Auto"/>
            <RowDefinition 
                Height="*"/>
        </Grid.RowDefinitions>
        
        <Label 
            Grid.Row="0"
            Margin="0, 0, 0, 5"
            Content="{Binding ViewerLabel}"/>

        <Grid 
            Grid.Row="1" 
            MinHeight="25"
            Margin="0, 0, 0, 5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition 
                    Width="Auto"/>
                <ColumnDefinition 
                    Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button 
                Grid.Column="0"
                Margin="5, 0, 0, 0" 
                Width="80"
                VerticalAlignment="Center" 
                HorizontalAlignment="Left"
                Content="{loc:Loc AudioProjectViewer.EditRow}"
                Style="{StaticResource AeButton.Primary}"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="{loc:Loc AudioProjectViewer.EditRow.ToolTip}"
                Command="{Binding EditRowCommand}" 
                IsEnabled="{Binding IsUpdateRowButtonEnabled}"/>
            
            <Button 
                Grid.Column="1"
                Margin="5, 0, 0, 0" 
                Width="80"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Content="{loc:Loc AudioProjectViewer.RemoveRow}"
                Style="{StaticResource AeButton.Danger}"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="{loc:Loc AudioProjectViewer.RemoveRow.ToolTip}"
                Command="{Binding RemoveRowCommand}" 
                IsEnabled="{Binding IsRemoveRowButtonEnabled}"/>
        </Grid>

        <!-- Setting CanUserAddRows to false ensures that data won't go missing from the last row when a new row is added. Wtf WPF. -->
        <DataGrid 
            Grid.Row="2"
            x:Name="AudioProjectEditorDataGrid"
            AutoGenerateColumns="False" 
            VerticalScrollBarVisibility="Auto" 
            SelectionChanged="OnDataGridSelectionChanged"
            Behaviours:DataGridColumnsBehavior.Columns ="{Binding DataGridColumns}"
            CanUserAddRows="False"
            ItemsSource="{Binding Table.DefaultView}"
            MinColumnWidth="160"
            EnableRowVirtualization="True" 
            EnableColumnVirtualization="True"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <DataGrid.RowStyle>
                <Style 
                    TargetType="{x:Type DataGridRow}"
                    BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter
                        Property="ToolTipService.ShowOnDisabled"
                        Value="True" />

                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <TextBlock
                                TextWrapping="Wrap"
                                Text="{loc:Loc AudioProjectViewer.RowToolTip}"/>
                        </Setter.Value>
                    </Setter>
                    
                    <Style.Triggers>
                        <DataTrigger 
                            Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding 
                                    Converter="{StaticResource ActionEventRowEnablementConverter}">
                                    <Binding />
                                    <Binding
                                        Path="DataContext.SelectedAudioProjectExplorerNode"
                                        RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter 
                                Property="IsEnabled" 
                                Value="False" />
                            <Setter 
                                Property="ToolTip"
                                Value="{loc:Loc AudioProjectViewer.DisabledRowToolTip}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ContextMenu>
                <ContextMenu
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">

                    <MenuItem
                        Header="{loc:Loc AudioProjectViewer.Copy}"
                        Command="{Binding CopyRowsCommand}"
                        Visibility="{Binding IsContextMenuCopyVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <MenuItem
                        Header="{loc:Loc AudioProjectViewer.Paste}"
                        Command="{Binding PasteRowsCommand}"
                        Visibility="{Binding IsContextMenuPasteVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
