<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
                    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/GridSplitterStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="TextBox" BasedOn="{StaticResource AeInput.TextBox}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource AeInput.ComboBox}" />
    <Style TargetType="Button" BasedOn="{StaticResource AeButton.Secondary}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource AeInput.CheckBox}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Retarget.Label" TargetType="Label" BasedOn="{StaticResource AeForm.Label}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="Retarget.Heading" TargetType="TextBlock" BasedOn="{StaticResource AeText.Body}">
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Retarget.Scroll" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <DataTemplate x:Key="Retarget.Vector3">
        <UniformGrid Columns="3">
            <DockPanel Margin="0,0,4,0">
                <TextBlock Text="{loc:Loc Ui.Axis.X}" Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource AeText.Caption}" />
                <TextBox Text="{Binding X.TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" /></b:Interaction.Behaviors>
                </TextBox>
            </DockPanel>
            <DockPanel Margin="0,0,4,0">
                <TextBlock Text="{loc:Loc Ui.Axis.Y}" Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource AeText.Caption}" />
                <TextBox Text="{Binding Y.TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" /></b:Interaction.Behaviors>
                </TextBox>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="{loc:Loc Ui.Axis.Z}" Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource AeText.Caption}" />
                <TextBox Text="{Binding Z.TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" /></b:Interaction.Behaviors>
                </TextBox>
            </DockPanel>
        </UniformGrid>
    </DataTemplate>
</ResourceDictionary>
