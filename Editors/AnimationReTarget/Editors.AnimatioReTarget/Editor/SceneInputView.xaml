<UserControl x:Class="Editors.AnimatioReTarget.Editor.SceneInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Editors.AnimatioReTarget.Editor"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RetargetUiStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" MaxHeight="360" /><RowDefinition Height="*" MinHeight="100" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="InputScroll" Style="{StaticResource Retarget.Scroll}" Margin="0,0,0,8">
        <StackPanel>
        <DockPanel Margin="0,4,0,8">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc SceneObject.Mesh}" Style="{StaticResource Retarget.Heading}" />
            <Separator Margin="8,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox IsReadOnly="True" Text="{Binding Data.MeshName.Value}" ToolTip="{Binding Data.MeshName.Value}" AutomationProperties.Name="{loc:Loc SceneObject.Mesh}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="{loc:Loc General.Browse}" Click="{s:MethodBinding BrowseMesh}" />
            <ToggleButton Grid.Column="2" Margin="4,0,0,0" IsChecked="{Binding Data.ShowMesh.Value, Mode=TwoWay}"
                          Style="{StaticResource AeButton.VisibilityToggle}" ToolTip="{loc:Loc General.ToggleVisibility}" AutomationProperties.Name="{loc:Loc General.ToggleVisibility}" />
            <Button Grid.Column="3" Margin="4,0,0,0" Click="{s:MethodBinding RemoveMesh}" Style="{StaticResource AeButton.Icon}"
                    ToolTip="{loc:Loc SceneObject.RemoveMesh.ToolTip}" AutomationProperties.Name="{loc:Loc SceneObject.RemoveMesh.ToolTip}">
                <Path Width="12" Height="12" Stretch="Uniform" Data="M 2,2 L 10,10 M 10,2 L 2,10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
            </Button>
        </Grid>
        <DockPanel Margin="0,4,0,8">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc SceneObject.Skeleton}" Style="{StaticResource Retarget.Heading}" />
            <Separator Margin="8,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox IsReadOnly="True" Text="{Binding Data.SkeletonName.Value}" ToolTip="{Binding Data.SkeletonName.Value}" AutomationProperties.Name="{loc:Loc SceneObject.Skeleton}" />
            <ToggleButton Grid.Column="1" Margin="4,0,0,0" IsChecked="{Binding Data.ShowSkeleton.Value, Mode=TwoWay}"
                          Style="{StaticResource AeButton.VisibilityToggle}" ToolTip="{loc:Loc General.ToggleVisibility}" AutomationProperties.Name="{loc:Loc General.ToggleVisibility}" />
        </Grid>
        <local:SourceAnimationView x:Name="AnimationSelection" />
        </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="1">
        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,8">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc AnimReTarget.BoneList}" Style="{StaticResource Retarget.Heading}" />
            <Separator Margin="8,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
        <TreeView x:Name="SkeletonTree" ItemsSource="{Binding SkeletonInformation.Bones}" Style="{StaticResource AeTree.View}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <b:Interaction.Behaviors>
                <behaviors:BindableSelectedItemBehavior SelectedItem="{Binding SkeletonInformation.SelectedBone, Mode=TwoWay}" />
            </b:Interaction.Behaviors>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource AeTree.Item}"><Setter Property="IsExpanded" Value="True" /></Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock><Run Text="{Binding BoneName, Mode=OneWay}" /><Run Text=" [" /><Run Text="{Binding BoneIndex, Mode=OneWay}" /><Run Text="]" /></TextBlock>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        </DockPanel>
    </Grid>
</UserControl>
