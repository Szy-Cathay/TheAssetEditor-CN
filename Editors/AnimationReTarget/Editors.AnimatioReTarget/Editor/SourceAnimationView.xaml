<UserControl x:Class="Editors.AnimatioReTarget.Editor.SourceAnimationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RetargetUiStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,4,0,8">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc AnimReTarget.AnimationSettings}" Style="{StaticResource Retarget.Heading}" />
            <Separator Margin="8,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Label Content="{loc:Loc AnimReTarget.AnimationSet}" Style="{StaticResource Retarget.Label}" />
            <ComboBox x:Name="FragmentSelection" Grid.Column="1" Margin="0,0,0,4" DisplayMemberPath="FileName" IsEditable="True" IsTextSearchEnabled="False"
                      ItemsSource="{Binding FragAndSlotSelection.FragmentList.Values}"
                      SelectedItem="{Binding FragAndSlotSelection.FragmentList.SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Text="{Binding FragAndSlotSelection.FragmentList.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc AnimReTarget.AnimationSet}" />
            <Button Grid.Column="2" Margin="8,0,0,4" Content="{loc:Loc AnimReTarget.ViewFragment}" Click="{s:MethodBinding ViewFragment}" />
            <Label Grid.Row="1" Content="{loc:Loc SceneObject.Slot}" Style="{StaticResource Retarget.Label}" />
            <ComboBox x:Name="SlotSelection" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4" DisplayMemberPath="SlotName" IsEditable="True" IsTextSearchEnabled="False"
                      ItemsSource="{Binding FragAndSlotSelection.FragmentSlotList.Values}"
                      SelectedItem="{Binding FragAndSlotSelection.FragmentSlotList.SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Text="{Binding FragAndSlotSelection.FragmentSlotList.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc SceneObject.Slot}" />
            <Label Grid.Row="2" Content="{loc:Loc AnimReTarget.SourceAnimation}" Style="{StaticResource Retarget.Label}" />
            <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" Text="{Binding FragAndSlotSelection.AnimationFileName}"
                     ToolTip="{Binding FragAndSlotSelection.AnimationFileName}" AutomationProperties.Name="{loc:Loc AnimReTarget.SourceAnimation}" />
            <Button Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" Content="{loc:Loc General.Browse}" Click="{s:MethodBinding BrowseAnimation}" />
            <StackPanel x:Name="AssociatedInformation" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0">
                <DockPanel Margin="0,4,0,8">
                    <TextBlock Text="{loc:Loc AnimReTarget.AssociatedInformation}" Style="{StaticResource Retarget.Heading}" />
                    <Separator Margin="8,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Label Content="{loc:Loc SceneObject.MetaFile}" Style="{StaticResource Retarget.Label}" />
                    <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding FragAndSlotSelection.MetaDataName}" ToolTip="{Binding FragAndSlotSelection.MetaDataName}" />
                    <Label Grid.Row="1" Content="{loc:Loc SceneObject.PersistMetaFile}" Style="{StaticResource Retarget.Label}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" IsReadOnly="True" Text="{Binding FragAndSlotSelection.MetaDataPersistName}" ToolTip="{Binding FragAndSlotSelection.MetaDataPersistName}" />
                </Grid>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
