<UserControl x:Class="Editors.AnimatioReTarget.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Editors.AnimatioReTarget.Editor"
             xmlns:settings="clr-namespace:Editors.AnimatioReTarget.Editor.Settings"
             xmlns:bones="clr-namespace:Editors.AnimatioReTarget.Editor.BoneHandling.Presentation"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             Background="{DynamicResource AeBrush.Surface1}" Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Normal">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RetargetUiStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TabControl x:Name="Categories" SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}"
                    ItemContainerStyle="{StaticResource AeTab.Item}" BorderThickness="0" Padding="0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="{loc:Loc AnimReTarget.Category.Source}" Tag="Source">
                <local:SceneInputView x:Name="SourceInput" DataContext="{Binding SourceModel}" />
            </TabItem>
            <TabItem Header="{loc:Loc AnimReTarget.Category.Target}" Tag="Target">
                <local:SceneInputView x:Name="TargetInput" DataContext="{Binding TargetModel}" />
            </TabItem>
            <TabItem Header="{loc:Loc AnimReTarget.Category.Adjustment}" Tag="Adjustment">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <settings:SettingsView />
                    <bones:BoneSettingsView Grid.Row="1" Margin="0,8,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="1" BorderBrush="{DynamicResource AeBrush.Border}" BorderThickness="0,1,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="ApplyButton" HorizontalAlignment="Left" Content="{loc:Loc AnimReTarget.ApplyPreview}"
                        Command="{Binding UpdateAnimationCommand}" Style="{StaticResource AeButton.Primary}"
                        ToolTip="{loc:Loc AnimReTarget.ApplyPreview.ToolTip}" />
                <Button x:Name="SaveButton" Grid.Column="1" Content="{loc:Loc AnimReTarget.OpenSave}"
                        Command="{Binding SaveManager.ShowSaveSettingsCommand}" ToolTip="{loc:Loc AnimReTarget.OpenSave.ToolTip}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
