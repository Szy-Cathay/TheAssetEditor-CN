<UserControl x:Class="Editors.AnimatioReTarget.Editor.BoneHandling.Presentation.SelectedBoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../RetargetUiStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,0,4,8">
        <DockPanel Margin="0,4,0,4">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc BoneMapping.SelectedBoneSettings}" Style="{StaticResource Retarget.Heading}" />
            <Separator Margin="8,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="SelectedBoneName" Text="{Binding BoneManager.SelectedBone.BoneName}" ToolTip="{Binding BoneManager.SelectedBone.BoneName}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
        <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding BoneManager.SelectedBone}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Label Content="{loc:Loc AnimReTarget.TranslationOffset}" Style="{StaticResource Retarget.Label}" />
            <ContentControl Content="{Binding BoneManager.SelectedBone.TranslationOffset}" ContentTemplate="{StaticResource Retarget.Vector3}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" />
            <Label Content="{loc:Loc AnimReTarget.RotationOffset}" Style="{StaticResource Retarget.Label}" />
            <ContentControl Content="{Binding BoneManager.SelectedBone.RotationOffset}" ContentTemplate="{StaticResource Retarget.Vector3}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="124" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Label Content="{loc:Loc AnimReTarget.BoneLengthMult}" Style="{StaticResource Retarget.Label}" />
                <TextBox x:Name="BoneLengthInput" Grid.Column="1" Text="{Binding BoneManager.SelectedBone.BoneLengthMult, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                    <b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" JustPositivDecimalInput="True" /></b:Interaction.Behaviors>
                </TextBox>
            </Grid>
            <CheckBox Content="{loc:Loc AnimReTarget.FreezePosition}" IsChecked="{Binding BoneManager.SelectedBone.FreezeTranslation}" ToolTip="{loc:Loc AnimReTarget.FreezePosition.ToolTip}" Margin="0,0,0,4" />
            <CheckBox Content="{loc:Loc AnimReTarget.FreezeRotation}" IsChecked="{Binding BoneManager.SelectedBone.FreezeRotation}" ToolTip="{loc:Loc AnimReTarget.FreezeRotation.ToolTip}" Margin="0,0,0,4" />
            <CheckBox Content="{loc:Loc AnimReTarget.FreezeRotationZ}" IsChecked="{Binding BoneManager.SelectedBone.FreezeRotationZ}" ToolTip="{loc:Loc AnimReTarget.FreezeRotationZ.ToolTip}" Margin="0,0,0,4" />
            <CheckBox Content="{loc:Loc AnimReTarget.SnapWorldspace}" IsChecked="{Binding BoneManager.SelectedBone.ForceSnapToWorld}" ToolTip="{loc:Loc AnimReTarget.SnapWorldspace.ToolTip}" Margin="0,0,0,4" />
            <CheckBox Content="{loc:Loc AnimReTarget.ApplyTranslation}" IsChecked="{Binding BoneManager.SelectedBone.ApplyTranslation}" ToolTip="{loc:Loc AnimReTarget.ApplyTranslation.ToolTip}" Margin="0,0,0,4" />
            <CheckBox Content="{loc:Loc AnimReTarget.ApplyRotation}" IsChecked="{Binding BoneManager.SelectedBone.ApplyRotation}" ToolTip="{loc:Loc AnimReTarget.ApplyRotation.ToolTip}" Margin="0,0,0,8" />
            <Label Content="{loc:Loc AnimReTarget.IsRelativeTo}" Style="{StaticResource Retarget.Label}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox DisplayMemberPath="BoneName" ItemsSource="{Binding BoneManager.FlatBoneList}" SelectedItem="{Binding BoneManager.SelectedBone.SelectedRelativeBone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc AnimReTarget.IsRelativeTo.ToolTip}" />
                <Button Grid.Column="1" Margin="8,0,0,0" Content="{loc:Loc AnimReTarget.Clear}" Command="{Binding BoneManager.ClearRelativeSelectedBoneCommand}" />
            </Grid>
            <Button Content="{loc:Loc AnimReTarget.ClearSelectedBoneSettings}" Command="{Binding BoneManager.ResetSelectedBoneCommand}" ToolTip="{loc:Loc AnimReTarget.ClearSelectedBoneSettings.ToolTip}" HorizontalAlignment="Left" Style="{StaticResource AeButton.Quiet}" />
        </StackPanel>
    </StackPanel>
</UserControl>
