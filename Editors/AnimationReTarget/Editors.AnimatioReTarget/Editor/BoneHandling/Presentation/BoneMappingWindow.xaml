<common:AssetEditorWindow
    xmlns:common="clr-namespace:WindowHandling;assembly=Shared.Ui"
    x:Class="Editors.AnimatioReTarget.Editor.BoneHandling.Presentation.BoneMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:CommonControls.Editors.BoneMapping.View;assembly=Editors.Shared.Core"
        xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        mc:Ignorable="d"
        Title="{loc:Loc AnimReTarget.BoneMappingWindowTitle}"
        Height="680" MinHeight="420"
        Width="1000" MinWidth="640"
        Background="{DynamicResource AeBrush.Canvas}"
        Foreground="{DynamicResource AeBrush.TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}">
    <common:AssetEditorWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../RetargetUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </common:AssetEditorWindow.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <view:BoneMappingView Grid.Row="0" LeftSkeletonHeader="{loc:Loc AnimReTarget.Mapping.TargetHeader}" RightSkeletonHeader="{loc:Loc AnimReTarget.Mapping.SourceHeader}" MappingHint="{loc:Loc AnimReTarget.Mapping.PairHint}"
                              CopyToChildrenText="{loc:Loc AnimReTarget.Mapping.CopyToChildren}" CopyToChildrenToolTip="{loc:Loc AnimReTarget.Mapping.CopyToChildren.ToolTip}" />

        <DockPanel Grid.Row="1" LastChildFill="False" >
            <Button DockPanel.Dock="Right" Width="72" Margin="8,8,0,0" Style="{StaticResource AeButton.Primary}" Content="{loc:Loc General.Ok}" Click="OkButtonClick"/>
            <Button DockPanel.Dock="Right" Width="72" Margin="8,8,0,0" Style="{StaticResource AeButton.Quiet}" Content="{loc:Loc General.Cancel}" Click="CancelButtonClick"/>
        </DockPanel>
    </Grid>
</common:AssetEditorWindow>
