<UserControl x:Class="Editors.AnimatioReTarget.Editor.BoneHandling.Presentation.BoneSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mathviews="clr-namespace:CommonControls.MathViews;assembly=Shared.Ui"
             xmlns:System="clr-namespace:System;assembly=System.Runtime" 
             xmlns:presentation="clr-namespace:Editors.AnimatioReTarget.Editor.BoneHandling.Presentation"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/GridSplitterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <System:Double x:Key="labelWidth">110</System:Double>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Expander IsExpanded="True" Header="{loc:Loc AnimReTarget.BoneSettings}" >
        <Grid Margin="10,0,2,0" >

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="Auto" MaxHeight="520"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Row="0"
                Grid.ColumnSpan="3"
                Margin="0,8,0,8"
                Style="{StaticResource AeFeedback.Notice}">
                <StackPanel>
                    <TextBlock
                        Style="{StaticResource AeText.Label}"
                        Text="{loc:Loc AnimReTarget.HumanoidMapping.Title}" />
                    <TextBlock
                        Margin="0,4,0,8"
                        Style="{StaticResource AeText.Body}"
                        Text="{loc:Loc AnimReTarget.HumanoidMapping.Description}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button
                            AutomationProperties.Name="{loc:Loc AnimReTarget.HumanoidMapping.Action}"
                            Command="{Binding BoneManager.ApplyHumanoidMappingCommand}"
                            Content="{loc:Loc AnimReTarget.HumanoidMapping.Action}"
                            Style="{StaticResource AeButton.Primary}"
                            ToolTip="{loc:Loc AnimReTarget.HumanoidMapping.ToolTip}" />
                        <Button
                            Margin="6,0,0,0"
                            AutomationProperties.Name="{loc:Loc AnimReTarget.Profile.Save}"
                            Command="{Binding BoneManager.SaveCharacterProfileCommand}"
                            Content="{loc:Loc AnimReTarget.Profile.Save}"
                            Style="{StaticResource AeButton.Secondary}"
                            ToolTip="{loc:Loc AnimReTarget.Profile.Save.ToolTip}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource AeText.Caption}">
                            <Run Text="{loc:Loc AnimReTarget.HumanoidMapping.Summary}" />
                            <Run Text="{Binding BoneManager.MappingSummary, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TreeView Grid.Row="1" Grid.Column="0"
                      MaxHeight="520"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      Style="{StaticResource AeTree.View}"
                      ItemsSource="{Binding BoneManager.Bones, UpdateSourceTrigger=PropertyChanged}">
  
                    <b:Interaction.Behaviors>
                        <behaviors:BindableSelectedItemBehavior SelectedItem="{Binding BoneManager.SelectedBone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </b:Interaction.Behaviors>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource AeTree.Item}">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate >
                        <HierarchicalDataTemplate ItemsSource="{Binding Path=Children, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AeBrush.TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMapping}" Value="False">
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AeBrush.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding BoneName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text=" ["/>
                                <TextBlock Text="{Binding BoneIndex, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="]"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

            <GridSplitter
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource AeVerticalGridSplitterStyle}" />

            <presentation:SelectedBoneView Grid.Row="1" Grid.Column="2"/>

        </Grid>
    </Expander>
</UserControl>
