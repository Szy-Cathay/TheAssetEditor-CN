<UserControl x:Class="Editors.AnimatioReTarget.Editor.BoneHandling.Presentation.BoneSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:presentation="clr-namespace:Editors.AnimatioReTarget.Editor.BoneHandling.Presentation"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../RetargetUiStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/GridSplitterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,4,0,8">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc AnimReTarget.MappingAndAdjustment}" Style="{StaticResource Retarget.Heading}" />
            <Separator Margin="8,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <WrapPanel>
                <Button Content="{loc:Loc AnimReTarget.EditMapping}" Command="{Binding BoneManager.ShowBoneMappingWindowCommand}" Margin="0,0,8,4" />
                <Button Content="{loc:Loc AnimReTarget.Profile.Save}" Command="{Binding BoneManager.SaveCharacterProfileCommand}" Margin="0,0,0,4" ToolTip="{loc:Loc AnimReTarget.Profile.Save.ToolTip}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource AeText.Caption}" Foreground="{DynamicResource AeBrush.TextSecondary}">
                <Run Text="{loc:Loc AnimReTarget.MappingSummary}" /><Run Text="  " /><Run Text="{Binding BoneManager.MappingSummary, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.38*" MinWidth="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="0.62*" MinWidth="248" /></Grid.ColumnDefinitions>
            <TreeView x:Name="TargetBoneTree" Grid.Column="0" Margin="0,0,4,0" Style="{StaticResource AeTree.View}" ItemsSource="{Binding BoneManager.Bones}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc AnimReTarget.Category.Target}">
                <b:Interaction.Behaviors><behaviors:BindableSelectedItemBehavior SelectedItem="{Binding BoneManager.SelectedBone, Mode=TwoWay}" /></b:Interaction.Behaviors>
                <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem" BasedOn="{StaticResource AeTree.Item}"><Setter Property="IsExpanded" Value="True" /></Style></TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextPrimary}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasMapping}" Value="False"><Setter Property="Foreground" Value="{DynamicResource AeBrush.Danger}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding BoneName, Mode=OneWay}" /><Run Text=" [" /><Run Text="{Binding BoneIndex, Mode=OneWay}" /><Run Text="]" />
                        </TextBlock>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <GridSplitter Grid.Column="1" Style="{StaticResource AeVerticalGridSplitterStyle}" />
            <ScrollViewer x:Name="BonePropertiesScroll" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Retarget.Scroll}">
                <presentation:SelectedBoneView />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
