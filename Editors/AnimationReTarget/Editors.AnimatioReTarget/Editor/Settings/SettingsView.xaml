<UserControl x:Class="Editors.AnimatioReTarget.Editor.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../RetargetUiStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="124" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <DockPanel Grid.ColumnSpan="2" Margin="0,4,0,8">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc AnimReTarget.OverallAdjustment}" Style="{StaticResource Retarget.Heading}" />
            <Separator Margin="8,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
        <Label Grid.Row="1" Content="{loc:Loc AnimReTarget.SkeletonScale}" Style="{StaticResource Retarget.Label}" />
        <TextBox x:Name="SkeletonScaleInput" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" HorizontalAlignment="Left" Width="128"
                 Text="{Binding Settings.SkeletonScale, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{loc:Loc AnimReTarget.SkeletonScale.ToolTip}">
            <b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" JustPositivDecimalInput="True" /></b:Interaction.Behaviors>
        </TextBox>
        <Label Grid.Row="2" Content="{loc:Loc AnimReTarget.AnimationSpeedMult}" Style="{StaticResource Retarget.Label}" />
        <TextBox x:Name="AnimationSpeedInput" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" HorizontalAlignment="Left" Width="128"
                 Text="{Binding Settings.AnimationSpeedMult, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
            <b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" JustPositivDecimalInput="True" /></b:Interaction.Behaviors>
        </TextBox>
        <WrapPanel Grid.Row="3" Grid.ColumnSpan="2">
            <CheckBox Content="{loc:Loc AnimReTarget.ApplyRelativeScale}" Margin="0,4,16,4" IsChecked="{Binding Settings.ApplyRelativeScale, Mode=TwoWay}" ToolTip="{loc:Loc AnimReTarget.ApplyRelativeScale.ToolTip}" />
            <CheckBox Content="{loc:Loc AnimReTarget.ZeroUnmappedBones}" Margin="0,4,0,4" IsChecked="{Binding Settings.ZeroUnmappedBones, Mode=TwoWay}" ToolTip="{loc:Loc AnimReTarget.ZeroUnmappedBones.ToolTip}" />
        </WrapPanel>
    </Grid>
</UserControl>
