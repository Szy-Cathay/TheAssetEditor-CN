<UserControl x:Class="Editors.AnimatioReTarget.Editor.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <StackPanel>
        <Expander
            Header="{loc:Loc AnimReTarget.RenderSettings}"
            IsExpanded="True">
            <Grid Margin="10,2,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="{loc:Loc AnimReTarget.GeneratedMesh}"
                    Style="{StaticResource AeForm.Label}" />
                <CheckBox
                    Grid.Row="0"
                    Grid.Column="1"
                    IsChecked="{Binding Rendering.ShowGeneratedMesh, UpdateSourceTrigger=PropertyChanged}" />

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="{loc:Loc AnimReTarget.GeneratedSkeleton}"
                    Style="{StaticResource AeForm.Label}" />
                <CheckBox
                    Grid.Row="1"
                    Grid.Column="1"
                    IsChecked="{Binding Rendering.ShowGeneratedSkeleton, UpdateSourceTrigger=PropertyChanged}" />

                <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    Content="{loc:Loc AnimReTarget.OffsetSpacing}"
                    Style="{StaticResource AeForm.Label}" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,2"
                    Text="{Binding Rendering.VisualOffset, UpdateSourceTrigger=LostFocus, Mode=TwoWay}">
                    <b:Interaction.Behaviors>
                        <behaviors:TextBoxInputBehavior InputMode="DecimalInput" />
                    </b:Interaction.Behaviors>
                </TextBox>
            </Grid>
        </Expander>

        <Expander
            Header="{loc:Loc AnimReTarget.AnimationSettings}"
            IsExpanded="True">
            <Grid Margin="10,2,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="{loc:Loc AnimReTarget.SkeletonScale}"
                    Style="{StaticResource AeForm.Label}" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,2"
                    Text="{Binding Settings.SkeletonScale, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                    ToolTip="{loc:Loc AnimReTarget.SkeletonScale.ToolTip}">
                    <b:Interaction.Behaviors>
                        <behaviors:TextBoxInputBehavior InputMode="DecimalInput" />
                    </b:Interaction.Behaviors>
                </TextBox>

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="{loc:Loc AnimReTarget.AnimationSpeedMult}"
                    Style="{StaticResource AeForm.Label}" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,2"
                    Text="{Binding Settings.AnimationSpeedMult, UpdateSourceTrigger=LostFocus, Mode=TwoWay}">
                    <b:Interaction.Behaviors>
                        <behaviors:TextBoxInputBehavior InputMode="DecimalInput" />
                    </b:Interaction.Behaviors>
                </TextBox>

                <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    Content="{loc:Loc AnimReTarget.ZeroUnmappedBones}"
                    Style="{StaticResource AeForm.Label}" />
                <CheckBox
                    Grid.Row="2"
                    Grid.Column="1"
                    IsChecked="{Binding Settings.ZeroUnmappedBones, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    ToolTip="{loc:Loc AnimReTarget.ZeroUnmappedBones.ToolTip}" />

                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    Content="{loc:Loc AnimReTarget.ApplyRelativeScale}"
                    Style="{StaticResource AeForm.Label}" />
                <CheckBox
                    Grid.Row="3"
                    Grid.Column="1"
                    IsChecked="{Binding Settings.ApplyRelativeScale, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    ToolTip="{loc:Loc AnimReTarget.ApplyRelativeScale.ToolTip}" />
            </Grid>
        </Expander>
    </StackPanel>
</UserControl>
