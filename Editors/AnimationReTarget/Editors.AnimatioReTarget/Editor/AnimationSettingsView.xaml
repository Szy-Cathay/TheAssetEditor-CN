<UserControl x:Class="AnimationEditor.AnimationTransferTool.AnimationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mathviews="clr-namespace:CommonControls.MathViews;assembly=Shared.Ui"
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Expander
        Header="{loc:Loc AnimReTarget.Settings}"
        IsExpanded="True">
        <Grid Margin="10,2,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="{loc:Loc AnimReTarget.VisibilityGenerated}"
                Style="{StaticResource AeForm.Label}" />
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal">
                <CheckBox
                    Margin="0,0,12,0"
                    Content="{loc:Loc AnimReTarget.Mesh}"
                    IsChecked="{Binding Generated.ShowMesh.Value, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox
                    Content="{loc:Loc AnimReTarget.Skeleton}"
                    IsChecked="{Binding Generated.ShowSkeleton.Value, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Label
                Grid.Row="1"
                Grid.Column="0"
                Content="{loc:Loc AnimReTarget.Offset}"
                Style="{StaticResource AeForm.Label}" />
            <mathviews:Vector3View
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,2"
                Vector3="{Binding AnimationSettings.DisplayOffset, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

            <Label
                Grid.Row="2"
                Grid.Column="0"
                Content="{loc:Loc AnimReTarget.SkeletonScale}"
                Style="{StaticResource AeForm.Label}" />
            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,2"
                Text="{Binding AnimationSettings.Scale.TextValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                ToolTip="{loc:Loc AnimReTarget.SkeletonScale.ToolTip}">
                <b:Interaction.Behaviors>
                    <behaviors:TextBoxInputBehavior InputMode="DecimalInput" />
                </b:Interaction.Behaviors>
            </TextBox>

            <Label
                Grid.Row="3"
                Grid.Column="0"
                Content="{loc:Loc AnimReTarget.AnimationSpeedMult}"
                Style="{StaticResource AeForm.Label}" />
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                Margin="0,2"
                Text="{Binding AnimationSettings.SpeedMult.TextValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                <b:Interaction.Behaviors>
                    <behaviors:TextBoxInputBehavior InputMode="DecimalInput" />
                </b:Interaction.Behaviors>
            </TextBox>

            <Label
                Grid.Row="4"
                Grid.Column="0"
                Content="{loc:Loc AnimReTarget.ApplyRelativeScale}"
                Style="{StaticResource AeForm.Label}" />
            <CheckBox
                Grid.Row="4"
                Grid.Column="1"
                IsChecked="{Binding AnimationSettings.ApplyRelativeScale.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                ToolTip="{loc:Loc AnimReTarget.ApplyRelativeScale.ToolTip}" />

            <Label
                Grid.Row="5"
                Grid.Column="0"
                Content="{loc:Loc AnimReTarget.ZeroUnmappedBones}"
                Style="{StaticResource AeForm.Label}" />
            <CheckBox
                Grid.Row="5"
                Grid.Column="1"
                IsChecked="{Binding AnimationSettings.FreezeUnmapped.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                ToolTip="{loc:Loc AnimReTarget.ZeroUnmappedBones.ToolTip}" />

            <Label
                Grid.Row="6"
                Grid.Column="0"
                Content="{loc:Loc AnimReTarget.RootBoneWarBeast}"
                Style="{StaticResource AeForm.Label}" />
            <ComboBox
                Grid.Row="6"
                Grid.Column="1"
                Margin="0,2"
                DisplayMemberPath="BoneName"
                IsEditable="True"
                IsTextSearchEnabled="False"
                ItemsSource="{Binding ModelBoneList.Values}"
                SelectedItem="{Binding ModelBoneList.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Text="{Binding ModelBoneList.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

            <Button
                Grid.Row="7"
                Grid.Column="1"
                Margin="0,4,0,0"
                Content="{loc:Loc AnimReTarget.ConvertToWarBeast}"
                Click="{s:MethodBinding FreezePositionAndRotation}" />
        </Grid>
    </Expander>
</UserControl>
