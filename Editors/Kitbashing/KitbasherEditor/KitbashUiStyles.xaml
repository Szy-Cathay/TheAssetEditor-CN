<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:basedialogs="clr-namespace:Shared.Ui.BaseDialogs;assembly=Shared.Ui"
    xmlns:valueconverters="clr-namespace:KitbasherEditor.ValueConverters">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AeButton.Secondary}" />
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource AeInput.TextBox}" />
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource AeInput.ComboBox}" />
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource AeInput.CheckBox}" />
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource AeInput.RadioButton}" />
    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource AeTree.View}" />
    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource AeTree.Item}" />
    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource AeList.View}" />
    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource AeList.Item}" />
    <Style TargetType="{x:Type ListView}" BasedOn="{StaticResource AeList.View}" />
    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource AeTable.Grid}" />
    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource AeTable.Row}" />
    <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource AeTable.Cell}" />
    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource AeTable.Header}" />
    <Style TargetType="{x:Type Menu}" BasedOn="{StaticResource AeMenu.Bar}" />
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource AeMenu.Item}" />
    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource AeMenu.Context}" />
    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource AeToolTip}" />
    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource AeTab.Item}" />
    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AeScrollBar.Compact}" />

    <Style x:Key="Kitbash.VisibilityToggle" TargetType="{x:Type basedialogs:OptionalRadioButton}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="{StaticResource AeSize.CompactRowHeight}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AeFocus.Keyboard}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type basedialogs:OptionalRadioButton}">
                    <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="InteractionScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border
                            x:Name="Box"
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AeBrush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="2">
                            <Path
                                x:Name="CheckMark"
                                Width="8"
                                Height="6"
                                Data="M 1,3 L 3.2,5.2 L 7,1"
                                Opacity="0"
                                Stroke="{DynamicResource AeBrush.Accent}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.6" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource AeMotion.ButtonPressStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource AeMotion.ButtonReleaseStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource AeMotion.Hover}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource AeMotion.Pressed}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AeBrush.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Geometry x:Key="Kitbash.SceneIcon.Root.Primary">M1.5,4.5 H6 L7.5,6 H14.5 V13.5 H1.5 Z</Geometry>
    <Geometry x:Key="Kitbash.SceneIcon.Root.Accent">M3.5,7 H6.5 V10 H3.5 Z</Geometry>
    <Geometry x:Key="Kitbash.SceneIcon.Skeleton.Primary">M8,2 V5 M4,6 L8,5 L12,6 M8,5 V9 M5,13 L8,9 L11,13 M8,1 L9,2 L8,3 L7,2 Z M4,5 L5,6 L4,7 L3,6 Z M12,5 L13,6 L12,7 L11,6 Z M5,12 L6,13 L5,14 L4,13 Z M11,12 L12,13 L11,14 L10,13 Z</Geometry>
    <Geometry x:Key="Kitbash.SceneIcon.Skeleton.Accent">M8,3.5 L9.5,5 L8,6.5 L6.5,5 Z</Geometry>
    <Geometry x:Key="Kitbash.SceneIcon.Model.Primary">M8,1.5 L14,4.75 V11.25 L8,14.5 L2,11.25 V4.75 Z M2,4.75 L8,8 L14,4.75 M8,8 V14.5</Geometry>
    <Geometry x:Key="Kitbash.SceneIcon.Model.Accent">M6.5,6.5 H9.5 V9.5 H6.5 Z</Geometry>
    <Geometry x:Key="Kitbash.SceneIcon.Lod.Primary">M2,4 L8,1 L14,4 L8,7 Z M2,11 L8,14 L14,11</Geometry>
    <Geometry x:Key="Kitbash.SceneIcon.Lod.Accent">M2,7.5 L3.5,6.75 L8,9 L12.5,6.75 L14,7.5 L8,10.5 Z</Geometry>
    <Geometry x:Key="Kitbash.SceneIcon.Mesh.Primary">M8,1.5 L14,5 V11 L8,14.5 L2,11 V5 Z M2,11 L8,4 L14,11 M4.5,8 H11.5</Geometry>
    <Geometry x:Key="Kitbash.SceneIcon.Mesh.Accent">M8,1.5 L14,5 L11.5,6.5 Z</Geometry>
    <Geometry x:Key="Kitbash.SceneIcon.Reference.Primary">M1.5,3.5 H5 L6.25,4.75 H12.5 V7 M3.5,6.5 H7 L8.25,8 H14.5 V13.5 H3.5 Z</Geometry>
    <Geometry x:Key="Kitbash.SceneIcon.Reference.Accent">M5.5,9 H8.5 V12 H5.5 Z</Geometry>

    <Style x:Key="Kitbash.SceneIcon" TargetType="{x:Type ContentControl}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid Width="16" Height="16" UseLayoutRounding="True">
                        <Path
                            x:Name="PrimaryGlyph"
                            Data="{StaticResource Kitbash.SceneIcon.Root.Primary}"
                            Fill="Transparent"
                            Stroke="{DynamicResource AeBrush.TextSecondary}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.25" />
                        <Path
                            x:Name="AccentGlyph"
                            Data="{StaticResource Kitbash.SceneIcon.Root.Accent}"
                            Fill="{DynamicResource AeBrush.Accent}"
                            Stroke="{DynamicResource AeBrush.Accent}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Static valueconverters:SceneNodeIconKind.Skeleton}">
                            <Setter TargetName="PrimaryGlyph" Property="Data" Value="{StaticResource Kitbash.SceneIcon.Skeleton.Primary}" />
                            <Setter TargetName="AccentGlyph" Property="Data" Value="{StaticResource Kitbash.SceneIcon.Skeleton.Accent}" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Static valueconverters:SceneNodeIconKind.Model}">
                            <Setter TargetName="PrimaryGlyph" Property="Data" Value="{StaticResource Kitbash.SceneIcon.Model.Primary}" />
                            <Setter TargetName="AccentGlyph" Property="Data" Value="{StaticResource Kitbash.SceneIcon.Model.Accent}" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Static valueconverters:SceneNodeIconKind.Lod}">
                            <Setter TargetName="PrimaryGlyph" Property="Data" Value="{StaticResource Kitbash.SceneIcon.Lod.Primary}" />
                            <Setter TargetName="AccentGlyph" Property="Data" Value="{StaticResource Kitbash.SceneIcon.Lod.Accent}" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Static valueconverters:SceneNodeIconKind.Mesh}">
                            <Setter TargetName="PrimaryGlyph" Property="Data" Value="{StaticResource Kitbash.SceneIcon.Mesh.Primary}" />
                            <Setter TargetName="AccentGlyph" Property="Data" Value="{StaticResource Kitbash.SceneIcon.Mesh.Accent}" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Static valueconverters:SceneNodeIconKind.ReferenceGroup}">
                            <Setter TargetName="PrimaryGlyph" Property="Data" Value="{StaticResource Kitbash.SceneIcon.Reference.Primary}" />
                            <Setter TargetName="AccentGlyph" Property="Data" Value="{StaticResource Kitbash.SceneIcon.Reference.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Kitbash.SceneLockIcon" TargetType="{x:Type ContentControl}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid Width="14" Height="14" UseLayoutRounding="True">
                        <Path
                            Data="M4,6 V4.5 C4,2.6 5.2,1.5 7,1.5 C8.8,1.5 10,2.6 10,4.5 V6 M2.5,6 H11.5 V12.5 H2.5 Z"
                            Fill="Transparent"
                            Stroke="{DynamicResource AeBrush.TextSecondary}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.25" />
                        <Path
                            Data="M7,8 L8,9 L7,10.8 L6,9 Z"
                            Fill="{DynamicResource AeBrush.Warning}"
                            Stroke="{DynamicResource AeBrush.Warning}"
                            StrokeLineJoin="Round"
                            StrokeThickness="0.75" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="Kitbash.SceneTreeItem"
        BasedOn="{StaticResource AeTree.Item}"
        TargetType="{x:Type TreeViewItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Border
                            x:Name="Row"
                            MinHeight="{StaticResource AeSize.CompactRowHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AeRadius.Compact}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    x:Name="PART_ChevronHost"
                                    Width="16"
                                    Height="{StaticResource AeSize.CompactRowHeight}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <ToggleButton
                                        x:Name="Expander"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ClickMode="Press"
                                        Focusable="False"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Path
                                        x:Name="Chevron"
                                        Width="9"
                                        Height="9"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 2,1 L 7,4.5 L 2,8"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5"
                                        Stroke="{DynamicResource AeBrush.TextMuted}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="ChevronRotation" Angle="0" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <ContentPresenter
                                    x:Name="PART_Header"
                                    Grid.Column="1"
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ItemsPresenter
                            x:Name="ItemsHost"
                            Margin="16,0,0,0"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PART_ChevronHost" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ChevronRotation"
                                            Storyboard.TargetProperty="Angle"
                                            To="90"
                                            Duration="{StaticResource AeMotion.Hover}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ChevronRotation"
                                            Storyboard.TargetProperty="Angle"
                                            To="0"
                                            Duration="{StaticResource AeMotion.Hover}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AeBrush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextPrimary}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AeBrush.AccentSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextPrimary}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Kitbash.PropertyTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextPrimary}" />
    </Style>

    <Style TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="MinHeight" Value="{StaticResource AeSize.CompactRowHeight}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextSecondary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource {x:Type GroupBox}}">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeBrush.Border}" />
    </Style>

    <Style x:Key="Kitbash.ToolRadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="{StaticResource AeSize.ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource AeSize.ControlHeight}" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AeFocus.Keyboard}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border
                        x:Name="Chrome"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource AeRadius.Control}"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="InteractionScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource AeMotion.ButtonPressStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource AeMotion.ButtonReleaseStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AeBrush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AeBrush.AccentSoft}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AeBrush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Kitbash.Expander" TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextSecondary}" />
        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface1}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel Background="{TemplateBinding Background}">
                        <ToggleButton
                            x:Name="HeaderSite"
                            DockPanel.Dock="Top"
                            MinHeight="{StaticResource AeSize.CompactRowHeight}"
                            Padding="6,0"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AeBrush.Border}"
                            BorderThickness="0,0,0,1"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Focusable="False"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border
                                        x:Name="HeaderBackground"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path
                                                x:Name="Chevron"
                                                Width="5"
                                                Height="8"
                                                Margin="0,0,6,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M 1,1 L 4,4 L 1,7"
                                                RenderTransformOrigin="0.5,0.5"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.4">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ChevronRotation" Angle="0" />
                                                </Path.RenderTransform>
                                                <Path.Style>
                                                    <Style TargetType="{x:Type Path}">
                                                        <Setter Property="Stroke" Value="{DynamicResource AeBrush.TextMuted}" />
                                                        <Setter Property="Opacity" Value="0.72" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Stroke" Value="{DynamicResource AeBrush.AccentHover}" />
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource AeMotion.Hover}" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.72" Duration="{StaticResource AeMotion.Hover}" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <ContentPresenter
                                                Grid.Column="1"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="Center"
                                                RecognizesAccessKey="True" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="90" Duration="{StaticResource AeMotion.Hover}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="0" Duration="{StaticResource AeMotion.Hover}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter
                            x:Name="ExpandSite"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentSource="Content"
                            Focusable="False"
                            Visibility="Collapsed" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource Kitbash.Expander}" />

    <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource {x:Type Separator}}">
        <Setter Property="Background" Value="{DynamicResource AeBrush.Border}" />
    </Style>

    <Style TargetType="{x:Type ToolBarTray}" BasedOn="{StaticResource {x:Type ToolBarTray}}">
        <Setter Property="Background" Value="{DynamicResource AeBrush.Surface1}" />
    </Style>

    <Style TargetType="{x:Type ToolBar}" BasedOn="{StaticResource {x:Type ToolBar}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
</ResourceDictionary>
