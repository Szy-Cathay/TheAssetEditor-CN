<windowhandling:AssetEditorWindow  xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui" x:Class="Editors.KitbasherEditor.ChildEditors.MeshFitter.MeshFitterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Editors.KitbasherEditor.ChildEditors.MeshFitter" 
        xmlns:view="clr-namespace:CommonControls.Editors.BoneMapping.View;assembly=Editors.Shared.Core" 
        xmlns:view1="clr-namespace:Editors.Shared.Core.Editors.BoneMapping.View;assembly=Editors.Shared.Core"
        xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        mc:Ignorable="d"
        Title="{loc:Loc MeshFitter.Title}" Height="720" Width="1160" MinHeight="560" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AeBrush.Canvas}"
        Foreground="{DynamicResource AeBrush.TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}">
    <windowhandling:AssetEditorWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Editors.KitbasherEditor;component/KitbashUiStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/GridSplitterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </windowhandling:AssetEditorWindow.Resources>
    <Grid x:Name="ToolLayout" Margin="12" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" SharedSizeGroup="BoneMappingHintRow"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" SharedSizeGroup="BoneMappingActionsRow"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="440"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="340" MinWidth="324"/>
        </Grid.ColumnDefinitions>
        <view:BoneMappingView x:Name="MappingView" Grid.RowSpan="3" Margin="0,0,4,0"/>
        <GridSplitter Grid.Row="1" Grid.Column="1" Style="{StaticResource AeVerticalGridSplitterStyle}"/>
        <ScrollViewer x:Name="ParameterScroll" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <view1:BoneMappingMetaDataView/>
        </ScrollViewer>
        
        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0" LastChildFill="False" >
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{loc:Loc General.Ok}" Click="OkButtonClick" Style="{StaticResource AeButton.Primary}" IsEnabled="{Binding HasValidTransform}" ToolTip="{loc:Loc MeshFitter.ValidTransformHint}"/>
            <Button DockPanel.Dock="Right" Content="{loc:Loc General.Cancel}" Click="CancelButtonClick" Style="{StaticResource AeButton.Quiet}"/>
        </DockPanel>
    </Grid>
</windowhandling:AssetEditorWindow>
