<windowhandling:AssetEditorWindow  xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui" x:Class="Editors.KitbasherEditor.ChildEditors.MeshFitter.MeshFitterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Editors.KitbasherEditor.ChildEditors.MeshFitter" 
        xmlns:view="clr-namespace:CommonControls.Editors.BoneMapping.View;assembly=Editors.Shared.Core" 
        xmlns:view1="clr-namespace:Editors.Shared.Core.Editors.BoneMapping.View;assembly=Editors.Shared.Core"
        xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        mc:Ignorable="d"
        Title="{loc:Loc MeshFitter.Title}" Height="760" Width="1080" MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AeBrush.Canvas}"
        Foreground="{DynamicResource AeBrush.TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}">
    <windowhandling:AssetEditorWindow.Resources>
        <ResourceDictionary Source="/Editors.KitbasherEditor;component/KitbashUiStyles.xaml" />
    </windowhandling:AssetEditorWindow.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <view:BoneMappingView Grid.Row="0"/>
        <Expander Grid.Row="1" Header="{loc:Loc MeshFitter.TransformSettings}" IsExpanded="False" Margin="0,12,0,0">
            <view1:BoneMappingMetaDataView Margin="0,8,0,0"/>
        </Expander>
        
        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False" >
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{loc:Loc General.Ok}" Click="OkButtonClick" Style="{StaticResource AeButton.Primary}"/>
            <Button DockPanel.Dock="Right" Content="{loc:Loc General.Cancel}" Click="CancelButtonClick" Style="{StaticResource AeButton.Quiet}"/>
        </DockPanel>
    </Grid>
</windowhandling:AssetEditorWindow>
