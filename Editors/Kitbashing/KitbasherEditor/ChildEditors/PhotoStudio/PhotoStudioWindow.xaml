<windowhandling:AssetEditorWindow
    x:Class="Editors.KitbasherEditor.ChildEditors.PhotoStudio.PhotoStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui"
    xmlns:basedialogs="clr-namespace:Shared.Ui.BaseDialogs;assembly=Shared.Ui"
    xmlns:mathviews="clr-namespace:CommonControls.MathViews;assembly=Shared.Ui"
    xmlns:colourpicker="clr-namespace:Shared.Ui.BaseDialogs.ColourPickerButton;assembly=Shared.Ui"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    mc:Ignorable="d"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    Style="{StaticResource CustomWindowStyle}"
    Title="{loc:Loc KitbashTool.PhotoStudio.Title}"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AeBrush.Canvas}"
    Foreground="{DynamicResource AeBrush.TextPrimary}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}">
    <windowhandling:AssetEditorWindow.Resources>
        <ResourceDictionary Source="/Editors.KitbasherEditor;component/KitbashUiStyles.xaml" />
    </windowhandling:AssetEditorWindow.Resources>
    <DockPanel Width="450" Margin="12" LastChildFill="False">
        <DockPanel
            DockPanel.Dock="Top"
            Background="{DynamicResource AeBrush.Surface2}">
            <Label
                Content="{loc:Loc KitbashTool.PhotoStudio.CameraInformation}"
                FontSize="10" />
            <Separator />
        </DockPanel>

        <basedialogs:AeAttribute
            DockPanel.Dock="Top"
            LabelText="{loc:Loc KitbashTool.PhotoStudio.CameraPosition}"
            LabelWidth="200">
            <mathviews:Vector3View
                VerticalContentAlignment="Center"
                Vector3="{Binding CameraPosition, Mode=TwoWay}" />
        </basedialogs:AeAttribute>
        <basedialogs:AeAttribute
            DockPanel.Dock="Top"
            LabelText="{loc:Loc KitbashTool.PhotoStudio.CameraYaw}"
            LabelWidth="200">
            <TextBox
                Width="100"
                Margin="2"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Right"
                Text="{Binding CameraYaw, UpdateSourceTrigger=LostFocus}"
                VerticalContentAlignment="Center" />
        </basedialogs:AeAttribute>
        <basedialogs:AeAttribute
            DockPanel.Dock="Top"
            LabelText="{loc:Loc KitbashTool.PhotoStudio.CameraPitch}"
            LabelWidth="200">
            <TextBox
                Width="100"
                Margin="2"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Right"
                Text="{Binding CameraPitch, UpdateSourceTrigger=LostFocus}"
                VerticalContentAlignment="Center" />
        </basedialogs:AeAttribute>
        <basedialogs:AeAttribute
            DockPanel.Dock="Top"
            LabelText="{loc:Loc KitbashTool.PhotoStudio.CameraZoom}"
            LabelWidth="200">
            <TextBox
                Width="100"
                Margin="2"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Right"
                Text="{Binding CameraZoom, UpdateSourceTrigger=LostFocus}"
                VerticalContentAlignment="Center" />
        </basedialogs:AeAttribute>
        <basedialogs:AeAttribute
            DockPanel.Dock="Top"
            LabelText="{loc:Loc KitbashTool.PhotoStudio.CameraTarget}"
            LabelWidth="200">
            <mathviews:Vector3View
                Margin="2,0"
                VerticalContentAlignment="Center"
                Vector3="{Binding CameraLookAt, Mode=TwoWay}" />
        </basedialogs:AeAttribute>
        <Button
            Margin="3"
            Command="{Binding RefreshCameraValuesCommand}"
            Content="{loc:Loc KitbashTool.PhotoStudio.RefreshCameraValues}"
            Style="{StaticResource AeButton.Secondary}"
            DockPanel.Dock="Top" />

        <DockPanel
            DockPanel.Dock="Top"
            Background="{DynamicResource AeBrush.Surface2}">
            <Label
                Content="{loc:Loc KitbashTool.PhotoStudio.LightInformation}"
                FontSize="10" />
            <Separator />
        </DockPanel>
        <basedialogs:AeAttribute
            DockPanel.Dock="Top"
            LabelText="{loc:Loc KitbashTool.PhotoStudio.LightColour}"
            LabelWidth="200">
            <colourpicker:ColourPickerButtonView
                Width="25"
                Height="25"
                Margin="2"
                HorizontalAlignment="Left"
                DataContext="{Binding LightColour}" />
        </basedialogs:AeAttribute>
        <basedialogs:AeAttribute
            DockPanel.Dock="Top"
            LabelText="{loc:Loc KitbashTool.PhotoStudio.LightIntensity}"
            LabelWidth="200">
            <TextBox
                Width="100"
                Margin="2"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Right"
                Text="{Binding LightIntensity, UpdateSourceTrigger=LostFocus}"
                VerticalContentAlignment="Center" />
        </basedialogs:AeAttribute>
        <basedialogs:AeAttribute
            DockPanel.Dock="Top"
            LabelText="{loc:Loc KitbashTool.PhotoStudio.EnvLightRotation}"
            LabelWidth="200">
            <TextBox
                Width="100"
                Margin="2"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Right"
                Text="{Binding EnvLightRotationY, UpdateSourceTrigger=LostFocus}"
                VerticalContentAlignment="Center" />
        </basedialogs:AeAttribute>
        <basedialogs:AeAttribute
            DockPanel.Dock="Top"
            LabelText="{loc:Loc KitbashTool.PhotoStudio.DirectLightRotationX}"
            LabelWidth="200">
            <TextBox
                Width="100"
                Margin="2"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Right"
                Text="{Binding DirectLightRotationX, UpdateSourceTrigger=LostFocus}"
                VerticalContentAlignment="Center" />
        </basedialogs:AeAttribute>
        <basedialogs:AeAttribute
            DockPanel.Dock="Top"
            LabelText="{loc:Loc KitbashTool.PhotoStudio.DirectLightRotationY}"
            LabelWidth="200">
            <TextBox
                Width="100"
                Margin="2"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Right"
                Text="{Binding DirectLightRotationY, UpdateSourceTrigger=LostFocus}"
                VerticalContentAlignment="Center" />
        </basedialogs:AeAttribute>
        <basedialogs:AeAttribute
            DockPanel.Dock="Top"
            LabelText="{loc:Loc KitbashTool.PhotoStudio.DoubleImageResolution}"
            LabelWidth="200">
            <CheckBox
                Margin="2"
                HorizontalAlignment="Left"
                IsChecked="{Binding DoubleImageResolution}" />
        </basedialogs:AeAttribute>

        <Button
            Margin="3"
            Command="{Binding SaveSettingsCommand}"
            Content="{loc:Loc KitbashTool.PhotoStudio.ExportSettings}"
            DockPanel.Dock="Bottom" />
        <Button
            Margin="3"
            Command="{Binding ImportSettingsCommand}"
            Content="{loc:Loc KitbashTool.PhotoStudio.ImportSettings}"
            DockPanel.Dock="Bottom" />
        <Button
            Margin="3"
            Command="{Binding TakeScreenshotCommand}"
            Content="{loc:Loc KitbashTool.PhotoStudio.TakeScreenshot}"
            Style="{StaticResource AeButton.Primary}"
            DockPanel.Dock="Bottom" />
    </DockPanel>
</windowhandling:AssetEditorWindow>
