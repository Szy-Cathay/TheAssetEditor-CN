<windowhandling:AssetEditorWindow
    x:Class="Editors.KitbasherEditor.ChildEditors.PhotoStudio.PhotoStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui"
    xmlns:mathviews="clr-namespace:CommonControls.MathViews;assembly=Shared.Ui"
    xmlns:colourpicker="clr-namespace:Shared.Ui.BaseDialogs.ColourPickerButton;assembly=Shared.Ui"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    mc:Ignorable="d"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Title="{loc:Loc KitbashTool.PhotoStudio.Title}"
    Width="560"
    WindowStartupLocation="CenterOwner">
    <windowhandling:AssetEditorWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Editors.KitbasherEditor;component/KitbashUiStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="PhotoVector">
            <StackPanel>
                <UniformGrid Columns="3" Margin="0,0,0,4">
                    <TextBlock Text="{loc:Loc Ui.Axis.X}" Style="{StaticResource AeText.Caption}"/>
                    <TextBlock Text="{loc:Loc Ui.Axis.Y}" Style="{StaticResource AeText.Caption}"/>
                    <TextBlock Text="{loc:Loc Ui.Axis.Z}" Style="{StaticResource AeText.Caption}"/>
                </UniformGrid>
                <mathviews:Vector3View Vector3="{Binding}"/>
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </windowhandling:AssetEditorWindow.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="16">
            <TextBlock Text="{loc:Loc KitbashTool.PhotoStudio.CameraInformation}" Style="{StaticResource AeText.SectionTitle}" Margin="0,0,0,8"/>
            <DockPanel Margin="0,0,0,8"><Label DockPanel.Dock="Left" Width="140" Content="{loc:Loc KitbashTool.PhotoStudio.CameraPosition}" Style="{StaticResource AeForm.Label}"/><ContentControl Content="{Binding CameraPosition}" ContentTemplate="{StaticResource PhotoVector}"/></DockPanel>
            <DockPanel Margin="0,0,0,8"><Label DockPanel.Dock="Left" Width="140" Content="{loc:Loc KitbashTool.PhotoStudio.CameraYaw}" Style="{StaticResource AeForm.Label}"/><TextBox HorizontalContentAlignment="Right" Text="{Binding CameraYawDegrees, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"/></DockPanel>
            <DockPanel Margin="0,0,0,8"><Label DockPanel.Dock="Left" Width="140" Content="{loc:Loc KitbashTool.PhotoStudio.CameraPitch}" Style="{StaticResource AeForm.Label}"/><TextBox HorizontalContentAlignment="Right" Text="{Binding CameraPitchDegrees, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"/></DockPanel>
            <DockPanel Margin="0,0,0,8"><Label DockPanel.Dock="Left" Width="140" Content="{loc:Loc KitbashTool.PhotoStudio.CameraZoom}" Style="{StaticResource AeForm.Label}"/><TextBox HorizontalContentAlignment="Right" Text="{Binding CameraZoom, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"/></DockPanel>
            <DockPanel Margin="0,0,0,8"><Label DockPanel.Dock="Left" Width="140" Content="{loc:Loc KitbashTool.PhotoStudio.CameraTarget}" Style="{StaticResource AeForm.Label}"/><ContentControl Content="{Binding CameraLookAt}" ContentTemplate="{StaticResource PhotoVector}"/></DockPanel>
            <Button Command="{Binding RefreshCameraValuesCommand}" Content="{loc:Loc KitbashTool.PhotoStudio.RefreshCameraValues}" HorizontalAlignment="Right" Style="{StaticResource AeButton.Quiet}"/>
            <TextBlock Text="{loc:Loc KitbashTool.PhotoStudio.LightInformation}" Style="{StaticResource AeText.SectionTitle}" Margin="0,16,0,8"/>
            <DockPanel Margin="0,0,0,8"><Label DockPanel.Dock="Left" Width="140" Content="{loc:Loc KitbashTool.PhotoStudio.LightColour}" Style="{StaticResource AeForm.Label}"/><colourpicker:ColourPickerButtonView Width="26" Height="26" HorizontalAlignment="Left" DataContext="{Binding LightColour}"/></DockPanel>
            <DockPanel Margin="0,0,0,8"><Label DockPanel.Dock="Left" Width="140" Content="{loc:Loc KitbashTool.PhotoStudio.LightIntensity}" Style="{StaticResource AeForm.Label}"/><TextBox HorizontalContentAlignment="Right" Text="{Binding LightIntensity, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"/></DockPanel>
            <DockPanel Margin="0,0,0,8"><Label DockPanel.Dock="Left" Width="140" Content="{loc:Loc KitbashTool.PhotoStudio.EnvLightRotation}" Style="{StaticResource AeForm.Label}"/><TextBox HorizontalContentAlignment="Right" Text="{Binding EnvLightRotationY, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"/></DockPanel>
            <DockPanel Margin="0,0,0,8"><Label DockPanel.Dock="Left" Width="140" Content="{loc:Loc KitbashTool.PhotoStudio.DirectLightRotationX}" Style="{StaticResource AeForm.Label}"/><TextBox HorizontalContentAlignment="Right" Text="{Binding DirectLightRotationX, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"/></DockPanel>
            <DockPanel Margin="0,0,0,8"><Label DockPanel.Dock="Left" Width="140" Content="{loc:Loc KitbashTool.PhotoStudio.DirectLightRotationY}" Style="{StaticResource AeForm.Label}"/><TextBox HorizontalContentAlignment="Right" Text="{Binding DirectLightRotationY, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"/></DockPanel>
            <DockPanel Margin="0,0,0,8"><Label DockPanel.Dock="Left" Width="140" Content="{loc:Loc KitbashTool.PhotoStudio.DoubleImageResolution}" Style="{StaticResource AeForm.Label}"/><CheckBox IsChecked="{Binding DoubleImageResolution}"/></DockPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource AeWorkflow.DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding ImportSettingsCommand}" Content="{loc:Loc KitbashTool.PhotoStudio.ImportSettings}" Margin="0,0,8,0" Style="{StaticResource AeButton.Quiet}"/>
                <Button Command="{Binding SaveSettingsCommand}" Content="{loc:Loc KitbashTool.PhotoStudio.ExportSettings}" Margin="0,0,8,0" Style="{StaticResource AeButton.Secondary}"/>
                <Button Command="{Binding TakeScreenshotCommand}" Content="{loc:Loc KitbashTool.PhotoStudio.TakeScreenshot}" Style="{StaticResource AeButton.Primary}"/>
            </StackPanel>
        </Border>
    </Grid>
</windowhandling:AssetEditorWindow>
