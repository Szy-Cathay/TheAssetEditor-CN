<windowhandling:AssetEditorWindow 
    xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui"
    x:Class="Editors.KitbasherEditor.ChildEditors.VertexDebugger.VertexDebuggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
        xmlns:local="clr-namespace:Editors.KitbasherEditor.ChildEditors.VertexDebugger"
        xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="{loc:Loc VertexDebugger.Title}" Height="720" Width="1040"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AeBrush.Canvas}"
        Foreground="{DynamicResource AeBrush.TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}">
    <windowhandling:AssetEditorWindow.Resources>
        <ResourceDictionary Source="/Editors.KitbasherEditor;component/KitbashUiStyles.xaml" />
    </windowhandling:AssetEditorWindow.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Style="{StaticResource AeForm.Label}" Grid.Column="0" Content="{loc:Loc VertexDebugger.NormalDebugScale}"/>
            <TextBox Grid.Column="1" Text="{Binding DebugScale.TextValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                <b:Interaction.Behaviors>
                    <behaviors:TextBoxInputBehavior InputMode="DecimalInput"/>
                </b:Interaction.Behaviors>
            </TextBox>

            <Button Grid.Column="2" Content="{loc:Loc VertexDebugger.ShowStatistics}" Margin="8,0,0,0" Click="Button_Click" Style="{StaticResource AeButton.Secondary}"/>
        </Grid>

        <DataGrid x:Name="VertexTable" Grid.Row="1" Margin="0,12,0,0"
                 ItemsSource="{Binding VertexList, UpdateSourceTrigger=PropertyChanged}" 
                 SelectedItem="{Binding SelectedVertex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 IsReadOnly="True" 
                 AutoGenerateColumns="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 FrozenColumnCount="1"
                 AlternationCount="2"
                 Style="{StaticResource AeTable.Grid}">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource AeTable.Cell}" />
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.Id}" Binding="{Binding Id}" Width="64"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.Position}" Binding="{Binding Position}" Width="220"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.Uv0}" Binding="{Binding Uv0}" Width="180"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.Uv1}" Binding="{Binding Uv1}" Width="180"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.BoneIndices}" Binding="{Binding AnimIndecies}" Width="180"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.Weights}" Binding="{Binding AnimWeights}" Width="220"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.TotalWeight}" Binding="{Binding TotalWeight, StringFormat=0.####}" Width="88"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.Normal}" Binding="{Binding Normal}" Width="220"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.NormalLength}" Binding="{Binding NormalLength, StringFormat=0.####}" Width="88"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.Tangent}" Binding="{Binding Tangent}" Width="220"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.TangentLength}" Binding="{Binding TangentLength, StringFormat=0.####}" Width="88"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.BiNormal}" Binding="{Binding BiNormal}" Width="220"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.BiNormalLength}" Binding="{Binding BiNormalLength, StringFormat=0.####}" Width="100"/>
                <DataGridTextColumn Header="{loc:Loc VertexDebugger.Column.Colour}" Binding="{Binding Colour}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="1" Text="{loc:Loc VertexDebugger.EmptySelection}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource AeEmptyState.Description}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VertexList.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Grid.Row="2" Text="{Binding StatisticsText}" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource AeText.Body}"/>
    </Grid>
</windowhandling:AssetEditorWindow>
