<windowhandling:AssetEditorWindow 
    xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui"
    x:Class="Editors.KitbasherEditor.ChildEditors.VertexDebugger.VertexDebuggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
        xmlns:local="clr-namespace:Editors.KitbasherEditor.ChildEditors.VertexDebugger"
        xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="{loc:Loc VertexDebugger.Title}" Height="720" Width="1040"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AeBrush.Canvas}"
        Foreground="{DynamicResource AeBrush.TextPrimary}"
        FontFamily="{DynamicResource AeFont.Family}"
        FontWeight="{DynamicResource AeFont.Weight.Normal}">
    <windowhandling:AssetEditorWindow.Resources>
        <ResourceDictionary Source="/Editors.KitbasherEditor;component/KitbashUiStyles.xaml" />
    </windowhandling:AssetEditorWindow.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Label Content="{loc:Loc VertexDebugger.NormalDebugScale}"/>
            <TextBox Width="100" Text="{Binding DebugScale.TextValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                <b:Interaction.Behaviors>
                    <behaviors:TextBoxInputBehavior InputMode="DecimalInput"/>
                </b:Interaction.Behaviors>
            </TextBox>

            <Button Content="{loc:Loc VertexDebugger.ShowStatistics}" Margin="8,0,0,0" Click="Button_Click" Style="{StaticResource AeButton.Secondary}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" 
                 ItemsSource="{Binding VertexList, UpdateSourceTrigger=PropertyChanged}" 
                 SelectedItem="{Binding SelectedVertex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 IsReadOnly="True" 
                 AutoGenerateColumns="True"
                 AlternationCount="2"
                 Style="{StaticResource AeTable.Grid}">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource AeTable.Cell}" />
            </DataGrid.CellStyle>
        </DataGrid>
    </Grid>
</windowhandling:AssetEditorWindow>
