<windowhandling:AssetEditorWindow
    x:Class="Editors.KitbasherEditor.ChildEditors.MaterialSelection.MaterialSourceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
    Title="{loc:Loc Kitbash.AssignMaterial.SelectSource}"
    Width="800" Height="560" MinWidth="640" MinHeight="400"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="16,16,16,12">
            <TextBlock x:Name="TargetDescription" TextWrapping="Wrap" Style="{StaticResource AeText.Body}" Margin="0,0,0,8"/>
            <TextBox x:Name="SearchBox" TextChanged="SearchChanged" Style="{StaticResource AeInput.TextBox}"
                     behaviors:TextBoxExtensions.Watermark="{loc:Loc Kitbash.AssignMaterial.SearchHint}"
                     AutomationProperties.Name="{loc:Loc Kitbash.AssignMaterial.SearchHint}"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="16,0,16,12">
            <ListBox x:Name="SourceList" SelectionMode="Single" SelectionChanged="SelectionChanged"
                     Style="{StaticResource AeList.View}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4" ToolTip="{Binding TexturePath}">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource AeText.Body}"/>
                            <TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" Style="{StaticResource AeText.Caption}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TextureName}" TextTrimming="CharacterEllipsis" Style="{StaticResource AeText.Technical}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyMessage" Text="{loc:Loc Kitbash.AssignMaterial.NoMatches}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                       Style="{StaticResource AeEmptyState.Description}"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource AeWorkflow.DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc General.Cancel}" IsCancel="True" MinWidth="88" Margin="0,0,8,0" Style="{StaticResource AeButton.Secondary}"/>
                <Button x:Name="ConfirmButton" Content="{loc:Loc General.Ok}" IsDefault="True" IsEnabled="False"
                        MinWidth="88" Click="ConfirmClick" Style="{StaticResource AeButton.Primary}"/>
            </StackPanel>
        </Border>
    </Grid>
</windowhandling:AssetEditorWindow>
