<windowhandling:AssetEditorWindow  xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui"
                                   x:Class="Editors.KitbasherEditor.ViewModels.PinTool.PinToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Editors.KitbasherEditor.ViewModels.PinTool"
        xmlns:s="http://schemas.singulink.com/xaml" xmlns:pintool="clr-namespace:Editors.KitbasherEditor.ChildEditors.PinTool"
        xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        mc:Ignorable="d"
                                
        Title="{loc:Loc PinTool.Title}" Height="620" Width="520" MinHeight="460" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AeBrush.Canvas}"
        Foreground="{DynamicResource AeBrush.TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}">
    <windowhandling:AssetEditorWindow.Resources>
        <ResourceDictionary Source="/Editors.KitbasherEditor;component/KitbashUiStyles.xaml" />
    </windowhandling:AssetEditorWindow.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="{Binding SetupHint}" TextWrapping="Wrap" Style="{StaticResource AeText.Body}" Margin="0,0,0,12"/>
            <DockPanel>
                <Label Content="{loc:Loc PinTool.AnimationTransferMode}" Style="{StaticResource AeForm.Label}" Width="100"/>
                <ComboBox SelectedValue="{Binding SelectedRiggingMode, Mode=TwoWay}" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="{x:Static pintool:RiggingMode.Pin}" Content="{loc:Loc PinTool.Mode.Pin}"/>
                    <ComboBoxItem Tag="{x:Static pintool:RiggingMode.SkinWrap}" Content="{loc:Loc PinTool.Mode.SkinWrap}"/>
                </ComboBox>
            </DockPanel>
            <TextBlock Text="{loc:Loc PinTool.ApplyAnimationTo}" Style="{StaticResource AeText.SectionTitle}" Margin="0,16,0,8"/>
            <Grid Height="120">
                <ListView ItemsSource="{Binding AffectedMeshCollection}" DisplayMemberPath="Name" Style="{StaticResource AeList.View}"/>
                <TextBlock Text="{loc:Loc PinTool.NoTargets}" TextWrapping="Wrap" Margin="12" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource AeEmptyState.Description}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding AffectedMeshCollection.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{loc:Loc PinTool.AddSelectedMeshes}" Command="{Binding AddSelectionToAffectMeshCollectionCommand}" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc PinTool.RemoveAll}" Command="{Binding ClearAffectedMeshCollectionCommand}" Style="{StaticResource AeButton.Quiet}"/>
            </StackPanel>
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding SelectedRiggingMode}" Value="Pin"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{loc:Loc PinTool.TakeAnimationFromPinMode}" Style="{StaticResource AeText.SectionTitle}" Margin="0,16,0,8"/>
                <TextBox IsReadOnly="True" Text="{Binding PinMode.Description}" ToolTip="{Binding PinMode.Description}"/>
                <Button Content="{loc:Loc PinTool.SetFromSelectedVertex}" Command="{Binding PinMode.SetSelectionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding SelectedRiggingMode}" Value="SkinWrap"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{loc:Loc PinTool.TakeAnimationFromSkinWrapMode}" Style="{StaticResource AeText.SectionTitle}" Margin="0,16,0,8"/>
                <TextBox IsReadOnly="True" Text="{Binding SkinWrapMode.Description}" ToolTip="{Binding SkinWrapMode.Description}"/>
                <Button Content="{loc:Loc PinTool.SetFromSelection}" Command="{Binding SkinWrapMode.SetSelectionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
            <Expander Header="{loc:Loc PinTool.Instructions}" Margin="0,16,0,0">
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource AeText.Body}">
                    <Run Text="{loc:Loc PinTool.PinDesc}"/><LineBreak/><LineBreak/>
                    <Run Text="{loc:Loc PinTool.SkinWrapDesc}"/>
                </TextBlock>
            </Expander>
        </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource AeWorkflow.DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc General.Close}" Click="OnCloseClick" MinWidth="88" Margin="0,0,8,0" Style="{StaticResource AeButton.Secondary}"/>
                <Button Content="{loc:Loc General.Apply}" Click="OnApplyClick" IsEnabled="{Binding CanApply}" ToolTip="{Binding SetupHint}" MinWidth="88" Style="{StaticResource AeButton.Primary}"/>
            </StackPanel>
        </Border>
    </Grid>
</windowhandling:AssetEditorWindow>
