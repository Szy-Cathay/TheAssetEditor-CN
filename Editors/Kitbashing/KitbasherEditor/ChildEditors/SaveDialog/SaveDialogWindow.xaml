<Window x:Class="Editors.KitbasherEditor.ViewModels.SaveDialog.SaveDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Editors.KitbasherEditor.ViewModels.SaveDialog"
        xmlns:s="http://schemas.singulink.com/xaml"
        xmlns:common="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        mc:Ignorable="d"
        Title="{loc:Loc SaveDialog.Title}" Height="480" Width="900"
        MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AeBrush.Canvas}"
        Foreground="{DynamicResource AeBrush.TextPrimary}"
        FontFamily="{DynamicResource AeFont.Family}"
        FontWeight="{DynamicResource AeFont.Weight.Normal}">
    <Window.Resources>
        <ResourceDictionary Source="/Editors.KitbasherEditor;component/KitbashUiStyles.xaml" />
    </Window.Resources>

    <Grid Margin="12">
        <DockPanel LastChildFill="true">
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc SaveDialog.Path}"/>
                <DockPanel Grid.Row="0" Grid.Column="1" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding HandleBrowseLocationCommand}" Content="{loc:Loc General.Browse}" Style="{StaticResource AeButton.Secondary}"/>
                    <TextBox DockPanel.Dock="Left" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"></TextBox>
                </DockPanel>

                <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc SaveDialog.MeshFormat}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Right" Margin="0,1,0,1"
                      ItemsSource="{Binding MeshStrategies}" 
                      DisplayMemberPath="DisplayName" 
                      SelectedItem="{Binding SelectedMeshStrategy}"
                      ToolTip="{Binding Path=SelectedItem.Description, RelativeSource={RelativeSource Self}}"/>

                <Label Grid.Row="2" Grid.Column="0" Content="{loc:Loc SaveDialog.WsModelFormat}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Right" Margin="0,1,0,1"
                         ItemsSource="{Binding WsStrategies}" 
                          DisplayMemberPath="DisplayName" 
                          SelectedItem="{Binding SelectedWsModelStrategy}"
                          ToolTip="{Binding Path=SelectedItem.Description, RelativeSource={RelativeSource Self}}"/>

                <Label Grid.Row="3" Grid.Column="0" Content="{loc:Loc SaveDialog.LodStrategy}"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Width="200" HorizontalAlignment="Right" Margin="0,1,0,1" 
                        ItemsSource="{Binding LodStrategies}" 
                        DisplayMemberPath="DisplayName" 
                        SelectedItem="{Binding SelectedLodStrategy}"
                        ToolTip="{Binding Path=SelectedItem.Description, RelativeSource={RelativeSource Self}}"/>

                <Label Grid.Row="4" Grid.Column="0" Content="{loc:Loc SaveDialog.NumberOfLods}"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Width="200" HorizontalAlignment="Right" Margin="0,1,0,1" 
                   ItemsSource="{Binding PossibleLodNumbers}" 

                   SelectedItem="{Binding NumberOfLodsToGenerate}"
                   ToolTip="{loc:Loc SaveDialog.NumberOfLods.ToolTip}"/>
            </Grid>

            <Label DockPanel.Dock="top"  Margin="2,10,2,0" Content="{loc:Loc SaveDialog.LodInfo}"/>
            <DockPanel DockPanel.Dock="top" Margin="2,0,2,15">
                <DockPanel DockPanel.Dock="Top">
                    <DataGrid Style="{StaticResource AeTable.Grid}"
                      ItemsSource="{Binding LodNodes, UpdateSourceTrigger=PropertyChanged}" 
                      AutoGenerateColumns="False" CanUserAddRows="False" ToolTipService.ShowOnDisabled="True" DockPanel.Dock="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc SaveDialog.Index}" Binding="{Binding LodIndex, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"  ElementStyle="{StaticResource AeText.Body}"/>
                            <common:DataGridNumericColumn Header="{loc:Loc SaveDialog.Distance}" Binding="{Binding CameraDistance, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ElementStyle="{StaticResource AeText.Body}" EditingElementStyle="{StaticResource AeInput.TextBox}"/>
                            <common:DataGridNumericColumn Header="{loc:Loc SaveDialog.QltLevel}" Binding="{Binding QualityLvl, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ElementStyle="{StaticResource AeText.Body}" EditingElementStyle="{StaticResource AeInput.TextBox}"/>
                            <common:DataGridNumericColumn Header="{loc:Loc SaveDialog.ReductionFactor}" Binding="{Binding LodReductionFactor, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ElementStyle="{StaticResource AeText.Body}" EditingElementStyle="{StaticResource AeInput.TextBox}"/>
                            <DataGridCheckBoxColumn Header="{loc:Loc SaveDialog.MergeAlpha}" Binding="{Binding OptimizeLod_Alpha, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            <DataGridCheckBoxColumn Header="{loc:Loc SaveDialog.FastAnimVertex}" Binding="{Binding OptimizeLod_Vertex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                            <common:DataGridNumericColumn Header="{loc:Loc SaveDialog.NumPolygons}" Binding="{Binding PolygonCount.Value}" IsReadOnly="True" ElementStyle="{StaticResource AeText.Body}" />
                            <common:DataGridNumericColumn Header="{loc:Loc SaveDialog.NumMeshes}" Binding="{Binding MeshCount.Value}" IsReadOnly="True" ElementStyle="{StaticResource AeText.Body}" />
                            <common:DataGridNumericColumn Header="{loc:Loc SaveDialog.NumTextures}" Binding="{Binding TextureCount.Value}" IsReadOnly="True" ElementStyle="{StaticResource AeText.Body}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <Button Margin="0,0,6,0" Click="CancelButton_Click" Content="{loc:Loc General.Cancel}" Style="{StaticResource AeButton.Quiet}"/>
                <Button Click="SaveButton_Click" Content="{loc:Loc General.Save}" Style="{StaticResource AeButton.Primary}"/>
            </StackPanel>

            <CheckBox Margin="2" DockPanel.Dock="Bottom" FlowDirection="RightToLeft" IsChecked="{Binding OnlySaveVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Content="{loc:Loc SaveDialog.OnlySaveVisibleNodes}"/>
        </DockPanel>
    </Grid>
</Window>
