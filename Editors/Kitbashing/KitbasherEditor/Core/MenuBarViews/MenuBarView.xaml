<UserControl x:Class="KitbasherEditor.Views.MenuBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:viewmodel="clr-namespace:KitbasherEditor.ViewModels.MenuBarViews"
             xmlns:menusystem="clr-namespace:Shared.Ui.Common.MenuSystem;assembly=Shared.Ui"
             mc:Ignorable="d"
             Background="{DynamicResource AeBrush.Surface1}"
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>

        <Style x:Key="VerticalSeparatorStyle" 
            TargetType="{x:Type Separator}"
            BasedOn="{StaticResource {x:Type Separator}}">
            <Setter Property="Margin" Value="6,0,6,0"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <TransformGroup>
                        <TransformGroup.Children>
                            <TransformCollection>
                                <RotateTransform Angle="90"/>
                            </TransformCollection>
                        </TransformGroup.Children>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageStyle" TargetType="Image">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.05"></Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="defaultButtonTemplate">
            <Button ToolTip="{Binding Action.ToolTipAttribute.Value}" Margin="1"
                    AutomationProperties.Name="{Binding Action.ToolTipAttribute.Value}"
                    Focusable="False"
                    IsEnabled="{Binding Action.IsActionEnabled.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                    Command="{Binding Path=Action.Command}" 
                    ToolTipService.ShowOnDisabled="True"
                    Style="{StaticResource AeButton.Icon}"
                    Visibility="{Binding IsVisible.Value, UpdateSourceTrigger=PropertyChanged , Converter={StaticResource BoolToCollapsedConverter}}">
                <Image Style="{StaticResource ImageStyle}" Source="{Binding Image}"/>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="radioButtonTemplate">
            <RadioButton    ToolTip="{Binding  Action.ToolTipAttribute.Value}"  BorderThickness="0" Background="Transparent" Margin="1"
                            AutomationProperties.Name="{Binding Action.ToolTipAttribute.Value}"
                            Focusable="False"
                            IsChecked="{Binding IsChecked.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                            Command="{Binding Path=Action.Command}"
                            GroupName="{Binding GroupName}" 
                            Style="{DynamicResource Kitbash.ToolRadioButton}"
                            IsEnabled="{Binding Action.IsActionEnabled.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                            ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding IsVisible.Value, UpdateSourceTrigger=PropertyChanged , Converter={StaticResource BoolToCollapsedConverter}}">
                <Image Style="{StaticResource ImageStyle}" Source="{Binding Image}"/>
            </RadioButton>
        </DataTemplate>

        <DataTemplate x:Key="seperatorButtonTemplate">
            <Separator Style="{DynamicResource VerticalSeparatorStyle}"
                       Visibility="{Binding IsVisible.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToCollapsedConverter}}"/>
        </DataTemplate>

        <viewmodel:ButtonDataTemplateSelector x:Key="buttonStyleSelector"
            DefaultButtonTemplate="{StaticResource defaultButtonTemplate}" 
            RadioButtonTemplate="{StaticResource radioButtonTemplate}"
            SeperatorTemplate="{StaticResource seperatorButtonTemplate}"/>
    </UserControl.Resources>

    <DockPanel>
        <Menu ItemsSource="{Binding MenuItems}"  DockPanel.Dock="Top">
            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding NameAttribute.Value}" />
                    <Setter Property="Command" Value="{Binding Action.Command}" />
                    <Setter Property="IsEnabled" Value="{Binding Action.IsActionEnabled.Value, UpdateSourceTrigger=PropertyChanged}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type MenuItem}">
                                        <Separator />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <HierarchicalDataTemplate DataType="{x:Type menusystem:ToolbarItem}" ItemsSource="{Binding Children}" />
            </Menu.Resources>
        </Menu>

        <Grid DockPanel.Dock="Top">
            <ToolBarTray VerticalAlignment="Center">
                <ToolBar ItemsSource="{Binding Path=CustomButtons}" ItemTemplateSelector="{StaticResource buttonStyleSelector}" />
            </ToolBarTray>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="4,0">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Width="28" Height="28" Padding="4" Margin="0,0,4,0"
                                  x:Name="XRaySelectionButton"
                                  Style="{DynamicResource AeEditor.ToggleIcon}"
                                  IsChecked="{Binding SelectionSettings.IsXRay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{loc:Loc Kitbash.Selection.XRay}"
                                  AutomationProperties.Name="{loc:Loc Kitbash.Selection.XRay}"
                                  Focusable="False" Click="SelectionTool_Click">
                        <ToggleButton.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </ToggleButton.Resources>
                        <Viewbox Width="18" Height="18">
                            <Grid Width="20" Height="20">
                                <Rectangle Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Stroke="{DynamicResource AeBrush.TextSecondary}" StrokeThickness="1.5"/>
                                <Rectangle Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Stroke="{DynamicResource AeBrush.TextPrimary}" StrokeThickness="1.5"/>
                            </Grid>
                        </Viewbox>
                    </ToggleButton>
                    <RadioButton Width="28"
                                 Height="28"
                                 Padding="4"
                                 GroupName="ViewportShading"
                                 Style="{DynamicResource Kitbash.ToolRadioButton}"
                                 IsChecked="{Binding ViewportShading.IsWireframe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc Kitbash.ViewportShading.Wireframe}"
                                 AutomationProperties.Name="{loc:Loc Kitbash.ViewportShading.Wireframe}"
                                 Focusable="False">
                        <Viewbox Width="18" Height="18">
                            <Grid Width="20" Height="20">
                                <Ellipse Stroke="{DynamicResource AeBrush.TextSecondary}"
                                         StrokeThickness="1.5"/>
                                <Path Data="M 3,7 L 17,7 M 2,13 L 18,13 M 7,2 L 7,18 M 13,2 L 13,18"
                                      Stroke="{DynamicResource AeBrush.TextSecondary}"
                                      StrokeThickness="1"/>
                            </Grid>
                        </Viewbox>
                    </RadioButton>

                    <RadioButton Width="28"
                                 Height="28"
                                 Padding="4"
                                 GroupName="ViewportShading"
                                 Style="{DynamicResource Kitbash.ToolRadioButton}"
                                 IsChecked="{Binding ViewportShading.IsSolid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc Kitbash.ViewportShading.Solid}"
                                 AutomationProperties.Name="{loc:Loc Kitbash.ViewportShading.Solid}"
                                 Focusable="False">
                        <Viewbox Width="18" Height="18">
                            <Grid Width="20" Height="20">
                                <Ellipse Fill="{DynamicResource AeBrush.TextSecondary}"/>
                                <Ellipse Margin="4,3,8,9"
                                         Fill="{DynamicResource AeBrush.TextPrimary}"
                                         Opacity="0.7"/>
                            </Grid>
                        </Viewbox>
                    </RadioButton>

                    <RadioButton Width="28"
                                 Height="28"
                                 Padding="4"
                                 GroupName="ViewportShading"
                                 Style="{DynamicResource Kitbash.ToolRadioButton}"
                                 IsChecked="{Binding ViewportShading.IsMaterialPreview, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc Kitbash.ViewportShading.MaterialPreview}"
                                 AutomationProperties.Name="{loc:Loc Kitbash.ViewportShading.MaterialPreview}"
                                 Focusable="False">
                        <Viewbox Width="18" Height="18">
                            <Grid Width="20" Height="20">
                                <Ellipse Fill="{DynamicResource AeBrush.Accent}"/>
                                <Path Data="M 10,0 A 10,10 0 0 0 10,20 Z"
                                      Fill="{DynamicResource AeBrush.TextSecondary}"/>
                                <Ellipse Margin="4,3,8,9"
                                         Fill="{DynamicResource AeBrush.TextPrimary}"
                                         Opacity="0.8"/>
                            </Grid>
                        </Viewbox>
                    </RadioButton>
                    <ToggleButton x:Name="ShadingArrowBtn" Height="28"
                                  Style="{StaticResource AeButton.DropdownArrow}" Focusable="False"
                                  ToolTip="{loc:Loc Kitbash.ViewportShading.Settings}"
                                  AutomationProperties.Name="{loc:Loc Kitbash.ViewportShading.Settings}" />
                    <Popup x:Name="ShadingPopup" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=ShadingArrowBtn}"
                           IsOpen="{Binding IsChecked, ElementName=ShadingArrowBtn, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True"
                           Opened="ShadingPopup_Opened">
                        <Border Style="{DynamicResource AeSurface.Overlay}" Padding="12" Width="324"
                                PreviewKeyDown="ShadingPopup_PreviewKeyDown">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Kitbash.ViewportShading.Settings}"
                                           Style="{DynamicResource AeText.SectionTitle}" Margin="0,0,0,8" />
                                <StackPanel Visibility="{Binding ViewportShading.IsWireframe, Converter={StaticResource BoolToCollapsedConverter}}">
                                    <DockPanel Margin="0,0,0,8">
                                        <Label Content="{loc:Loc Kitbash.ViewportShading.WireOpacity}" Width="96" Style="{StaticResource AeForm.Label}" />
                                        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ViewportShading.WireframeOpacity, StringFormat={}{0:P0}}" />
                                        <Slider Minimum="0.1" Maximum="1" Value="{Binding ViewportShading.WireframeOpacity}" SmallChange="0.01" IsMoveToPointEnabled="True"
                                                AutomationProperties.Name="{loc:Loc Kitbash.ViewportShading.WireOpacity}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ViewportShading.IsSolid, Converter={StaticResource BoolToCollapsedConverter}}">
                                    <DockPanel Margin="0,0,0,8">
                                        <Label Content="{loc:Loc Kitbash.ViewportShading.Lighting}" Width="96" Style="{StaticResource AeForm.Label}" />
                                        <ComboBox SelectedIndex="{Binding ViewportShading.SolidLighting}" Style="{StaticResource AeInput.ComboBox}"
                                                  AutomationProperties.Name="{loc:Loc Kitbash.ViewportShading.Lighting}">
                                            <ComboBoxItem Content="{loc:Loc Kitbash.ViewportShading.Studio}" />
                                            <ComboBoxItem Content="{loc:Loc Kitbash.ViewportShading.Clay}" />
                                            <ComboBoxItem Content="{loc:Loc Kitbash.ViewportShading.Metal}" />
                                        </ComboBox>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Label Content="{loc:Loc Kitbash.ViewportShading.Cavity}" Width="96" Style="{StaticResource AeForm.Label}" />
                                        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ViewportShading.CavityStrength, StringFormat={}{0:P0}}" />
                                        <Slider Minimum="0" Maximum="1" Value="{Binding ViewportShading.CavityStrength}" SmallChange="0.01" IsMoveToPointEnabled="True"
                                                ToolTip="{loc:Loc Kitbash.ViewportShading.CavityHelp}" AutomationProperties.Name="{loc:Loc Kitbash.ViewportShading.Cavity}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Label Content="{loc:Loc Kitbash.ViewportShading.Shadow}" Width="96" Style="{StaticResource AeForm.Label}" />
                                        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ViewportShading.ShadowStrength, StringFormat={}{0:P0}}" />
                                        <Slider Minimum="0" Maximum="1" Value="{Binding ViewportShading.ShadowStrength}" SmallChange="0.01" IsMoveToPointEnabled="True"
                                                ToolTip="{loc:Loc Kitbash.ViewportShading.ShadowHelp}" AutomationProperties.Name="{loc:Loc Kitbash.ViewportShading.Shadow}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ViewportShading.IsMaterialPreview, Converter={StaticResource BoolToCollapsedConverter}}">
                                    <DockPanel Margin="0,0,0,8">
                                        <Label Content="{loc:Loc Kitbash.ViewportShading.Environment}" Width="96" Style="{StaticResource AeForm.Label}" />
                                        <ComboBox SelectedIndex="{Binding ViewportShading.Environment}" Style="{StaticResource AeInput.ComboBox}"
                                                  AutomationProperties.Name="{loc:Loc Kitbash.ViewportShading.Environment}">
                                            <ComboBoxItem Content="{loc:Loc Kitbash.ViewportShading.GameEnvironment}" />
                                            <ComboBoxItem Content="{loc:Loc Kitbash.ViewportShading.StudioEnvironment}" />
                                            <ComboBoxItem Content="{loc:Loc Kitbash.ViewportShading.OvercastEnvironment}" />
                                            <ComboBoxItem Content="{loc:Loc Kitbash.ViewportShading.SunsetEnvironment}" />
                                        </ComboBox>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Label Content="{loc:Loc KitbashTool.PhotoStudio.LightIntensity}" Width="96" Style="{StaticResource AeForm.Label}" />
                                        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ViewportShading.LightIntensity, StringFormat={}{0:0.00}}" />
                                        <Slider Minimum="0.1" Maximum="3" Value="{Binding ViewportShading.LightIntensity}" SmallChange="0.01" IsMoveToPointEnabled="True"
                                                AutomationProperties.Name="{loc:Loc KitbashTool.PhotoStudio.LightIntensity}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Label Content="{loc:Loc Kitbash.ViewportShading.Rotation}" Width="96" Style="{StaticResource AeForm.Label}" />
                                        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ViewportShading.EnvironmentRotation, StringFormat={}{0:0}°}" />
                                        <Slider Minimum="0" Maximum="360" Value="{Binding ViewportShading.EnvironmentRotation}" SmallChange="1" IsMoveToPointEnabled="True"
                                                AutomationProperties.Name="{loc:Loc Kitbash.ViewportShading.Rotation}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ViewportShading.HasSurface, Converter={StaticResource BoolToCollapsedConverter}}">
                                <DockPanel Margin="0,0,0,8" Visibility="{Binding CanUseMeshSelectionTools.Value, Converter={StaticResource BoolToCollapsedConverter}}">
                                    <Label Content="{loc:Loc Kitbash.ViewportShading.XRayOpacity}" Width="96" Style="{StaticResource AeForm.Label}" />
                                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding ViewportShading.XRayOpacity, StringFormat={}{0:P0}}" />
                                    <Slider Minimum="0.05" Maximum="1" Value="{Binding ViewportShading.XRayOpacity}" SmallChange="0.01" IsMoveToPointEnabled="True"
                                            IsEnabled="{Binding SelectionSettings.IsXRay}" ToolTip="{loc:Loc Kitbash.ViewportShading.XRayOpacityHelp}"
                                            AutomationProperties.Name="{loc:Loc Kitbash.ViewportShading.XRayOpacity}" />
                                </DockPanel>
                                </StackPanel>
                                <Button Content="{loc:Loc Kitbash.ViewportShading.Reset}" HorizontalAlignment="Right"
                                        Style="{StaticResource AeButton.Quiet}" Command="{Binding ViewportShading.ResetCommand}"
                                        ToolTip="{loc:Loc Kitbash.ViewportShading.ResetHelp}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <Separator Style="{DynamicResource VerticalSeparatorStyle}"/>

                <!-- Proportional editing toggle + dropdown -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding ProportionalEditing.IsVisible.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToCollapsedConverter}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,2,0">
                    <!-- Toggle button - Focusable=False prevents stealing keyboard focus from 3D viewport -->
                    <ToggleButton x:Name="PropToggleBtn"
                                  Width="28"
                                  Height="28"
                                  Margin="0,0,2,0"
                                  Padding="4"
                                  ToolTip="{loc:Loc BlenderHelp.ProportionalEditing}"
                                  AutomationProperties.Name="{loc:Loc BlenderHelp.ProportionalEditing}"
                                  IsChecked="{Binding ProportionalEditing.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Focusable="False">
                        <Image Width="20" Height="20" Source="{Binding ProportionalEditing.CurrentIcon, UpdateSourceTrigger=PropertyChanged}"/>
                    </ToggleButton>
                    <!-- Dropdown arrow - Focusable=False for same reason -->
                    <ToggleButton x:Name="PropArrowBtn"
                                  Height="28"
                                  Style="{StaticResource AeButton.DropdownArrow}"
                                  Focusable="False"
                                  AutomationProperties.Name="{loc:Loc Kitbasher.VertexFalloff.ToolTip}"
                                  ToolTip="{loc:Loc Kitbasher.VertexFalloff.ToolTip}"/>
                </StackPanel>
                <!-- Popup for falloff value -->
                <Popup x:Name="FalloffPopup" PlacementTarget="{Binding ElementName=PropArrowBtn}"
                       IsOpen="{Binding IsChecked, ElementName=PropArrowBtn, Mode=TwoWay}"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource AeBrush.Surface2}" BorderBrush="{DynamicResource AeBrush.BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource AeRadius.Surface}" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Kitbasher.VertexFalloff}" Margin="0,0,0,6" Foreground="{DynamicResource AeBrush.TextPrimary}"/>
                            <TextBox x:Name="FalloffTextBox"
                                     Text="{Binding ProportionalEditing.FalloffDistance, UpdateSourceTrigger=LostFocus, Mode=TwoWay, StringFormat='{}{0:0.###}'}"
                                     Width="100" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     PreviewKeyDown="FalloffTextBox_PreviewKeyDown">
                                <b:Interaction.Behaviors>
                                    <behaviors:TextBoxInputBehavior
                                        InputMode="DecimalInput"
                                        JustPositivDecimalInput="True"/>
                                </b:Interaction.Behaviors>
                            </TextBox>
                        </StackPanel>
                    </Border>
                </Popup>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
