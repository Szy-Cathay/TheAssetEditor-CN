<UserControl
    x:Class="KitbasherEditor.Views.EditorViews.AnimationPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filterdialog="clr-namespace:CommonControls.FilterDialog;assembly=Shared.Ui"
    xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="150"
    d:DesignWidth="900"
    Background="{DynamicResource AeBrush.Surface1}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontWeight="{DynamicResource AppFontWeight}"
    Foreground="{DynamicResource AeBrush.TextPrimary}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Shared.Ui;component/Common/Styles/EditorWorkspaceStyles.xaml" />
                <ResourceDictionary Source="/Editors.KitbasherEditor;component/KitbashUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="8,4,8,3"
            BorderBrush="{DynamicResource AeBrush.Border}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="{loc:Loc AnimationView.Animation}" />
                <ToggleButton
                    IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource AeInput.Switch}" />
            </StackPanel>
        </Border>

        <Grid
            Grid.Row="1"
            Margin="8,2,8,8"
            Visibility="{Binding AnimationControllerVisability.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="6"
                Background="{DynamicResource AeBrush.Surface2}"
                BorderBrush="{DynamicResource AeBrush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource AeRadius.Control}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc SharedAnimPlayer.Frame}" />
                        <TextBlock Text="{Binding CurrentFrame, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text=" / " />
                        <TextBlock Text="{Binding MaxFrames, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding FirstFrameCommand}"
                            Style="{StaticResource AeButton.Icon}">
                            <Canvas Width="16" Height="16">
                                <Path
                                    Data="M 3,3 L 3,13 M 13,3 L 5,8 L 13,13 Z"
                                    Fill="{DynamicResource AeBrush.TextPrimary}"
                                    Stroke="{DynamicResource AeBrush.TextPrimary}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Canvas>
                        </Button>
                        <Button
                            Command="{Binding PrivFrameCommand}"
                            Style="{StaticResource AeButton.Icon}">
                            <Canvas Width="16" Height="16">
                                <Path
                                    Data="M 13,3 L 6,8 L 13,13 Z M 8,3 L 1,8 L 8,13 Z"
                                    Fill="{DynamicResource AeBrush.TextPrimary}" />
                            </Canvas>
                        </Button>
                        <ToggleButton
                            Width="26"
                            Height="26"
                            Padding="5"
                            Command="{Binding PausePlayCommand}"
                            Style="{StaticResource AeEditor.ToggleIcon}">
                            <Canvas Width="16" Height="16">
                                <Path
                                    Data="M 4,2 L 14,8 L 4,14 Z"
                                    Fill="{DynamicResource AeBrush.TextPrimary}" />
                            </Canvas>
                        </ToggleButton>
                        <Button
                            Command="{Binding NextFrameCommand}"
                            Style="{StaticResource AeButton.Icon}">
                            <Canvas Width="16" Height="16">
                                <Path
                                    Data="M 3,3 L 10,8 L 3,13 Z M 8,3 L 15,8 L 8,13 Z"
                                    Fill="{DynamicResource AeBrush.TextPrimary}" />
                            </Canvas>
                        </Button>
                        <Button
                            Command="{Binding LastFrameCommand}"
                            Style="{StaticResource AeButton.Icon}">
                            <Canvas Width="16" Height="16">
                                <Path
                                    Data="M 3,3 L 11,8 L 3,13 Z M 13,3 L 13,13"
                                    Fill="{DynamicResource AeBrush.TextPrimary}"
                                    Stroke="{DynamicResource AeBrush.TextPrimary}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Canvas>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Background="{DynamicResource AeBrush.Surface2}"
                BorderBrush="{DynamicResource AeBrush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource AeRadius.Control}">
                <Expander>
                    <Expander.Header>
                        <TextBlock
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding HeaderText, UpdateSourceTrigger=PropertyChanged}" />
                            <Run Text="{Binding SelectedAnimation.FullPath, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                        </TextBlock>
                    </Expander.Header>
                    <Grid Margin="6,4,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc AnimationView.ExternalSkeleton}" />
                        <filterdialog:CollapsableFilterControl
                            Grid.Row="0"
                            Grid.Column="1"
                            IsEnabled="True"
                            IsManipulationEnabled="False"
                            LabelText="External Skeleton"
                            LabelTotalWidth="0"
                            OnSearch="{Binding FilterByFullPath, UpdateSourceTrigger=PropertyChanged}"
                            SearchItems="{Binding SkeletonList, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectedSkeleton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ShowLabel="False" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc AnimationView.TargetAnim}" />
                        <filterdialog:CollapsableFilterControl
                            Grid.Row="1"
                            Grid.Column="1"
                            MaxHeight="400"
                            IsManipulationEnabled="False"
                            LabelText="Target Anim"
                            LabelTotalWidth="0"
                            OnSearch="{Binding FilterByFullPath, UpdateSourceTrigger=PropertyChanged}"
                            SearchItems="{Binding AnimationsForCurrentSkeleton, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectedAnimation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ShowLabel="False" />
                    </Grid>
                </Expander>
            </Border>
        </Grid>
    </Grid>
</UserControl>
