<UserControl x:Class="KitbasherEditor.Views.SceneExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KitbasherEditor.Views" 
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:valueconverters="clr-namespace:KitbasherEditor.ValueConverters"
             xmlns:basedialogs="clr-namespace:Shared.Ui.BaseDialogs;assembly=Shared.Ui" 
             xmlns:valueconverters1="clr-namespace:Editors.KitbasherEditor.ValueConverters"
             mc:Ignorable="d" 
             Background="{DynamicResource AeBrush.Surface1}"
             Foreground="{DynamicResource AeBrush.TextPrimary}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Editors.KitbasherEditor;component/KitbashUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <valueconverters:SceneNodeToIconKindConverter x:Key="IconKindConverter"/>
            <valueconverters:SceneNodeToRadioButtonGroupingConverter x:Key="RadioButtonGroupConverter"/>
            <valueconverters1:SceneNodeToLockStateConverter x:Key="LockStateConverter"/>

        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <local:MultiSelectTreeView x:Name="TheTreeView"

            EventHub="{Binding Path=EventHub, UpdateSourceTrigger=PropertyChanged}"
            SceneManager="{Binding Path=SceneManager, UpdateSourceTrigger=PropertyChanged}"
            SelectionManager="{Binding Path=SelectionManager, UpdateSourceTrigger=PropertyChanged}">

            <TreeView.Style>
                <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource {x:Type TreeView}}"/>
            </TreeView.Style>
         
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children, UpdateSourceTrigger=PropertyChanged}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <basedialogs:OptionalRadioButton
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            GroupName="{Binding Path=., Converter={StaticResource RadioButtonGroupConverter}}"
                            IsChecked="{Binding Content.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource Kitbash.VisibilityToggle}" />
                        <ContentControl
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding Path=., Converter={StaticResource IconKindConverter}}"
                            Style="{StaticResource Kitbash.SceneIcon}" />
                        <StackPanel
                            x:Name="NodeStatus"
                            Grid.Column="2"
                            Margin="4,0,6,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding Path=Content.Name, UpdateSourceTrigger=PropertyChanged}"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReference, UpdateSourceTrigger=PropertyChanged}" Value="true">
                                                <Setter Property="Foreground" Value="{DynamicResource AeBrush.TextMuted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ContentControl
                                x:Name="LockState"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Kitbash.SceneLockIcon}">
                                <ContentControl.Visibility>
                                    <MultiBinding Converter="{StaticResource LockStateConverter}">
                                        <Binding Path="DataContext.Content" RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="DataContext.Content.IsSelectable" RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </ContentControl.Visibility>
                            </ContentControl>
                        </StackPanel>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        
            
            <local:MultiSelectTreeView.Resources>
                <ContextMenu x:Key="NodeContextMenu" ItemsSource="{Binding DataContext.ContextMenu.Items, UpdateSourceTrigger=PropertyChanged,  RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}" DisplayMemberPath="Name" Style="{StaticResource AeMenu.Context}">
                    <ContextMenu.Resources>
                        <ControlTemplate x:Key="MenuSeparatorTemplate">
                            <Separator Margin="4,2" />
                        </ControlTemplate>
                    </ContextMenu.Resources>

                    <ContextMenu.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource AeMenu.Item}">
                            <Setter Property="Command" Value="{Binding Command}"/>
                            <Setter Property="ItemsSource" Value="{Binding ContextMenu}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding }" Value="{x:Null}">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Height" Value="5" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template" Value="{StaticResource MenuSeparatorTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContextMenu.ItemContainerStyle>
                </ContextMenu>
            </local:MultiSelectTreeView.Resources>

            <local:MultiSelectTreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource Kitbash.SceneTreeItem}">
                    <Setter Property="IsExpanded" Value="{Binding Content.IsExpanded, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                    <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
                    <Setter Property="ContextMenu" Value="{StaticResource NodeContextMenu}"/>
                </Style>
            </local:MultiSelectTreeView.ItemContainerStyle>
            
        </local:MultiSelectTreeView>
    </DockPanel>
</UserControl>
