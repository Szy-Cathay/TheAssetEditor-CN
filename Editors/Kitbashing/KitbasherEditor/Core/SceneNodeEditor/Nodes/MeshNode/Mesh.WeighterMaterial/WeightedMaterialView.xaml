<UserControl x:Class="KitbasherEditor.Views.EditorViews.Rmv2.WeightedMaterialView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:inspector="clr-namespace:KitbasherEditor.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KitbasherEditor.Views.EditorViews.Rmv2" xmlns:s="http://schemas.singulink.com/xaml" xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <System:Double x:Key="labelWidth">120</System:Double>
    </UserControl.Resources>
    <StackPanel DockPanel.Dock="Top">
        <Border Margin="0">
            <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" ToolTip="{loc:Loc WeightedMaterial.ToolTip}" DockPanel.Dock="Left">
                    <TextBlock Text="{loc:Loc WeightedMaterial.Header}" Margin="0" TextWrapping="Wrap" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                </StackPanel>
                <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </DockPanel>
        </Border>
        <DockPanel LastChildFill="False">
            <Grid Style="{DynamicResource Kitbash.InspectorRow}" DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc WeightedMaterial.Filter}" />
                <TextBlock Text="{Binding Material.Filters.Value}" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
            </Grid>
            <Grid Style="{DynamicResource Kitbash.InspectorRow}" DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc WeightedMaterial.MatrixIndex}" />
                <TextBlock Text="{Binding Material.MatrixIndex.Value}" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
            </Grid>
            <Grid Style="{DynamicResource Kitbash.InspectorRow}" DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc WeightedMaterial.ParentMatrixIndex}" />
                <TextBlock Text="{Binding Material.ParentMatrixIndex.Value}" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
            </Grid>
            <Grid Style="{DynamicResource Kitbash.InspectorRow}" DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc WeightedMaterial.RmvVertexFormat}" />
                <TextBlock Text="{Binding Material.BinaryVertexFormat.Value}" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
            </Grid>
            <Grid Style="{DynamicResource Kitbash.InspectorRow}" DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc WeightedMaterial.RmvMaterialId}" />
                <TextBlock Text="{Binding Material.MaterialId.Value}" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
            </Grid>
            <Grid Style="{DynamicResource Kitbash.InspectorRow}" DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc WeightedMaterial.TransformInfo}" />
                <TextBlock Text="{Binding Material.TransformInfo.Value}" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
            </Grid>
            <StackPanel DockPanel.Dock="Top">
                <Border Margin="0">
                    <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="{loc:Loc WeightedMaterial.StringParams}" Margin="0,0,8,0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc WeightedMaterial.Count}" TextWrapping="Wrap" Margin="0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Material.StringParameters.Count, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </DockPanel>
                </Border>
                <ListView ItemsSource="{Binding Material.StringParameters}" MaxHeight="650" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AeList.Item}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top">
                <Border Margin="0">
                    <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="{loc:Loc WeightedMaterial.FloatParams}" Margin="0,0,8,0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc WeightedMaterial.Count}" TextWrapping="Wrap" Margin="0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Material.FloatParameters.Count, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </DockPanel>
                </Border>
                <ListView ItemsSource="{Binding Material.FloatParameters}" MaxHeight="650" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AeList.Item}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top">
                <Border Margin="0">
                    <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="{loc:Loc WeightedMaterial.IntParams}" Margin="0,0,8,0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc WeightedMaterial.Count}" TextWrapping="Wrap" Margin="0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Material.IntParameters.Count, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </DockPanel>
                </Border>
                <ListView ItemsSource="{Binding Material.IntParameters}" MaxHeight="650" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AeList.Item}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top">
                <Border Margin="0">
                    <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="{loc:Loc WeightedMaterial.TextureParams}" Margin="0,0,8,0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc WeightedMaterial.Count}" TextWrapping="Wrap" Margin="0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Material.TextureParameters.Count, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </DockPanel>
                </Border>
                <ListView ItemsSource="{Binding Material.TextureParameters}" MaxHeight="650" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AeList.Item}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top">
                <Border Margin="0">
                    <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="{loc:Loc WeightedMaterial.AttachmentParams}" Margin="0,0,8,0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc WeightedMaterial.Count}" TextWrapping="Wrap" Margin="0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Material.AttachmentPointParameters.Count, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </DockPanel>
                </Border>
                <ListView ItemsSource="{Binding Material.AttachmentPointParameters}" MaxHeight="650" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AeList.Item}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top">
                <Border Margin="0">
                    <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="{loc:Loc WeightedMaterial.Vec4Params}" Margin="0,0,8,0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc WeightedMaterial.Count}" TextWrapping="Wrap" Margin="0" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Material.VectorParameters.Count, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </DockPanel>
                </Border>
                <ListView ItemsSource="{Binding Material.VectorParameters}" MaxHeight="650" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AeList.Item}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</UserControl>
