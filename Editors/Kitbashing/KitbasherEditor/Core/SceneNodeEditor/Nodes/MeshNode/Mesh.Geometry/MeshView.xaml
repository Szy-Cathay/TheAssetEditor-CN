<UserControl x:Class="KitbasherEditor.Views.EditorViews.Rmv2.MeshView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KitbasherEditor.Views.EditorViews.Rmv2"
             xmlns:mathviews="clr-namespace:CommonControls.MathViews;assembly=Shared.Ui" 
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:converters="clr-namespace:KitbasherEditor.ValueConverters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <System:Double x:Key="labelWidth">120</System:Double>
        <converters:SceneNodeEditorDisplayConverter x:Key="SceneNodeDisplayConverter"/>
    </UserControl.Resources>

    <Expander DockPanel.Dock="Top" IsExpanded="True">
        <Expander.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc Mesh.Header}" FontWeight="Bold" Margin="3"/>
            </StackPanel>
        </Expander.Header>

        <DockPanel LastChildFill="False" >
            <DockPanel DockPanel.Dock="Top">
                <Label Style="{StaticResource AeForm.Label}" Width ="{StaticResource labelWidth}" DockPanel.Dock="Left" Content="{loc:Loc Mesh.Name}" />
                <TextBox Text="{Binding Mesh.ModelName, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
            </DockPanel>

            <DockPanel LastChildFill="True" DockPanel.Dock="Top">
                <Label Style="{StaticResource AeForm.Label}" Width ="{StaticResource labelWidth}" DockPanel.Dock="Left" Content="{loc:Loc Mesh.Size}"/>

                <Label Style="{StaticResource AeForm.Label}" DockPanel.Dock="Left" Content="{loc:Loc Mesh.VertexCount}"/>
                <TextBlock Text="{Binding Mesh.VertexCount, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,30,0"/>

                <Label Style="{StaticResource AeForm.Label}" DockPanel.Dock="Left" Content="{loc:Loc Mesh.IndexCount}"/>
                <TextBlock  Text="{Binding Mesh.IndexCount, UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Center" FontWeight="Bold"/>
            </DockPanel>

            <Expander DockPanel.Dock="Top" IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="{loc:Loc Mesh.Advanced}" FontWeight="Bold" Margin="3" ToolTip="{loc:Loc Mesh.Advanced.ToolTip}"/>
                </Expander.Header>

                <DockPanel LastChildFill="False">
                    <DockPanel DockPanel.Dock="Top">
                        <Label Style="{StaticResource AeForm.Label}" Width ="{StaticResource labelWidth}" DockPanel.Dock="Left" Content="{loc:Loc Mesh.VertexType}"/>
                        <ComboBox ItemsSource="{Binding Mesh.PossibleVertexTypes}" SelectedItem="{Binding Mesh.VertexType}" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource SceneNodeDisplayConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <DockPanel LastChildFill="True" DockPanel.Dock="Top">
                        <Label Style="{StaticResource AeForm.Label}" Width ="{StaticResource labelWidth}" DockPanel.Dock="Left" Content="{loc:Loc Mesh.ReduceLods}"/>
                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding Mesh.ReduceMeshOnLodGeneration, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </DockPanel>

                    <DockPanel LastChildFill="True" DockPanel.Dock="Top">
                        <Label Style="{StaticResource AeForm.Label}" Width ="{StaticResource labelWidth}" DockPanel.Dock="Left" Content="{loc:Loc Mesh.RenderBbox}" ToolTip="{loc:Loc Mesh.RenderBbox.ToolTip}"/>
                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding Mesh.DrawBoundingBox, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </DockPanel>

                    <DockPanel LastChildFill="True" DockPanel.Dock="Top">
                        <Label Style="{StaticResource AeForm.Label}" Width ="{StaticResource labelWidth}" DockPanel.Dock="Left" Content="{loc:Loc Mesh.ShowPivot}" ToolTip="{loc:Loc Mesh.ShowPivot.ToolTip}"/>
                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding Mesh.DrawPivotPoint, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </DockPanel>

                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="1" Width="{StaticResource labelWidth}" Style="{StaticResource AeForm.Label}"
                               Content="{loc:Loc Mesh.Pivot}" ToolTip="{loc:Loc Mesh.Pivot.ToolTip}"/>
                        <UniformGrid Grid.Column="1" Columns="3">
                            <TextBlock Text="{loc:Loc Ui.Axis.X}" Style="{StaticResource AeText.Caption}"/>
                            <TextBlock Text="{loc:Loc Ui.Axis.Y}" Style="{StaticResource AeText.Caption}"/>
                            <TextBlock Text="{loc:Loc Ui.Axis.Z}" Style="{StaticResource AeText.Caption}"/>
                        </UniformGrid>
                        <mathviews:Vector3View Grid.Row="1" Grid.Column="1"
                                               Vector3="{Binding Mesh.Pivot, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                               ToolTip="{loc:Loc Mesh.Pivot.ToolTip}"/>
                        <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Margin="0,4,0,0"
                                Content="{loc:Loc Mesh.CopyToAllMeshes}" Command="{Binding Mesh.CopyPivotToAllMeshesCommand}"
                                ToolTip="{loc:Loc Mesh.CopyToAllMeshes.ToolTip}"/>
                    </Grid>
                </DockPanel>
            </Expander>

        </DockPanel>
    </Expander>
</UserControl>
