<UserControl x:Class="KitbasherEditor.Views.EditorViews.Rmv2.MeshView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:inspector="clr-namespace:KitbasherEditor.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KitbasherEditor.Views.EditorViews.Rmv2" xmlns:s="http://schemas.singulink.com/xaml" xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui" xmlns:converters="clr-namespace:KitbasherEditor.ValueConverters" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <System:Double x:Key="labelWidth">120</System:Double>
        <converters:SceneNodeEditorDisplayConverter x:Key="SceneNodeDisplayConverter" />
    </UserControl.Resources>
    <StackPanel DockPanel.Dock="Top">
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc Mesh.VertexCount}" />
                    <TextBlock Text="{Binding Mesh.VertexCount, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontWeight="Normal" TextWrapping="Wrap" Grid.Column="1" />
                </Grid>
                <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc Mesh.IndexCount}" ToolTip="{loc:Loc Mesh.IndexCount.ToolTip}" />
                    <TextBlock Text="{Binding Mesh.IndexCount, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontWeight="Normal" TextWrapping="Wrap" Grid.Column="1" />
                </Grid>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top">
                <DockPanel LastChildFill="False">
                    <Grid DockPanel.Dock="Top" Style="{DynamicResource Kitbash.InspectorRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc Mesh.VertexType}" ToolTip="{loc:Loc Mesh.VertexType.ToolTip}" />
                        <ComboBox ItemsSource="{Binding Mesh.PossibleVertexTypes}" SelectedItem="{Binding Mesh.VertexType}" VerticalAlignment="Center" HorizontalAlignment="Stretch" ToolTip="{loc:Loc Mesh.VertexType.ToolTip}" Grid.Column="1">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource SceneNodeDisplayConverter}}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding Mesh.ReduceMeshOnLodGeneration, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Left" ToolTip="{loc:Loc Mesh.ReduceLods.ToolTip}" AutomationProperties.Name="{loc:Loc Mesh.ReduceLods}" Content="{loc:Loc Mesh.ReduceLods}" Style="{DynamicResource Kitbash.InspectorCheckBox}" DockPanel.Dock="Top" />
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding Mesh.DrawBoundingBox, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Left" ToolTip="{loc:Loc Mesh.RenderBbox.ToolTip}" AutomationProperties.Name="{loc:Loc Mesh.RenderBbox}" Content="{loc:Loc Mesh.RenderBbox}" Style="{DynamicResource Kitbash.InspectorCheckBox}" DockPanel.Dock="Top" />
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding Mesh.DrawPivotPoint, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Left" ToolTip="{loc:Loc Mesh.ShowPivot.ToolTip}" AutomationProperties.Name="{loc:Loc Mesh.ShowPivot}" Content="{loc:Loc Mesh.ShowPivot}" Style="{DynamicResource Kitbash.InspectorCheckBox}" DockPanel.Dock="Top" />
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Label Style="{DynamicResource Kitbash.InspectorStackedLabel}" Content="{loc:Loc Mesh.Pivot}" ToolTip="{loc:Loc Mesh.Pivot.ToolTip}" />
                        <ContentControl Content="{Binding Mesh.Pivot, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ToolTip="{loc:Loc Mesh.Pivot.ToolTip}" ContentTemplate="{DynamicResource Kitbash.InspectorVector3}" HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                    <Button Margin="0,0,0,4" Content="{loc:Loc Mesh.CopyToAllMeshes}" Command="{Binding Mesh.CopyPivotToAllMeshesCommand}" ToolTip="{loc:Loc Mesh.CopyToAllMeshes.ToolTip}" Style="{DynamicResource Kitbash.InspectorAction}" DockPanel.Dock="Top" />
                </DockPanel>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</UserControl>
