<UserControl x:Class="Editors.KitbasherEditor.ViewModels.SceneNodeEditor.Nodes.MeshNode.Mesh.WsMaterial.Emissive.EmissiveView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:inspector="clr-namespace:KitbasherEditor.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Editors.KitbasherEditor.ViewModels.SceneNodeEditor.Nodes.MeshNode.Mesh.WsMaterial.Emissive" xmlns:mathviews="clr-namespace:CommonControls.MathViews;assembly=Shared.Ui" xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:userinterface="clr-namespace:GameWorld.Core.Utility.UserInterface;assembly=GameWorld.Core" xmlns:colourpickerbutton="clr-namespace:Shared.Ui.BaseDialogs.ColourPickerButton;assembly=Shared.Ui" xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\ModelMaterialResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Margin="0">
            <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}" Margin="0,0,0,4">
                <TextBlock Text="{loc:Loc Emissive.Header}" Margin="0" ToolTip="{loc:Loc Emissive.ToolTip}" TextWrapping="Wrap" DockPanel.Dock="Left" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </DockPanel>
        </Border>
        <StackPanel>
            <StackPanel Margin="0,0,0,4">
                <CheckBox DataContext="{Binding EmissiveTexture}" IsChecked="{Binding ShouldRenderTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="{loc:Loc ShaderTexture.ApplyTexture}" AutomationProperties.Name="{loc:Loc Emissive.Texture}" Content="{loc:Loc Emissive.Texture}" Style="{DynamicResource Kitbash.InspectorCheckBox}" />
                <userinterface:ShaderTextureView DataContext="{Binding EmissiveTexture}" ShowRenderToggle="False" />
            </StackPanel>
            <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Content="{loc:Loc Emissive.Tint}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                <colourpickerbutton:ColourPickerButtonView Width="20" Height="20" HorizontalAlignment="Left" DataContext="{Binding EmissiveTint}" Grid.Column="1" />
            </Grid>
            <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Content="{loc:Loc Emissive.Strength}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                <TextBox HorizontalAlignment="Left" HorizontalContentAlignment="Left" Text="{Binding EmissiveStrength, UpdateSourceTrigger=LostFocus}" Grid.Column="1" Width="100" TextAlignment="Left" ><b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" IsDragEnabled="True"/></b:Interaction.Behaviors></TextBox>
            </Grid>
            <Grid Style="{DynamicResource Kitbash.InspectorRow}" ToolTip="{loc:Loc Emissive.FresnelStrength.ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Content="{loc:Loc Emissive.FresnelStrength}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                <TextBox HorizontalAlignment="Left" HorizontalContentAlignment="Left" Text="{Binding EmissiveFresnelStrength, UpdateSourceTrigger=LostFocus}" Grid.Column="1" Width="100" TextAlignment="Left" ><b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" IsDragEnabled="True"/></b:Interaction.Behaviors></TextBox>
            </Grid>
            <StackPanel ToolTip="{loc:Loc Emissive.Tiling.ToolTip}" Margin="0,0,0,4">
                <Label Content="{loc:Loc Emissive.Tiling}" Style="{DynamicResource Kitbash.InspectorStackedLabel}" />
                <ContentControl DataContext="{Binding EmissiveTiling}" Content="{Binding}" ContentTemplate="{DynamicResource Kitbash.InspectorVector2}" HorizontalContentAlignment="Stretch" />
            </StackPanel>
            <StackPanel>
                <Border Margin="0">
                    <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}">
                        <TextBlock Text="{loc:Loc Emissive.Gradient.Header}" Margin="0" ToolTip="{loc:Loc Emissive.Gradient.ToolTip}" TextWrapping="Wrap" DockPanel.Dock="Left" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                        <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </DockPanel>
                </Border>
                <StackPanel>
                    <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="{loc:Loc Emissive.Gradient1}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                        <DockPanel LastChildFill="False" Grid.Column="1">
                            <colourpickerbutton:ColourPickerButtonView DockPanel.Dock="Left" Width="20" Height="20" DataContext="{Binding Gradient0}" />
                            <Label DockPanel.Dock="Left" Margin="8,0,8,0" Content="{loc:Loc Emissive.Time}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                            <TextBox DockPanel.Dock="Left" Width="64" HorizontalContentAlignment="Left" Text="{Binding GradientTime0, UpdateSourceTrigger=LostFocus}" ToolTip="{loc:Loc Emissive.Gradient.ToolTip}" TextAlignment="Left" ><b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" IsDragEnabled="True" DragMinimum="0" DragMaximum="1"/></b:Interaction.Behaviors></TextBox>
                        </DockPanel>
                    </Grid>
                    <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="{loc:Loc Emissive.Gradient2}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                        <DockPanel LastChildFill="False" Grid.Column="1">
                            <colourpickerbutton:ColourPickerButtonView DockPanel.Dock="Left" Width="20" Height="20" DataContext="{Binding Gradient1}" />
                            <Label DockPanel.Dock="Left" Margin="8,0,8,0" Content="{loc:Loc Emissive.Time}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                            <TextBox DockPanel.Dock="Left" Width="64" HorizontalContentAlignment="Left" Text="{Binding GradientTime1, UpdateSourceTrigger=LostFocus}" ToolTip="{loc:Loc Emissive.Gradient.ToolTip}" TextAlignment="Left" ><b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" IsDragEnabled="True" DragMinimum="0" DragMaximum="1"/></b:Interaction.Behaviors></TextBox>
                        </DockPanel>
                    </Grid>
                    <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="{loc:Loc Emissive.Gradient3}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                        <DockPanel LastChildFill="False" Grid.Column="1">
                            <colourpickerbutton:ColourPickerButtonView DockPanel.Dock="Left" Width="20" Height="20" DataContext="{Binding Gradient2}" />
                            <Label DockPanel.Dock="Left" Margin="8,0,8,0" Content="{loc:Loc Emissive.Time}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                            <TextBox DockPanel.Dock="Left" Width="64" HorizontalContentAlignment="Left" Text="{Binding GradientTime2, UpdateSourceTrigger=LostFocus}" ToolTip="{loc:Loc Emissive.Gradient.ToolTip}" TextAlignment="Left" ><b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" IsDragEnabled="True" DragMinimum="0" DragMaximum="1"/></b:Interaction.Behaviors></TextBox>
                        </DockPanel>
                    </Grid>
                    <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="{loc:Loc Emissive.Gradient4}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                        <DockPanel LastChildFill="False" Grid.Column="1">
                            <colourpickerbutton:ColourPickerButtonView DockPanel.Dock="Left" Width="20" Height="20" DataContext="{Binding Gradient3}" />
                            <Label DockPanel.Dock="Left" Margin="8,0,8,0" Content="{loc:Loc Emissive.Time}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                            <TextBox DockPanel.Dock="Left" Width="64" HorizontalContentAlignment="Left" Text="{Binding GradientTime3, UpdateSourceTrigger=LostFocus}" ToolTip="{loc:Loc Emissive.Gradient.ToolTip}" TextAlignment="Left" ><b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" IsDragEnabled="True" DragMinimum="0" DragMaximum="1"/></b:Interaction.Behaviors></TextBox>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <Border Margin="0">
                    <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}">
                        <TextBlock Text="{loc:Loc Emissive.Motion.Header}" Margin="0" ToolTip="{loc:Loc Emissive.Motion.Hint}" TextWrapping="Wrap" DockPanel.Dock="Left" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                        <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </DockPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Emissive.Motion.Hint}" Style="{DynamicResource Kitbash.InspectorCaption}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <StackPanel Margin="0,0,0,4">
                        <CheckBox DataContext="{Binding EmissiveDistortionTexture}" IsChecked="{Binding ShouldRenderTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="{loc:Loc ShaderTexture.ApplyTexture}" AutomationProperties.Name="{loc:Loc Emissive.Distortion}" Content="{loc:Loc Emissive.Distortion}" Style="{DynamicResource Kitbash.InspectorCheckBox}" />
                        <userinterface:ShaderTextureView DataContext="{Binding EmissiveDistortionTexture}" ShowRenderToggle="False" />
                    </StackPanel>
                    <StackPanel ToolTip="{loc:Loc Emissive.Direction.ToolTip}" Margin="0,0,0,4">
                        <Label Content="{loc:Loc Emissive.Direction}" Style="{DynamicResource Kitbash.InspectorStackedLabel}" />
                        <ContentControl DataContext="{Binding EmissiveDirection}" Content="{Binding}" ContentTemplate="{DynamicResource Kitbash.InspectorVector2}" HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                    <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="{loc:Loc Emissive.DistortStrength}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                        <TextBox HorizontalAlignment="Left" HorizontalContentAlignment="Left" Text="{Binding EmissiveDistortStrength, UpdateSourceTrigger=LostFocus}" Grid.Column="1" Width="100" TextAlignment="Left" ><b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" IsDragEnabled="True"/></b:Interaction.Behaviors></TextBox>
                    </Grid>
                    <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="{loc:Loc Emissive.Speed}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                        <TextBox HorizontalAlignment="Left" HorizontalContentAlignment="Left" Text="{Binding EmissiveSpeed, UpdateSourceTrigger=LostFocus}" Grid.Column="1" Width="100" TextAlignment="Left" ><b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" IsDragEnabled="True"/></b:Interaction.Behaviors></TextBox>
                    </Grid>
                    <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="{loc:Loc Emissive.PulseSpeed}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                        <TextBox HorizontalAlignment="Left" HorizontalContentAlignment="Left" Text="{Binding EmissivePulseSpeed, UpdateSourceTrigger=LostFocus}" Grid.Column="1" Width="100" TextAlignment="Left" ><b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" IsDragEnabled="True"/></b:Interaction.Behaviors></TextBox>
                    </Grid>
                    <Grid Style="{DynamicResource Kitbash.InspectorRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="{loc:Loc Emissive.PulseStrength}" Style="{DynamicResource Kitbash.InspectorLabel}" />
                        <TextBox HorizontalAlignment="Left" HorizontalContentAlignment="Left" Text="{Binding EmissivePulseStrength, UpdateSourceTrigger=LostFocus}" Grid.Column="1" Width="100" TextAlignment="Left" ><b:Interaction.Behaviors><behaviors:TextBoxInputBehavior InputMode="DecimalInput" IsDragEnabled="True"/></b:Interaction.Behaviors></TextBox>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
