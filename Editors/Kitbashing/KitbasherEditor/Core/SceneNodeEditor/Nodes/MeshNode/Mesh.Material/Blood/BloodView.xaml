<UserControl x:Class="Editors.KitbasherEditor.ViewModels.SceneNodeEditor.Nodes.MeshNode.Mesh.WsMaterial.Blood.BloodView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:inspector="clr-namespace:KitbasherEditor.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Editors.KitbasherEditor.ViewModels.SceneNodeEditor.Nodes.MeshNode.Mesh.WsMaterial.Blood" xmlns:userinterface="clr-namespace:GameWorld.Core.Utility.UserInterface;assembly=GameWorld.Core" xmlns:basedialogs="clr-namespace:Shared.Ui.BaseDialogs;assembly=Shared.Ui" xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\ModelMaterialResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ContentControl DockPanel.Dock="Top">
        <StackPanel DockPanel.Dock="Top">
            <Border Margin="0">
                <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}" Margin="0,0,0,4">
                    <DockPanel DockPanel.Dock="Left">
                        <TextBlock Text="{loc:Loc Blood.Header}" Margin="0" TextWrapping="Wrap" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </DockPanel>
            </Border>
            <DockPanel LastChildFill="False">
                <CheckBox IsChecked="{Binding UseBlood, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{loc:Loc Blood.ReceivesBlood.ToolTip}" AutomationProperties.Name="{loc:Loc Blood.ReceivesBlood}" Content="{loc:Loc Blood.ReceivesBlood}" Style="{DynamicResource Kitbash.InspectorCheckBox}" DockPanel.Dock="Top" />
                <StackPanel DockPanel.Dock="Top" ToolTip="{loc:Loc Blood.BloodUvScale.ToolTip}" Margin="0,0,0,4">
                    <Label Content="{loc:Loc Blood.BloodUvScale}" Style="{DynamicResource Kitbash.InspectorStackedLabel}" />
                    <ContentControl DataContext="{Binding BloodUvScale}" Content="{Binding}" ContentTemplate="{DynamicResource Kitbash.InspectorVector2}" HorizontalContentAlignment="Stretch" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <CheckBox DataContext="{Binding BloodMap}" IsChecked="{Binding ShouldRenderTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="{loc:Loc ShaderTexture.ApplyTexture}" AutomationProperties.Name="{loc:Loc Blood.TextureBloodMap}" Content="{loc:Loc Blood.TextureBloodMap}" Style="{DynamicResource Kitbash.InspectorCheckBox}" />
                    <userinterface:ShaderTextureView DataContext="{Binding BloodMap}" ShowRenderToggle="False" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </ContentControl>
</UserControl>
