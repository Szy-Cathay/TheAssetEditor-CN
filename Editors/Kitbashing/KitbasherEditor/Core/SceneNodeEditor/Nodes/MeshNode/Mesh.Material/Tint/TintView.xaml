<UserControl x:Class="Editors.KitbasherEditor.ViewModels.SceneNodeEditor.Nodes.MeshNode.Mesh.WsMaterial.Tint.TintView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:inspector="clr-namespace:KitbasherEditor.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Editors.KitbasherEditor.ViewModels.SceneNodeEditor.Nodes.MeshNode.Mesh.WsMaterial.Tint" xmlns:colourpickerbutton="clr-namespace:Shared.Ui.BaseDialogs.ColourPickerButton;assembly=Shared.Ui" xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\ModelMaterialResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ContentControl DockPanel.Dock="Top">
        <StackPanel DockPanel.Dock="Top">
            <Border Margin="0">
                <DockPanel Style="{DynamicResource Kitbash.InspectorSectionHeader}" Margin="0,0,0,4">
                    <DockPanel DockPanel.Dock="Left" ToolTip="{loc:Loc Tint.ToolTip}">
                        <TextBlock Text="{loc:Loc Tint.Header}" Margin="0" TextWrapping="Wrap" Style="{DynamicResource Kitbash.InspectorHeading}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Separator Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </DockPanel>
            </Border>
            <DockPanel LastChildFill="False" Margin="0">
                <CheckBox IsChecked="{Binding ApplyFactionColours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Tint.PreviewCapability}" Content="{loc:Loc Tint.PreviewCapability}" Style="{DynamicResource Kitbash.InspectorCheckBox}" DockPanel.Dock="Top" />
                <Grid Style="{DynamicResource Kitbash.InspectorRow}" DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc Tint.FactionColour0}" />
                    <colourpickerbutton:ColourPickerButtonView DataContext="{Binding FactionColour0}" HorizontalAlignment="Left" Width="20" Height="20" Background="Transparent" Grid.Column="1" />
                </Grid>
                <Grid Style="{DynamicResource Kitbash.InspectorRow}" DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc Tint.FactionColour1}" />
                    <colourpickerbutton:ColourPickerButtonView DataContext="{Binding FactionColour1}" HorizontalAlignment="Left" Width="20" Height="20" Background="Transparent" Grid.Column="1" />
                </Grid>
                <Grid Style="{DynamicResource Kitbash.InspectorRow}" DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Style="{DynamicResource Kitbash.InspectorLabel}" Content="{loc:Loc Tint.FactionColour2}" />
                    <colourpickerbutton:ColourPickerButtonView DataContext="{Binding FactionColour2}" HorizontalAlignment="Left" Width="20" Height="20" Background="Transparent" Grid.Column="1" />
                </Grid>
                <Button DockPanel.Dock="Top" Margin="0,0,0,4" Command="{Binding SaveFactionColourSettingsCommand}" Content="{loc:Loc FactionTint.SaveGlobal}" Style="{DynamicResource Kitbash.InspectorAction}" />
            </DockPanel>
        </StackPanel>
    </ContentControl>
</UserControl>
