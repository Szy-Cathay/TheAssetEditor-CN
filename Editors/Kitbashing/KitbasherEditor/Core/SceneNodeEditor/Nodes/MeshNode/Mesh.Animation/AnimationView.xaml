<UserControl x:Class="KitbasherEditor.Views.EditorViews.Rmv2.AnimationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <System:Double x:Key="labelWidth">120</System:Double>
    </UserControl.Resources>

    <Expander IsExpanded="False">
        <Expander.Header>
            <TextBlock Text="{loc:Loc MeshAnim.Header}" FontWeight="Bold" Margin="3"/>
        </Expander.Header>
        <StackPanel>
            <DockPanel>
                <Label Style="{StaticResource AeForm.Label}" Width="{StaticResource labelWidth}"
                       DockPanel.Dock="Left" Content="{loc:Loc MeshAnim.SkeletonName}"/>
                <TextBlock Text="{Binding Animation.SkeletonName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Animation.SkeletonName}"/>
            </DockPanel>
            <DockPanel>
                <Label Style="{StaticResource AeForm.Label}" Width="{StaticResource labelWidth}"
                       DockPanel.Dock="Left" Content="{loc:Loc MeshAnim.AttachTo}"
                       ToolTip="{loc:Loc MeshAnim.AttachTo.ToolTip}"/>
                <ComboBox IsEditable="True" IsTextSearchEnabled="False"
                          DisplayMemberPath="Name.Value"
                          Text="{Binding Animation.AttachableBones.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          ItemsSource="{Binding Animation.AttachableBones.Values}"
                          SelectedItem="{Binding Animation.AttachableBones.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          ToolTip="{loc:Loc MeshAnim.AttachTo.ToolTip}"
                          AutomationProperties.Name="{loc:Loc MeshAnim.AttachTo}"/>
            </DockPanel>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Width="{StaticResource labelWidth}" Style="{StaticResource AeForm.Label}" Content="{loc:Loc MeshAnim.AnimationMatrix}"
                       ToolTip="{loc:Loc MeshAnim.AnimationMatrix.ToolTip}"/>
                <TextBox Grid.Column="1" Text="{Binding Animation.AnimationMatrixOverride, UpdateSourceTrigger=LostFocus}"
                         MaxLength="8" Width="100" HorizontalAlignment="Left" HorizontalContentAlignment="Right"
                         ToolTip="{loc:Loc MeshAnim.AnimationMatrix.ToolTip}"
                         AutomationProperties.Name="{loc:Loc MeshAnim.AnimationMatrix}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Loc MeshAnim.AnimationMatrix.DefaultHint}"
                           Style="{StaticResource AeText.Caption}" TextWrapping="Wrap" Margin="0,2,0,2"/>
            </Grid>
            <Expander Margin="0,4,0,0" Background="Transparent" BorderThickness="0">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc MeshAnim.Bones}" Margin="3"/>
                        <TextBlock Text="{Binding Animation.AnimatedBones.Count, StringFormat={loc:Loc Kitbash.Sidebar.ItemCountFormat}}"
                                   Style="{StaticResource AeText.Caption}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Expander.Header>
                <DataGrid ItemsSource="{Binding Animation.AnimatedBones}" Style="{StaticResource AeTable.Grid}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          SelectionMode="Single" HeadersVisibility="Column" MaxHeight="240"
                          AutomationProperties.Name="{loc:Loc MeshAnim.Bones}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc MeshAnim.BoneIndex}" Binding="{Binding BoneIndex.Value}" Width="64"/>
                        <DataGridTextColumn Header="{loc:Loc MainNode.Name}" Binding="{Binding Name.Value}" Width="*" MinWidth="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </StackPanel>
    </Expander>
</UserControl>
